# Ágora · .gitignore
# Base taken from the upstream `.gitignore.example` shipped by Drupal CMS (1.x),
# plus local environment artifacts. The repo IS the recipe: we do not version the working site.

# --- Starter kit ---
# Drupal places a .htaccess next to the exported config; irrelevant in a recipe.
/config/.htaccess

# --- Local environment / DDEV ---
/web/
/vendor/
/.ddev/
.env
.env.*
!.env.example

# --- JS tooling (pnpm exclusively · CLAUDE.md rule 5) ---
node_modules/
/package-lock.json
/yarn.lock

# --- Test artifacts ---
/test-results/
/playwright-report/
/.phpunit.cache/
.phpunit.result.cache

# --- OS / editor junk ---
.DS_Store
Thumbs.db
*.swp
.idea/
