#!/usr/bin/env bash
#
# no-ci-allow-dev - Agora - unit 001, task T-209.
#
# T-209 belongs to wave 2 and stays numbered there (signed tasks are
# append-only); it is merely EXECUTED in wave 3, because its file is disjoint
# from everything else in that wave.
#
# What it enforces, in one sentence: the `CI_ALLOW_DEV` escape hatch is never
# DEFINED in a versioned file, because defining it WEAKENS a gate.
#
# THE SECOND HALF THIS SCRIPT CARRIED BETWEEN 2026-09-13 AND 2026-09-19 HAS
# MOVED TO ITS PROPER HOME (T-1903). The "a gate variable must always BE
# defined, by us, with the value our gate needs" assertion now lives in
# tests/bin/no-blind-phpunit, whose subject the pinned variable exactly is.
# It was parked here because D-028 was read as forbidding a shared file to be
# edited from one repository alone; D-028 does not say that, and the move cost
# what D-028 actually prices - one manifest row in agora_theme. This file's
# name fits its contents again, and nothing was weakened on the way: the two
# denominators moved with the section and are asserted by the wave-3 gate
# runner in the group that runs no-blind-phpunit.
#
# Why the escape hatch matters (I-015): tests/src/Kernel/RequirementsTest.php
# reads that variable, and when it is set in CI the dependencies it names SKIP
# the pinned/dev-version assertion. It is a deliberate weakening of the very
# gate that keeps this template publishable. In Agora it is never set.
#
# Why this looks for a DEFINITION and not for the name (I-018): the test that
# polices a string legitimately contains that string.
# tests/src/Kernel/RequirementsTest.php reads it with getenv('CI_ALLOW_DEV') BY
# DESIGN - it is the kit's own escape hatch, and removing the read would be
# weakening the kit's test. (This said T-406 "forbids modifying that file" until
# 2026-09-24; T-406's criterion is "0 lines deleted", which forbids exactly that
# and nothing wider.) An invariant that matched the bare name would be a
# permanent, unfixable red - the kind of red that everyone learns to ignore
# (I-020). The pattern therefore requires the variable name to
# be followed by optional whitespace and then a separator character, colon or
# equals, which is what a YAML mapping entry or a shell assignment looks like
# and what getenv() never looks like.
#
# Contract (shared by every invariant in tests/bin/):
#   scope:    the exact set of files inspected
#   scanned:  N files, and N must be > 0 or this script fails
#   findings: M, each printed as  path:line  reason
#   exit 0 if and only if M == 0
#
# ======================================================================
# HOUSE RULES for tests/bin/ - THE CANONICAL COPY (T-321(c)).
# Every other script here points at this block instead of restating it, so
# the next invariant inherits the rules rather than rediscovering them. The
# same five defects arrived five times in five different files (the `-Fin`
# no-op, fallback zeros, expect-zero gate checks, the deny-term counter,
# blank-vs-zero); these rules delete the failure mode instead of guarding
# each new instance of it.
#
#   1. `wc -l`, NEVER `grep -c`, for any value that feeds a comparison.
#      `grep -c` prints NOTHING on rc >= 2, and a blank left-hand side makes
#      `[ "" -eq 0 ]` exit 2 with "integer expression expected" - the branch
#      is simply NOT TAKEN and execution walks straight past the guard
#      (I-031). `wc -l` cannot print a non-number, so the guard cannot be
#      skipped. `grep -c` is allowed only where the value is DISPLAYED and
#      never compared, and each such site says so on the line.
#
#   2. Default every numeric guard input whose zero means FAIL:
#      `[ "${X:-0}" -eq 0 ] && FATAL`. Read I-031 before copying this: the
#      same three characters are safe where 0 means FAIL and DANGEROUS where
#      0 means PASS. A guard written `[ "$FINDINGS" -eq 0 ] && exit 0` must
#      NEVER be defaulted - there a blank would be converted into a green.
#      Ask what `0` DOES at that line, never what it looks like.
#
#   3. A `grep` exit status >= 2 is an ERROR, never "no match" (I-027).
#      Read the status, and turn it into a FATAL or into a sentinel string
#      that cannot collide with a legitimate value - never into a count.
#
#   4. Never combine `-F` and `-i` in one grep: GNU grep 3.0, shipped by
#      Git for Windows/MSYS2, SIGABRTs on that pair (rc 134) and prints
#      nothing at all on stderr (I-027).
#
#   5. An invariant that cannot scan FATALs and prints NO summary line: the
#      closing metrics line is a claim about a scan that happened (I-029).
# ======================================================================
#
# The scan reads the WORKING TREE with `find`, never `git grep` and never a
# shell glob: `git grep` only sees tracked files, so an offender written and
# never `git add`ed would pass invisibly, and globs do not match dotfiles at all
# (I-018, I-019) - which matters here, because the likeliest place for this
# variable to appear is .gitlab-ci.yml or .github/workflows/.
#
# Anti-I-007 canary: an `exit 0` from a grep that scanned nothing is
# indistinguishable from an `exit 0` over a clean tree. So this script also
# counts how many files MENTION the variable name at all. A run reporting zero
# definitions over a tree that contains several mentions has demonstrably
# discriminated; a run reporting zero definitions over a tree with zero mentions
# has demonstrated nothing, and is reported as a finding. Both numbers are
# printed, always.
#
# Usage: tests/bin/no-ci-allow-dev   (run from anywhere; it cd's to the repo root)

set -u
# No `set -e`: a finding must be recorded and counted, not abort the run.

# ---------------------------------------------------------------- repo root --
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
cd "$REPO_ROOT" || { echo "FATAL: cannot cd to repo root $REPO_ROOT"; exit 1; }

SELF_REL="./${SCRIPT_DIR#"$REPO_ROOT"/}/$(basename -- "$0")"

C_OK=""; C_BAD=""; C_OFF=""; C_DIM=""
if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_BAD=$'\033[31m'; C_OFF=$'\033[0m'; C_DIM=$'\033[2m'
fi

FINDINGS=0

finding() {
  FINDINGS=$((FINDINGS + 1))
  printf '  %s%s:%s%s  %s\n' "$C_BAD" "${1#./}" "$2" "$C_OFF" "$3"
}

note() { printf '  %s%s%s\n' "$C_DIM" "$1" "$C_OFF"; }

# ------------------------------------------------------- grep's third state --
# T-316 / I-027. `grep` has THREE exit states, not two: 0 = matched, 1 = no
# match, >= 2 = grep itself FAILED (invalid pattern, unreadable file, crash).
# The greps below discarded stderr and inferred "no match" from "no stdout", so
# a grep that could not run read exactly like a clean tree - a scanner that
# cannot scan reporting that everything is fine.
#
# A grep error is therefore FATAL here: never a warning, never a finding. A
# finding says "the tree contains an offender"; this says "the tree was not
# searched". rc 1 keeps its meaning everywhere below - only rc >= 2 aborts.
fatal() { # <reason>
  printf '\nFATAL: %s\n' "$1"
  printf 'The scan did not complete: this run has NO result, which is not a clean result.\n'
  printf '(T-316 / I-027)\n'
  exit 1
}

grep_failed() { # <rc> <pattern> <subject>
  fatal "$(printf 'grep failed (exit %s) on %s while matching: %s' "$1" "$3" "$2")"
}

# The bare name. Used ONLY for the canary count, never to produce a finding.
MENTION_PATTERN='CI_ALLOW_DEV'
# The name followed by optional whitespace and a `:` or `=` separator. This is
# the only thing that produces a finding.
DEFINITION_PATTERN='CI_ALLOW_DEV[[:space:]]*[:=]'

PRUNED='./.git ./vendor ./node_modules ./web'

scan_files() {
  find . \
    -path ./.git -prune -o \
    -path ./vendor -prune -o \
    -path ./node_modules -prune -o \
    -path ./web -prune -o \
    -type f -print 2>/dev/null | LC_ALL=C sort
}

# ------------------------------------------------ tracked / untracked split --
# T-1915. WHY THE TOTAL ABOVE IS NOT A DENOMINATOR, and it was measured rather
# than argued. This scan walks the FILESYSTEM on purpose: `git grep` and friends
# see only tracked files, so an offender written and never `git add`ed would
# pass invisibly (I-018). But the filesystem is a property of the MACHINE and
# not of the commit. On 2026-09-21 this checkout carried
# .claude/settings.local.json, five .cspell-cache/ files and four
# tests/bin/__pycache__/ entries that no clone of the same commit has, so this
# invariant reported 472 files here and 462 in CI for one commit.
#
# A number that depends on whose machine produced it cannot be compared against
# another run - and this project quotes these totals in task rows, in commit
# messages and in CI summaries exactly as though they were comparable.
#
# THE FIX IS NOT TO SCOPE THE SCAN TO `git ls-files`: that would delete the one
# thing this scope exists for. It is to PARTITION the same walk. `git-tracked`
# is identical in every clone of a commit; `untracked` is the local difference,
# and it is NAMED rather than merely counted, because "ten extra files" and
# "ten extra files, and here they are" are different statements.
#
# THE TWO LABELS CANNOT BE NESTED, and that is a deliberate choice rather than a
# wording preference: the gate runner extracts a figure with an ERE and takes
# the LAST match, so a label that is a SUBSTRING of the other - `tracked:`
# inside `untracked:` - would silently hand it the wrong number.
#
# A failed `git ls-files` is FATAL, never "0 tracked". A broken split reports
# the whole tree as untracked and the tracked denominator as zero, which is a
# figure that looks like a measurement and is the absence of one (I-028).
split_tracked() { # <path to the scanned list> <dir to write the three sets in>
  _list=$1; _dir=$2
  git -c core.quotePath=false ls-files > "$_dir/tracked-raw" 2>/dev/null \
    || fatal 'git ls-files failed - the tracked/untracked split did not happen, and an unsplit scan cannot be reconciled with any other run of this invariant.'
  LC_ALL=C sort -o "$_dir/tracked-raw" "$_dir/tracked-raw"
  sed 's|^\./||' "$_list" | LC_ALL=C sort > "$_dir/scope-norm"
  LC_ALL=C comm -12 "$_dir/scope-norm" "$_dir/tracked-raw" > "$_dir/scope-tracked"
  LC_ALL=C comm -23 "$_dir/scope-norm" "$_dir/tracked-raw" > "$_dir/scope-untracked"
}

# ---------------------------------------------------------------- preflight --
for tool in find grep sort wc comm git sed; do
  command -v "$tool" >/dev/null 2>&1 || \
    finding '<preflight>' '0' "required tool not available: $tool"
done

printf '=========================================================================================================\n'
printf 'no-ci-allow-dev - Agora invariant T-209\n'
printf 'repo: %s\n' "$REPO_ROOT"
printf 'date: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
printf '=========================================================================================================\n'

TMPDIR_RUN=$(mktemp -d 2>/dev/null) || { echo "FATAL: cannot create a temp dir"; exit 1; }
trap 'rm -rf "$TMPDIR_RUN"' EXIT
ALL_LIST="$TMPDIR_RUN/all"
scan_files > "$ALL_LIST"
SCANNED=$(wc -l < "$ALL_LIST" | tr -d ' ')

printf '\nscope:    working tree of %s\n' "$REPO_ROOT"
printf '          pruned: %s\n' "$PRUNED"
printf 'scanned:  %s files\n' "$SCANNED"

# T-321(b): defaulted because zero means FAIL here - the safe direction of
# I-031. Do not copy the `:-0` to a guard where zero means PASS.
if [ "${SCANNED:-0}" -eq 0 ]; then
  finding '<scope>' '0' 'the scan found 0 files in scope - the result proves nothing'
fi

# T-1915: the same walk, partitioned, so this run and the runner's run of the
# same commit print a figure a reader can put side by side. See split_tracked().
split_tracked "$ALL_LIST" "$TMPDIR_RUN"
TRACKED=$(wc -l < "$TMPDIR_RUN/scope-tracked" | tr -d ' ')
UNTRACKED=$(wc -l < "$TMPDIR_RUN/scope-untracked" | tr -d ' ')
printf 'git-tracked: %s files - untracked: %s files\n' "$TRACKED" "$UNTRACKED"
# Zero means FAIL here, the safe direction of I-031: every clone of this
# repository has hundreds of tracked files, so 0 means the split broke.
if [ "${TRACKED:-0}" -eq 0 ]; then
  finding '<scope>' '0' \
    'the tracked/untracked split reported 0 tracked files - the split broke, and neither of its figures is a measurement'
fi
# The partition must exhaust the scan. If `comm` ever disagrees with `find` -
# a collation mismatch, a path git quotes and find does not - both halves would
# still print as plausible numbers, and only this line would notice.
if [ "$((TRACKED + UNTRACKED))" -ne "${SCANNED:-0}" ]; then
  finding '<scope>' '0' \
    "$(printf 'the split does not exhaust the scan: %s tracked + %s untracked != %s scanned' "$TRACKED" "$UNTRACKED" "$SCANNED")"
fi
if [ "${UNTRACKED:-0}" -gt 0 ]; then
  _shown=0
  while IFS= read -r u; do
    [ -n "$u" ] || continue
    _shown=$((_shown + 1))
    [ "$_shown" -le 25 ] && note "untracked here, in no clone of this commit: $u"
  done < "$TMPDIR_RUN/scope-untracked"
  [ "$UNTRACKED" -gt 25 ] && note "... and $((UNTRACKED - 25)) more; the count above is exact"
fi

# ------------------------------------------------------------------ canary ---
# This script itself contains the variable name, so counting it would make the
# canary pass by self-reference - which would prove exactly nothing. It is
# excluded from the MENTION count only, and the exclusion is printed. It stays
# fully inside the DEFINITION scan below, so this file is not above its own law.
printf '\ncanary (anti-I-007): files that merely MENTION the variable\n'
printf '  1 file excluded from the mention count: %s (self, would pass by self-reference)\n' "${SELF_REL#./}"

MENTIONS=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ "$f" = "$SELF_REL" ] && continue
  LC_ALL=C grep -qIE "$MENTION_PATTERN" "$f" 2>/dev/null
  MEN_RC=$?
  [ "$MEN_RC" -ge 2 ] && grep_failed "$MEN_RC" "$MENTION_PATTERN" "$f"
  if [ "$MEN_RC" -eq 0 ]; then
    MENTIONS=$((MENTIONS + 1))
    printf '  %smention: %s%s\n' "$C_DIM" "${f#./}" "$C_OFF"
  fi
done < "$ALL_LIST"
printf '  mentions in scope: %s\n' "$MENTIONS"

# T-321(b): defaulted because zero means FAIL here - the safe direction of
# I-031. Do not copy the `:-0` to a guard where zero means PASS.
if [ "${MENTIONS:-0}" -eq 0 ] && [ "${SCANNED:-0}" -gt 0 ]; then
  # tests/src/Kernel/RequirementsTest.php reads the variable by design, and
  # T-406 forbids deleting that read, so at least one mention must always exist.
  # Zero means the scan did not reach the tree it claims to police.
  finding '<canary>' '0' \
    'zero mentions found in scope - the scan is not credible, it discriminated nothing'
fi

# ------------------------------------------------------------- definitions ---
printf '\ndefinitions: the variable name followed by a colon or an equals sign\n'
DEFINITIONS=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  # The grep runs HERE, not inside the `<<<` below, and is not piped straight
  # into `cut`: in either case the exit status read back would be the subshell's
  # or `cut`'s, never grep's - and grep's is the one that separates "this file
  # defines nothing" (rc 1) from "this file was never searched" (rc >= 2).
  DEF_HITS=$(LC_ALL=C grep -nIE "$DEFINITION_PATTERN" "$f" 2>/dev/null)
  DEF_RC=$?
  [ "$DEF_RC" -ge 2 ] && grep_failed "$DEF_RC" "$DEFINITION_PATTERN" "$f"
  while IFS= read -r rec; do
    [ -n "$rec" ] || continue
    finding "$f" "${rec%%:*}" \
      'CI_ALLOW_DEV is DEFINED here - it weakens RequirementsTest and is never set in Agora'
    DEFINITIONS=$((DEFINITIONS + 1))
  done <<< "$(printf '%s\n' "$DEF_HITS" | cut -d: -f1)"
done < "$ALL_LIST"
[ "$DEFINITIONS" -eq 0 ] && note 'none'

# ----------------------------------------------------------------- summary ---
printf '\n---------------------------------------------------------------------------------------------------------\n'
printf 'scanned: %s files - git-tracked: %s - untracked: %s - mentions in scope: %s - definitions: %s - findings: %s\n' \
  "$SCANNED" "$TRACKED" "$UNTRACKED" "$MENTIONS" "$DEFINITIONS" "$FINDINGS"

if [ "$FINDINGS" -eq 0 ]; then
  printf '%sno-ci-allow-dev: clean%s\n' "$C_OK" "$C_OFF"
  exit 0
fi
printf '%sno-ci-allow-dev: %s finding(s)%s\n' "$C_BAD" "$FINDINGS" "$C_OFF"
exit 1
