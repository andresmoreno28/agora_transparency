#!/usr/bin/env bash
#
# no-varchar-aggregate - Agora - unit 003, D-040.
#
# Fails if any exported Views display aggregates a Field API field with an
# aggregate function that requires a numeric argument. That configuration emits
# SQL which sums a text column, and it is wrong on EVERY database Drupal
# supports - only one of them says so:
#
#   PostgreSQL 16.15  ERROR: function sum(character varying) does not exist
#   MariaDB           0, with "Warning 1292 Truncated incorrect DOUBLE value"
#   SQLite            0.0, silently
#
# The cause is core's `FieldPluginBase::addAdditionalFields()`: an aggregated
# field handler drags its table's companion columns - `langcode` and `bundle`,
# both varchar - into the same aggregate. [#2975149] and [#3018025] are open
# since 2018; patching is closed by CLAUDE.md rule 1. So the fix lives in
# config, and this script is what keeps it fixed.
#
# WHY IT IS AN INVARIANT AND NOT A TEST. Gate A was green - nine jobs, all
# blocking, 1951 assertions - while the shipped query summed a text column,
# because no assertion read that column and no runner ran PostgreSQL (D-040(2)).
# A functional test cannot catch this on MariaDB or SQLite at all: they return
# a wrong answer, not an error. The defect is visible in the CONFIG, on any
# host, with no database at all - which is exactly where a gate can reach it.
#
# THE PREDICATE, both halves required:
#   - `group_type` in {sum, avg, stddev_pop} - the three aggregate functions
#     that take a numeric argument. `count`, `count_distinct`, `min`, `max` and
#     `group` are measured safe on all three databases and are NOT findings.
#   - a `table` matching `^[a-z_]+__field_` - a Field API field's dedicated
#     table, which has the langcode/bundle companions. An entity BASE table
#     (`node_field_data`) has none, so aggregating over it is safe.
#
# OUT OF SCOPE, DELIBERATELY: `sorts`. A sort with `group_type: sum` over the
# same field is CLEAN - `GroupByNumeric::query()` never calls
# `addAdditionalFields()` - and D-040's signed remedy KEEPS that sort, so a
# check that flagged it would be red on the correct configuration. Aggregating
# sorts are COUNTED and printed as a census, so that a reader can see they were
# considered rather than forgotten.
#
# Scope is `config/views.view.*.yml`, parsed by tests/bin/no-varchar-aggregate.py
# (standard library only - see its header for why PyYAML is not imported).
# There is no allow-list, and there are no exclusions.
#
# Contract:
#   scope:      <the glob, and the exact file count it resolved to>
#   scanned:    <N> view(s)         - N must be > 0 or this script exits 1
#   displays:   <N> scanned, <M> aggregating
#   field entries inspected: <N>
#   findings:   <M>                 - each printed as  path:line  reason
#   exit 0 iff M == 0
#
# An empty scope, a missing tool, an unparseable file or an empty deny-list is a
# FAILURE, never a skip (I-007, I-028). A deny-list of zero terms would print
# "findings: 0" and pass by construction, so its length is asserted here before
# anything is summarised.
#
#
# House rules for tests/bin/ (T-321(c)): `wc -l` never `grep -c` for a compared
# value; numeric guards defaulted ONLY where zero means FAIL; grep rc >= 2 is an
# error, never "no match"; never `-F` with `-i`. The CANONICAL copy of the block,
# with the reasoning and the I-031 asymmetry spelled out, lives in the header of
# tests/bin/no-ci-allow-dev. Read it before adding a counter here.
#
# Usage: tests/bin/no-varchar-aggregate   (run from anywhere; it cd's to root)

set -u
# No `set -e`: a finding must be recorded and counted, not abort the run.

# `CDPATH= cd` is an env-var prefix, not an assignment; shellcheck misreads it.
# shellcheck disable=SC1007
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1007
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
cd "$REPO_ROOT" || { echo "FATAL: cannot cd to repo root $REPO_ROOT"; exit 1; }

C_BAD=""; C_OFF=""
if [ -t 1 ]; then C_BAD=$(printf '\033[31m'); C_OFF=$(printf '\033[0m'); fi

fatal() { printf 'FATAL: %s\n' "$1" >&2; exit 1; }

# ---------------------------------------------------------------- preflight --
command -v python3 >/dev/null 2>&1 || fatal "required tool not found: python3"
# I-026: python3 can RESOLVE and still be a Microsoft Store stub that fails at
# first real use. Exercise it, do not merely locate it.
python3 -c 'pass' >/dev/null 2>&1 || fatal "python3 resolves but does not run"

MATCHER="$SCRIPT_DIR/no-varchar-aggregate.py"
[ -f "$MATCHER" ] || fatal "matcher not found: $MATCHER"
[ -r "$MATCHER" ] || fatal "matcher is not readable: $MATCHER"

CONFIG_DIR="config"
[ -d "$CONFIG_DIR" ] || fatal "$CONFIG_DIR/ not found in $REPO_ROOT (empty scope)"

# `find` rather than a glob: an unmatched glob expands to itself in sh, which
# would hand the matcher a filename that does not exist and turn an empty scope
# into a parse error instead of the loud, specific failure below.
FILE_LIST=$(mktemp -t no-varchar-aggregate.XXXXXX) || fatal "cannot create a temp file"
OUT_FILE=$(mktemp -t no-varchar-aggregate-out.XXXXXX) || fatal "cannot create a temp file"
trap 'rm -f "$FILE_LIST" "$OUT_FILE"' EXIT

find "$CONFIG_DIR" -type f -name 'views.view.*.yml' 2>/dev/null | sort > "$FILE_LIST"
SCANNED=$(wc -l < "$FILE_LIST" | tr -d '[:space:]')

# T-321(b): defaulted because zero means FAIL here - the safe direction of
# I-031. Do not copy the `:-0` to a guard where zero means PASS.
if [ "${SCANNED:-0}" -eq 0 ]; then
  printf '\nno-varchar-aggregate - aggregated Field API columns in exported Views config\n\n'
  printf 'scope:      %s/views.view.*.yml\n' "$CONFIG_DIR"
  printf 'scanned:    0 view(s)\n'
  printf 'findings:   n/a\n'
  printf '\nFAILURE: 0 views scanned - an empty scope proves nothing (I-007).\n'
  exit 1
fi

# ------------------------------------------------------------------- match ---
# The matcher's exit status is read, not inferred from its output: a parser that
# did not run is not a parser that found nothing (I-027).
MATCH_RC=0
# shellcheck disable=SC2046
python3 "$MATCHER" $(tr '\n' ' ' < "$FILE_LIST") > "$OUT_FILE" 2>&1 || MATCH_RC=$?
if [ "$MATCH_RC" -ne 0 ]; then
  printf '\nno-varchar-aggregate - aggregated Field API columns in exported Views config\n\n'
  sed 's/^/  /' "$OUT_FILE" >&2
  printf '\nFAILURE: the parser exited %s. Nothing was inspected: this run has NO\n' "$MATCH_RC"
  printf 'result, which is not a clean result (I-027).\n'
  exit 1
fi

# count_of <name>  -> the integer on that COUNT record, or '' if absent.
count_of() {
  _out=$(grep -E "^COUNT	$1	[0-9]+$" "$OUT_FILE" 2>/dev/null)
  _rc=$?
  [ "$_rc" -ge 2 ] && fatal "grep failed (exit $_rc) reading the COUNT record $1"
  [ "$_rc" -eq 0 ] || return 0
  printf '%s' "$_out" | tail -1 | cut -f3
}

DISPLAYS=$(count_of displays)
AGG_DISPLAYS=$(count_of aggregating_displays)
FIELDS=$(count_of fields_inspected)
TERMS=$(count_of unsafe_terms)
SORTS=$(count_of aggregating_sorts)
M=$(count_of findings)

for pair in "displays:$DISPLAYS" "aggregating_displays:$AGG_DISPLAYS" \
            "fields_inspected:$FIELDS" "unsafe_terms:$TERMS" \
            "aggregating_sorts:$SORTS" "findings:$M"; do
  case "${pair#*:}" in
    '') fatal "the parser printed no ${pair%%:*} count - the summary is unreadable" ;;
  esac
done

# I-028: a deny-list of zero terms prints "findings: 0" and passes by
# construction. Its length is asserted before anything is reported.
if [ "${TERMS:-0}" -eq 0 ]; then
  printf '\nFAILURE: the deny-list is empty - every run would pass by construction (I-028).\n'
  exit 1
fi

# ------------------------------------------------------------------ report --
printf '\nno-varchar-aggregate - aggregated Field API columns in exported Views config\n\n'
printf 'scope:      %s/views.view.*.yml\n' "$CONFIG_DIR"
printf 'scanned:    %s view(s)\n' "$SCANNED"
printf 'displays:   %s scanned, %s aggregating (group_by: true, resolved through `defaults`)\n' \
  "$DISPLAYS" "$AGG_DISPLAYS"
printf 'field entries inspected: %s (under an aggregating display only)\n' "$FIELDS"
printf 'deny-list:  %s term(s) - %s\n' "$TERMS" \
  "$(grep -E '^NOTE	deny-list: ' "$OUT_FILE" | cut -f2 | sed 's/^deny-list: //')"
printf 'safe:       %s\n' \
  "$(grep -E '^NOTE	measured safe' "$OUT_FILE" | cut -f2 | sed 's/^measured safe, not flagged: //')"
printf 'sorts with an aggregate function: %s (OUT OF SCOPE and clean - see the header)\n' "$SORTS"
printf 'exclusions: none\n'

grep -E '^NOTE	' "$OUT_FILE" | grep -vE '^NOTE	(deny-list|measured safe)' \
  | cut -f2 | sed 's/^/note:       /'

printf 'findings:   %s\n' "$M"

if [ "$M" -gt 0 ]; then
  printf '\n'
  grep -E '^FINDING	' "$OUT_FILE" | while IFS=$(printf '\t') read -r _tag path lineno reason; do
    printf '  %s%s:%s%s  %s\n' "$C_BAD" "$path" "$lineno" "$C_OFF" "$reason"
  done
  printf '\nFAILURE: %s aggregated Field API field(s). The SQL this ships sums a text\n' "$M"
  printf 'column: PostgreSQL refuses it, MariaDB and SQLite answer 0 (D-040).\n'
  exit 1
fi

printf '\nOK: no display aggregates a Field API field with sum, avg or stddev_pop.\n'
exit 0
