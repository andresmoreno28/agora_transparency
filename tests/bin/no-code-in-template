#!/usr/bin/env bash
#
# no-code-in-template - Agora - unit 001, wave 3, task T-307.
#
# Mirrors, locally and without booting Drupal, the first assertion of
# tests/src/Kernel/RequirementsTest.php:
#
#   "Recipes cannot include any code (modules or themes) of their own; they must
#    list them as dependencies in `composer.json`."
#
# The kernel test expresses that as: zero `*.info.yml` files anywhere under the
# site template root. This script requires the same, and adds the absence of the
# `recipes/`, `themes/` and `modules/` directories at the repository root - the
# three shapes this project has been told repeatedly not to create.
#
# Contract (shared by every invariant in tests/bin/):
#   scope:    the exact set of files and directories inspected
#   scanned:  N entries, and N must be > 0 or this script fails
#   findings: M, each printed as  path:line  reason
#   exit 0 if and only if M == 0
#
# TWO scopes, and they answer different questions:
#
#   1. The PACKAGED tree - `git archive --format=tar HEAD | tar -tf -`. This is
#      literally what Drupal.org ships to a person installing the template, and
#      it is therefore the authoritative scope. It reads HEAD, so it is BLIND to
#      anything not yet committed: a `themes/x/x.info.yml` written one second ago
#      and never `git add`ed does not appear here. That is not a bug, it is the
#      question this scope answers - "what would we publish right now".
#      `git archive` only reads; it never touches the index or the working tree.
#
#   2. The WORKING tree - `find`, minus .git/ vendor/ node_modules/ web/. This is
#      the early warning, and it is the scope that catches the uncommitted
#      offender that scope 1 cannot see (I-018: `git grep` and friends only see
#      tracked files). It is NOT authoritative, because `export-ignore` legitimately
#      keeps files out of the release.
#
# Both are printed separately. Neither is allowed to be empty: an empty scope is
# a FINDING, never a skip (I-007). Scopes come from `find` and `tar -t`, never
# from a shell glob, which would silently miss dotfiles (I-019).
#
#
# House rules for tests/bin/ (T-321(c)): `wc -l` never `grep -c` for a compared
# value; numeric guards defaulted ONLY where zero means FAIL; grep rc >= 2 is an
# error, never "no match"; never `-F` with `-i`. The CANONICAL copy of the block,
# with the reasoning and the I-031 asymmetry spelled out, lives in the header of
# tests/bin/no-ci-allow-dev. Read it before adding a counter here.
#
# Usage: tests/bin/no-code-in-template   (run from anywhere; it cd's to the repo root)

set -u
# No `set -e`: a finding must be recorded and counted, not abort the run.

# ---------------------------------------------------------------- repo root --
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
cd "$REPO_ROOT" || { echo "FATAL: cannot cd to repo root $REPO_ROOT"; exit 1; }

C_OK=""; C_BAD=""; C_OFF=""; C_DIM=""
if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_BAD=$'\033[31m'; C_OFF=$'\033[0m'; C_DIM=$'\033[2m'
fi

FINDINGS=0

# finding <path> <line> <reason>
finding() {
  FINDINGS=$((FINDINGS + 1))
  printf '  %s%s:%s%s  %s\n' "$C_BAD" "${1#./}" "$2" "$C_OFF" "$3"
}

note() { printf '  %s%s%s\n' "$C_DIM" "$1" "$C_OFF"; }

# ------------------------------------------------------- grep's third state --
# T-316 / I-027. `grep` has THREE exit states, not two: 0 = matched, 1 = no
# match, >= 2 = grep itself FAILED (invalid pattern, unreadable file, crash).
# The greps below discarded stderr and inferred "no match" from "no stdout", so
# a grep that could not run read exactly like a clean tree - a scanner that
# cannot scan reporting that everything is fine.
#
# A grep error is therefore FATAL here: never a warning, never a finding. A
# finding says "the tree contains an offender"; this says "the tree was not
# searched". rc 1 keeps its meaning everywhere below - only rc >= 2 aborts.
fatal() { # <reason>
  printf '\nFATAL: %s\n' "$1"
  printf 'The scan did not complete: this run has NO result, which is not a clean result.\n'
  printf '(T-316 / I-027)\n'
  exit 1
}

grep_failed() { # <rc> <pattern> <subject>
  fatal "$(printf 'grep failed (exit %s) on %s while matching: %s' "$1" "$3" "$2")"
}

# Directories that must not exist at the repository root. The repository IS the
# recipe: there are no local sub-recipes, and the theme is a separate project
# declared in composer.json, never versioned here.
FORBIDDEN_DIRS='recipes themes modules'

PRUNED='./.git ./vendor ./node_modules ./web'

scan_files() {
  find . \
    -path ./.git -prune -o \
    -path ./vendor -prune -o \
    -path ./node_modules -prune -o \
    -path ./web -prune -o \
    -type f -print 2>/dev/null | LC_ALL=C sort
}

# ------------------------------------------------ tracked / untracked split --
# T-1915. WHY SCOPE 2'S TOTAL IS NOT A DENOMINATOR, measured rather than
# argued. Scope 2 walks the FILESYSTEM on purpose - it is the early warning for
# the uncommitted offender scope 1 is structurally unable to see. But the
# filesystem is a property of the MACHINE and not of the commit. On 2026-09-21
# this checkout carried .claude/settings.local.json, five .cspell-cache/ files
# and four tests/bin/__pycache__/ entries that no clone of the same commit has,
# so scope 2 reported 472 files here and 456 in CI for one commit.
#
# Note that scope 1 does NOT have this problem and never did: `git archive`
# reads the index, so its entry count is a property of the commit. That
# asymmetry is the whole finding - the invariants that read the INDEX agree
# across environments and the ones that walk the FILESYSTEM do not.
#
# THE FIX IS NOT TO SCOPE THE WALK TO `git ls-files`: that would delete the one
# thing scope 2 exists for. It is to PARTITION the same walk. `git-tracked` is
# identical in every clone of a commit; `untracked` is the local difference,
# and it is NAMED rather than merely counted.
#
# THE TWO LABELS CANNOT BE NESTED: the gate runner extracts a figure with an
# ERE and takes the LAST match, so a label that is a SUBSTRING of the other -
# `tracked:` inside `untracked:` - would silently hand it the wrong number.
#
# A failed `git ls-files` is FATAL, never "0 tracked". A broken split reports
# the whole tree as untracked and the tracked denominator as zero, which is a
# figure that looks like a measurement and is the absence of one (I-028).
split_tracked() { # <path to the scanned list> <dir to write the three sets in>
  _list=$1; _dir=$2
  git -c core.quotePath=false ls-files > "$_dir/tracked-raw" 2>/dev/null \
    || fatal 'git ls-files failed - the tracked/untracked split did not happen, and an unsplit scan cannot be reconciled with any other run of this invariant.'
  LC_ALL=C sort -o "$_dir/tracked-raw" "$_dir/tracked-raw"
  sed 's|^\./||' "$_list" | LC_ALL=C sort > "$_dir/scope-norm"
  LC_ALL=C comm -12 "$_dir/scope-norm" "$_dir/tracked-raw" > "$_dir/scope-tracked"
  LC_ALL=C comm -23 "$_dir/scope-norm" "$_dir/tracked-raw" > "$_dir/scope-untracked"
}

# ---------------------------------------------------------------- preflight --
# A missing tool cannot be a reason to report a clean tree. `git` and `tar` are
# required by the packaged scope; without them that scope cannot be evaluated,
# and an unevaluated scope is a finding.
for tool in find grep sort wc git tar comm sed; do
  command -v "$tool" >/dev/null 2>&1 || \
    finding '<preflight>' '0' "required tool not available: $tool"
done

printf '=========================================================================================================\n'
printf 'no-code-in-template - Agora invariant T-307\n'
printf 'repo: %s\n' "$REPO_ROOT"
printf 'date: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
printf '=========================================================================================================\n'

TMPDIR_RUN=$(mktemp -d 2>/dev/null) || { echo "FATAL: cannot create a temp dir"; exit 1; }
trap 'rm -rf "$TMPDIR_RUN"' EXIT

# =============================================== scope 1: the packaged tree ===
# Authoritative. This is what a person downloading the template receives.
PACKAGED_LIST="$TMPDIR_RUN/packaged"
: > "$PACKAGED_LIST"
PACKAGED=0

printf '\nscope 1 (authoritative): packaged tree - git archive --format=tar HEAD | tar -tf -\n'
printf '          read-only; reads HEAD, so it cannot see uncommitted files\n'

if git rev-parse --verify HEAD >/dev/null 2>&1; then
  if git archive --format=tar HEAD 2>/dev/null | tar -tf - > "$PACKAGED_LIST" 2>/dev/null; then
    PACKAGED=$(wc -l < "$PACKAGED_LIST" | tr -d ' ')
  else
    finding '<packaged>' '0' 'git archive or tar failed - the packaged tree could not be listed'
  fi
else
  finding '<packaged>' '0' 'no HEAD commit - the packaged tree could not be listed'
fi

printf 'packaged: %s entries\n' "$PACKAGED"
# T-321(b): defaulted because zero means FAIL here - the safe direction of
# I-031. Do not copy the `:-0` to a guard where zero means PASS.
if [ "${PACKAGED:-0}" -eq 0 ]; then
  finding '<packaged>' '0' 'the packaged tree listed 0 entries - the result proves nothing'
fi

PKG_INFO=0
while IFS= read -r e; do
  [ -n "$e" ] || continue
  case "$e" in
    *.info.yml)
      finding "$e" '0' 'packaged: *.info.yml - a site template cannot ship code of its own'
      PKG_INFO=$((PKG_INFO + 1))
      ;;
  esac
done < "$PACKAGED_LIST"

PKG_DIRS=0
for d in $FORBIDDEN_DIRS; do
  # The grep runs HERE, not inside the `<<<` below: a command substitution is a
  # subshell, and grep's exit status would not survive it. rc 1 (the directory
  # is absent from the archive) is the expected clean answer; rc >= 2 means the
  # archive listing was never searched and "0 entries" would be fabricated.
  PKG_HITS=$(LC_ALL=C grep -E "^$d/" "$PACKAGED_LIST" 2>/dev/null)
  PKG_RC=$?
  [ "$PKG_RC" -ge 2 ] && grep_failed "$PKG_RC" "^$d/" "$PACKAGED_LIST"
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    finding "$e" '0' "packaged: entry under the forbidden root directory $d/"
    PKG_DIRS=$((PKG_DIRS + 1))
  done <<< "$PKG_HITS"
done
[ "$PKG_INFO" -eq 0 ] && [ "$PKG_DIRS" -eq 0 ] && note 'no *.info.yml, no forbidden root directories'

# ============================================ scope 2: the working tree =======
# Early warning. Catches the offender that has not been committed yet, which the
# packaged scope above is structurally unable to see.
WORKING_LIST="$TMPDIR_RUN/working"
scan_files > "$WORKING_LIST"
WORKING=$(wc -l < "$WORKING_LIST" | tr -d ' ')

printf '\nscope 2 (early warning): working tree of %s\n' "$REPO_ROOT"
printf '          pruned: %s\n' "$PRUNED"
printf '          not authoritative: export-ignore legitimately keeps files out of the release\n'
printf 'working: %s files\n' "$WORKING"
# T-321(b): defaulted because zero means FAIL here - the safe direction of
# I-031. Do not copy the `:-0` to a guard where zero means PASS.
if [ "${WORKING:-0}" -eq 0 ]; then
  finding '<working>' '0' 'the working tree listed 0 files - the result proves nothing'
fi

# T-1915: the same walk, partitioned, so this run and the runner's run of the
# same commit print a figure a reader can put side by side. See split_tracked().
split_tracked "$WORKING_LIST" "$TMPDIR_RUN"
TRACKED=$(wc -l < "$TMPDIR_RUN/scope-tracked" | tr -d ' ')
UNTRACKED=$(wc -l < "$TMPDIR_RUN/scope-untracked" | tr -d ' ')
printf 'git-tracked: %s files - untracked: %s files\n' "$TRACKED" "$UNTRACKED"
# Zero means FAIL here, the safe direction of I-031: every clone of this
# repository has hundreds of tracked files, so 0 means the split broke.
if [ "${TRACKED:-0}" -eq 0 ]; then
  finding '<working>' '0' \
    'the tracked/untracked split reported 0 tracked files - the split broke, and neither of its figures is a measurement'
fi
# The partition must exhaust the walk. If `comm` ever disagrees with `find` -
# a collation mismatch, a path git quotes and find does not - both halves would
# still print as plausible numbers, and only this line would notice.
if [ "$((TRACKED + UNTRACKED))" -ne "${WORKING:-0}" ]; then
  finding '<working>' '0' \
    "$(printf 'the split does not exhaust the walk: %s tracked + %s untracked != %s working' "$TRACKED" "$UNTRACKED" "$WORKING")"
fi
if [ "${UNTRACKED:-0}" -gt 0 ]; then
  _shown=0
  while IFS= read -r u; do
    [ -n "$u" ] || continue
    _shown=$((_shown + 1))
    [ "$_shown" -le 25 ] && note "untracked here, in no clone of this commit: $u"
  done < "$TMPDIR_RUN/scope-untracked"
  [ "$UNTRACKED" -gt 25 ] && note "... and $((UNTRACKED - 25)) more; the count above is exact"
fi

WT_INFO=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    *.info.yml)
      finding "$f" '0' 'working tree: *.info.yml - a site template cannot ship code of its own'
      WT_INFO=$((WT_INFO + 1))
      ;;
  esac
done < "$WORKING_LIST"

WT_DIRS=0
for d in $FORBIDDEN_DIRS; do
  if [ -d "./$d" ]; then
    finding "$d/" '0' "working tree: forbidden root directory $d/ exists"
    WT_DIRS=$((WT_DIRS + 1))
  fi
done
[ "$WT_INFO" -eq 0 ] && [ "$WT_DIRS" -eq 0 ] && note 'no *.info.yml, no forbidden root directories'

# ----------------------------------------------------------------- summary ---
INFO_TOTAL=$((PKG_INFO + WT_INFO))
DIRS_TOTAL=$((PKG_DIRS + WT_DIRS))

printf '\n---------------------------------------------------------------------------------------------------------\n'
printf 'packaged: %s entries - working: %s files - git-tracked: %s - untracked: %s - *.info.yml: %s - forbidden dirs: %s - findings: %s\n' \
  "$PACKAGED" "$WORKING" "$TRACKED" "$UNTRACKED" "$INFO_TOTAL" "$DIRS_TOTAL" "$FINDINGS"

if [ "$FINDINGS" -eq 0 ]; then
  printf '%sno-code-in-template: clean%s\n' "$C_OK" "$C_OFF"
  exit 0
fi
printf '%sno-code-in-template: %s finding(s)%s\n' "$C_BAD" "$FINDINGS" "$C_OFF"
exit 1
