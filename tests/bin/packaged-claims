  FRONT_FILE=$(grep -lE "^ +alias: ${FRONT_ALIAS}\$" content/canvas_page/*.yml 2>/dev/null | head -1)
fi
if [ -n "$FRONT_FILE" ]; then
  FRONT_BLOCKS=$(grep -oE 'views_block\.[a-z_0-9-]+' "$FRONT_FILE" | wc -l | tr -d '[:space:]')
else
  FRONT_BLOCKS=''
fi
compare 'front_blocks' "$R_FRONT" "$FRONT_BLOCKS" "views_block components in the ${FRONT_ALIAS:-?} page"

claim_once 'packaged root' README 'holds \*\*[a-z]+\*\* top-level entries'
ARCH_TOP=$(printf '%s\n' "$ARCHIVE_LIST" | sed 's#/.*#/#' | sort -u | grep -v '^$' | wc -l | tr -d '[:space:]')
compare 'top_level_entries' "$(to_num "$(field 1 '.*\*\*([a-z]+)\*\* top-level.*')")" \
  "$ARCH_TOP" 'git archive | tar -t, first path segment'

