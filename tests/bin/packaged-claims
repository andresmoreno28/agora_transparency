# ============== T-0634: WCAG 2.5.8, and the one rule the gate switches on by name ==
# axe-core ships `target-size`, its only rule for WCAG 2.5.8, switched OFF, and until T-0634 the
# gate ran axe with no options at all - so the shipped statement listed 2.5.8 among what a person
# must confirm and README.md called it a criterion "axe cannot decide". AccessibilityTest now
# switches the rule on by name in BOTH of its scans, and both documents say so. That is a claim
# about the TEST, of exactly the kind the dashboard sentences above make, and it is bound the same
# way: the next change to the test cannot leave the prose saying 2.5.8 is measured when it is not.
#
# THE RULE'S NAME IS DERIVED FROM THE PROSE in both files, never typed here - a typed name would
# compare a constant against a constant. The statement's item is titled "Target size.", which
# lower-cases and hyphenates to the rule id; README names the rule in backticks.
#
# WHAT THIS CANNOT SEE: whether the rule MEASURED anything on a real page. That is a fact about a
# run, and the test asserts it itself - more than zero targets measured on every page it scans,
# logged-in page included - because a run is the only place it can be asked.
claim_once 'target size checked' STATEMENT \
  '<li><strong>[A-Z][a-z]+ [a-z]+\.</strong> WCAG 2\.2 success criterion 2\.5\.8 asks'
A_RULE=$(field 1 '.*<li><strong>([A-Z][a-z]+ [a-z]+)\.</strong> WCAG 2\.2 success criterion 2\.5\.8.*' \
  | tr 'A-Z ' 'a-z-')
# Extracted and not compared: reword it away from "on by name" and this FATALs in the same commit,
# the way 'admin scope' does for the dashboard's scoping sentence.
claim_once 'target size on by name' STATEMENT \
  'The scan of the pages above switches that rule on by name'
T_RULE=$(printf '%s\n' "$A11Y_SRC" \
  | sed -nE "s/^ +private const AXE_RULE_ENABLED_BY_NAME = '([a-z0-9-]+)';.*/\\1/p" | head -1)
compare 'a11y_rule_by_name' "$A_RULE" "$T_RULE" \
  "AXE_RULE_ENABLED_BY_NAME in $A11Y_TEST"

# EVERY axe run, not "an" axe run. The anonymous scan and the logged-in one each call
# window.axe.run( once, and the options splice in through one placeholder; a scan that went back to
# a default run would still leave the other one green. A count of ZERO calls is refused before the
# comparison, because two zeros agree (I-028).
AXE_RUNS=$(printf '%s\n' "$A11Y_SRC" | grep -E 'window\.axe\.run\(' 2>/dev/null \
  | wc -l | tr -d '[:space:]')
[ "${AXE_RUNS:-0}" -gt 0 ] || fatal "no window.axe.run( call was found in $A11Y_TEST. The count of runs that switch the rule on would be compared against zero, which agrees with zero and proves nothing."
AXE_RUNS_NAMED=$(printf '%s\n' "$A11Y_SRC" \
  | grep -E 'window\.axe\.run\(document, __AXE_OPTIONS__\)' 2>/dev/null | wc -l | tr -d '[:space:]')
compare 'a11y_rule_every_run' "$AXE_RUNS" "$AXE_RUNS_NAMED" \
  "window.axe.run( calls in $A11Y_TEST that pass __AXE_OPTIONS__"
# And the placeholder carries what its name says: ONE builder line switching on the constant by
# name. The typed '1' is the reading of the prose, not a figure in it - the same construction as
# admin_checked_only's '1' above.
OPTIONS_BUILT=$(printf '%s\n' "$A11Y_SRC" \
  | grep -E "'rules' => \[self::AXE_RULE_ENABLED_BY_NAME => \['enabled' => TRUE\]\]" 2>/dev/null \
  | wc -l | tr -d '[:space:]')
compare 'a11y_rule_options_built' '1' "$OPTIONS_BUILT" \
  "the line in $A11Y_TEST that builds the axe options from AXE_RULE_ENABLED_BY_NAME"

claim_once 'readme target size' README \
  '`[a-z0-9-]+` rule switched off, and the gate in this repository switches it on by name'
compare 'readme_rule_by_name' "$(field 1 '^`([a-z0-9-]+)` rule switched off.*')" "$T_RULE" \
  "AXE_RULE_ENABLED_BY_NAME in $A11Y_TEST"

# ================================= recipe.yml, composer.json, recommended.yml ==
printf '\nrecipe.yml / composer.json / recommended.yml\n'
printf -- '---------------------------------------------------------------------------------------------------------\n'

# A BOUND DUPLICATE, and the clearest example of why binding exists. The installer reads
# recipe.yml's description and Packagist reads composer.json's; neither can be deleted, and a
# package that describes itself differently in the two places is one a reviewer notices.
RECIPE_DESC=$(text_of RECIPE | sed -nE "s/^description: '(.*)'\$/\1/p")
COMPOSER_DESC=$(text_of COMPOSER | sed -nE 's/^ +"description": "(.*)",?$/\1/p')
[ -n "$RECIPE_DESC" ] || fatal "recipe.yml carries no single-quoted description: line, so the two descriptions cannot be compared and their agreement would be asserted over nothing."
[ -n "$COMPOSER_DESC" ] || fatal "composer.json carries no description key in the shape this reads, so the two descriptions cannot be compared."
CLAIMS=$((CLAIMS + 1))
COMPARISONS=$((COMPARISONS + 1))
if [ "$RECIPE_DESC" = "$COMPOSER_DESC" ]; then
  printf '  %s%-20s%s recipe.yml  =  composer.json  (%s chars)  %sOK%s\n' \
    "$C_DIM" 'description_match' "$C_OFF" "${#RECIPE_DESC}" "$C_OK" "$C_OFF"
else
  FINDINGS=$((FINDINGS + 1))
  printf '  %s%-20s recipe.yml != composer.json  MISMATCH%s\n' "$C_BAD" 'description_match' "$C_OFF"
  printf '      recipe.yml:    %s\n' "$RECIPE_DESC"
  printf '      composer.json: %s\n' "$COMPOSER_DESC"
fi

claim_once 'recommended empty' RECOMMENDED 'intentionally empty for now'
REC_ENTRIES=$(text_of RECOMMENDED | grep -E '^[a-z][a-z0-9_]*/[a-z][a-z0-9_]*:' | wc -l | tr -d '[:space:]')
compare 'recommended_empty' '0' "$REC_ENTRIES" 'uncommented package keys in recommended.yml'

# ============================================ LICENCE-MANIFEST.md vs what the package holds ==
# T-0619. Four of the figures the package-level licence manifest states are compared below, and
# each of the four is derived here from the package rather than from another sentence. (This
# said "four figures and no others" until 2026-09-24. The page also states figures about two
# other projects' releases, which the NOT CHECKED list names.)
#
# WHAT IT DELIBERATELY DOES NOT STATE, because the absence is the design. The size of the packaged
# set lives once in README.md and the media row count lives once in content/MEDIA-LICENCES.md; the
# licence manifest quotes neither, and states instead the SUBTRACTION between them. That is the
# same construction as cspell_gap above: where the two absolute figures have homes of their own,
# the derived one is the only number a third document may carry, and it is compared to both
# sources at once. A copy of either absolute figure appearing in the licence manifest is caught by
# the one-copy detectors below, which run over it like every other subject.
printf '\nLICENCE-MANIFEST.md - the package-level licence manifest against the package\n'
printf -- '---------------------------------------------------------------------------------------------------------\n'

# The packaged set, non-directory entries only - the same rule tests/bin/media-licence applies,
# so the subtraction below is between two sets that were partitioned by one rule and not two.
PKG_FILES=$(printf '%s\n' "$ARCHIVE_LIST" | grep -v '/$' 2>/dev/null | grep -v '^$' \
  | wc -l | tr -d '[:space:]')
[ "${PKG_FILES:-0}" -gt 0 ] || fatal 'the packaged listing held no files at all, so every count below would be a subtraction from nothing.'

# MEDIA, defined exactly as tests/bin/media-licence defines it: anything under content/ that is
# not a *.yml or *.json entity export, plus the two declared root binaries. The two Markdown files
# under content/ are prose and are excluded by that invariant's own root/non-media declaration, so
# they are excluded here too. Written out rather than shelling out to media-licence, because
# packaged-claims must stay offline and under a second; the two are held together by the licence
# term count below, which reads that invariant's own manifest rows.
PKG_MEDIA=$(printf '%s\n' "$ARCHIVE_LIST" | grep -v '/$' 2>/dev/null \
  | grep -E '^content/' 2>/dev/null | grep -vE '\.(yml|json|md)$' 2>/dev/null \
  | wc -l | tr -d '[:space:]')
ROOT_MEDIA=$(printf '%s\n' "$ARCHIVE_LIST" | grep -xE '(logo\.png|screenshot\.webp)' 2>/dev/null \
  | wc -l | tr -d '[:space:]')
PKG_MEDIA=$((PKG_MEDIA + ROOT_MEDIA))
[ "${PKG_MEDIA:-0}" -gt 0 ] || fatal 'the media rule matched 0 packaged files. The GPL subtraction would then equal the whole package and agree with a prose figure only by accident.'

claim_once 'gpl file count' LICENCES '\*\*[0-9]+ files in the packaged release are covered by'
L_GPL=$(field 1 '.*\*\*([0-9]+) files.*')
compare 'gpl_files' "$L_GPL" "$((PKG_FILES - PKG_MEDIA))" \
  'git archive, non-directory entries, minus the media set'

claim_once 'required projects' LICENCES '\*\*[0-9]+ projects\*\* are named in'
L_REQ=$(field 1 '.*\*\*([0-9]+) projects\*\*.*')
REQ_N=$(text_of COMPOSER | sed -n '/^ *"require": {/,/^ *},\{0,1\}$/p' \
  | grep -E '^ +"[a-z0-9_-]+/[a-z0-9_-]+": ' | wc -l | tr -d '[:space:]')
[ "${REQ_N:-0}" -gt 0 ] || fatal 'composer.json parsed to 0 require entries. A dependency count compared against nothing is not a check.'
compare 'required_projects' "$L_REQ" "$REQ_N" 'the require entries in composer.json'

claim_once 'font files' LICENCES '\*\*This package ships [0-9]+ font files\.\*\*'
L_FONTS=$(field 1 '.*ships ([0-9]+) font files.*')
PKG_FONTS=$(printf '%s\n' "$ARCHIVE_LIST" | grep -E '\.(woff2|woff|ttf|otf|eot)$' 2>/dev/null \
  | grep -v '^$' | wc -l | tr -d '[:space:]')
compare 'font_files' "$L_FONTS" "$PKG_FONTS" 'font files in git archive'

# The distinct licence terms the media rows actually use. Its home is the licence manifest: the
# media manifest states the ALLOW-LIST, which is a different and larger set, and the difference
# between what is permitted and what is used is the whole point of stating this one.
claim_once 'licences in use' LICENCES '\*\*[A-Za-z]+ licence terms are in use across those rows\*\*'
L_TERMS=$(to_num "$(field 1 '.*\*\*([A-Za-z]+) licence terms.*')")
MEDIA_TERMS=$(text_of MANIFEST \
  | grep -E '^\| [A-Za-z0-9_./-]+ \| .* \| .* \| .* \| .* \| [0-9]{4}-[0-9]{2}-[0-9]{2} \|$' 2>/dev/null \
  | sed -E 's/^.*\| ([^|]*) \| [0-9]{4}-[0-9]{2}-[0-9]{2} \|$/\1/' | sed 's/^ *//; s/ *$//' \
  | sort -u | grep -v '^$' | wc -l | tr -d '[:space:]')
[ "${MEDIA_TERMS:-0}" -gt 0 ] || fatal 'no licence term was read out of the media manifest rows at all, so the count of terms in use would be compared against zero.'
compare 'media_licences_in_use' "$L_TERMS" "$MEDIA_TERMS" \
  'distinct licence cells in the media manifest rows'

# ========================================= SECURITY.md vs the decision that set its window ==
# T-0618. The security policy makes ONE promise that is a number, and it is the one a reporter acts
# on: how long they wait before a person answers. The number is [andres]'s, set by D-064's amendment
# of 2026-09-24, so the measured side is that amendment's HEADING in the decision record - read out
# of it, never retyped here. A 14 written into this script would be a constant compared against a
# constant, and SECURITY.md could then move alone and still pass. Read from the record, the two can
# only move together: a different window is a new signed amendment, and a new amendment is what this
# comparison then reads.
#
# EXACTLY ONE D-064 heading may state a window, for the reason every claim here must match once. A
# second heading with a different figure would otherwise be settled by whichever line was read
# first, which is a tie-break and not a measurement. When a later amendment moves the window, this
# reader moves with it in the same commit. The middle dot in those headings is multi-byte, so it is
# matched with $DASH, like every other separator in this file.
#
# WHAT IS NOT BOUND HERE is named in NOT CHECKED below: the route, the coverage sentence and the
# sentence about how Drupal CMS copies a template's requirements are facts about Drupal.org or about
# another project, and nothing offline can re-derive them.
printf '\nSECURITY.md - the security policy against the decision that set its window\n'
printf -- '---------------------------------------------------------------------------------------------------------\n'

[ -r "$DECISIONS" ] || fatal "$DECISIONS is not readable, so the acknowledgement window SECURITY.md promises has no signed figure to be compared against."
claim_once 'security window' SECURITY \
  'acknowledges a report within \*\*[0-9A-Za-z-]+ calendar days\*\*'
S_WINDOW=$(to_num "$(field 1 '.*within \*\*([0-9A-Za-z-]+) calendar days.*')")
D064_HEADS=$(tr -d '\r' < "$DECISIONS" | grep -E "^## D-064 $DASH .*within [0-9A-Za-z-]+ calendar days")
_rc=$?
[ "$_rc" -ge 2 ] && grep_fatal "$_rc" "$DECISIONS while looking for the D-064 heading that sets the window"
[ "$_rc" -eq 0 ] || fatal "no D-064 heading in $DECISIONS states a window of the form 'within <n> calendar days', so the figure SECURITY.md promises would be compared against nothing. If the heading was reworded, this pattern moves with it in the same commit."
_n=$(printf '%s\n' "$D064_HEADS" | wc -l | tr -d '[:space:]')
[ "${_n:-0}" -eq 1 ] || fatal "$_n D-064 headings in $DECISIONS state a window, and exactly 1 may. Two signed figures for one promise is the ambiguity this file refuses rather than settles; when an amendment moves the window, this reader moves with it in the same commit."
D_WINDOW=$(to_num "$(printf '%s' "$D064_HEADS" | sed -nE 's/.*within ([0-9A-Za-z-]+) calendar days.*/\1/p')")
compare 'security_window' "$S_WINDOW" "$D_WINDOW" "the D-064 heading that set it, in $DECISIONS"

# ======================================================================= THE ONE-COPY RULE ==
printf '\nONE COPY - every registered figure has exactly one home in the packaged set (T-0609)\n'
printf -- '---------------------------------------------------------------------------------------------------------\n'

one_home 'site_axe_pages' STATEMENT \
  "($NUM pages of the site|$NUM pages are scanned|axe-core runs over $NUM pages)" \
  'The number of pages this package scans belongs in the document a visitor is actually served, which has to be readable on its own; README points at it rather than restating it.'

one_home 'listing_scanned' STATEMENT \
  "$NUM of the $NUM listing routes" \
  'The scanned-subset figure belongs beside the list of what is NOT covered, which is in the statement.'

one_home 'theme_axe_gate' STATEMENT \
  "(axe-core runs there over $NUM pages|$NUM fixture pages|$NUM of $NUM fixture)" \
  'The theme is a separate project whose gate moves on its own schedule. The statement keeps ONE description of it, in the paragraph that also says those pages are fixtures and not pages of this site; anywhere else it is a copy that goes stale within hours, which is exactly what happened on 2026-09-20.'

one_home 'pdf_count' MANIFEST \
  "$NUM (generated )?PDFs" \
  'The licence manifest is the document about the media, so the media counts live there.'

one_home 'csv_count' MANIFEST \
  "$NUM CSVs?( distributions?)?[ ,.]" \
  'Same: the manifest is the document about the media.'

one_home 'top_level_entries' README \
  "$NUM(\\*\\*)? top-level entries" \
  'What the tarball contains is a fact about the package, and README is the file a Drupal.org visitor opens to find out what they are installing.'

one_home 'ci_job_table' README \
  '\| `[A-Za-z -]+` \| [a-z]+ \| [a-z]+ \| (true|false) \|' \
  'The CI job list is a developer-facing observation; it belongs in README and nowhere in the shipped content.'

# T-0618. Anchored on "calendar days" and not on "days": the media manifest says "nineteen days"
# and "twenty-six days" about its own history, and a looser detector would report those as second
# copies of a promise they have nothing to do with.
one_home 'security_window' SECURITY \
  "$NUM calendar days" \
  'How long a reporter waits is a promise, and it is made in one place, the security policy. A second statement of it elsewhere is a second promise that can drift from the first, read by somebody who never opens the policy.'

# THE ONE DELIBERATELY BOUND DUPLICATE, and the reason the third home kind exists. Deleting
# either of these would cost a reader something: README's status paragraph and the statement's
# scope sentence are read by different people, neither of whom has the other file open. Both
# copies are compared against the same measured source above - `registers` and
# `registers_stated` - so a change to the content model fails BOTH, and neither can drift alone.
one_home 'registers' 'README STATEMENT' \
  "$NUM registers" \
  'Bound rather than deleted: both copies are compared against the distinct agora_base_* node bundles, above, in the same run.'

# ============================================================================== ONLINE ==
ONLINE_FIGURES='theme_axe_pages theme_axe_rules theme_axe_violations theme_contrast_pairs theme_contrast_below'
THEME_PROJECT='agora_theme'

printf '\nONLINE - the theme figures the statement quotes, re-read from the theme CI traces\n'
printf -- '---------------------------------------------------------------------------------------------------------\n'

not_read() { # <reason> - every online figure is unreachable for this one reason
  local f
  for f in $ONLINE_FIGURES; do
    UNREAD=$((UNREAD + 1))
    printf '  %sNOT READ%s  %-22s %s\n' "$C_BAD" "$C_OFF" "$f" "$1"
  done
  printf '\n  That is NOT "the figures are fine"; it is "nothing here could see them". An absence of\n'
  printf '  information is not good news, and it is never counted as a comparison.\n'
}

# The claims are extracted whether or not --online runs, so the offline pass still refuses a
# figure stated twice and a reader of the offline output can see what --online would fetch.
claim_once 'theme axe' STATEMENT 'axe-core runs there over [a-z]+ pages'
T_PAGES=$(to_num "$(field 1 '.*over ([a-z]+) pages.*')")
claim_once 'theme axe result' STATEMENT '<strong>[0-9]+ rules applied per page, [0-9]+ violations</strong>'
T_RULES=$(field 1 '.*<strong>([0-9]+) rules.*')
T_VIOL=$(field 1 '.*per page, ([0-9]+) violations.*')
claim_once 'theme contrast' STATEMENT '<strong>[0-9]+ pairs checked, [0-9]+ below threshold</strong>'
T_PAIRS=$(field 1 '.*<strong>([0-9]+) pairs.*')
T_BELOW=$(field 1 '.*checked, ([0-9]+) below.*')

if [ "$ONLINE" -ne 1 ]; then
  not_read 'not requested. Pass --online to re-read it; the gate deliberately does not.'
elif ! command -v curl >/dev/null 2>&1; then
  not_read 'curl is not on PATH, so no trace can be fetched from this shell.'
elif ! command -v python3 >/dev/null 2>&1; then
  not_read 'python3 is not on PATH, so the pipeline JSON cannot be parsed.'
else
  API="https://git.drupalcode.org/api/v4/projects/project%2F$THEME_PROJECT"
  RAW="https://git.drupalcode.org/project/$THEME_PROJECT/-/jobs"
  PJ=$(curl -sSL --max-time 40 "$API/pipelines?ref=1.x&per_page=20" 2>/dev/null)
  if [ -z "$PJ" ]; then
    not_read "the GitLab API returned nothing for $THEME_PROJECT's pipelines. No network, or the host is unreachable from here."
  else
    PICK=$(PJ="$PJ" python3 -c '
import json, os
# cspell:ignore isinstance
try:
    ps = json.loads(os.environ["PJ"])
except Exception as exc:
    print("ERR the API answered something that is not JSON: %s" % exc); raise SystemExit
if not isinstance(ps, list) or not ps:
    print("ERR the pipelines endpoint returned no list at all, which is a failure and not an empty result."); raise SystemExit
for p in ps:
    if p.get("status") == "success":
        print("PIPE %s %s" % (p.get("id"), (p.get("sha") or "")[:8])); raise SystemExit
print("ERR none of the %d most recent 1.x pipelines is a SUCCESSFUL, terminal one. The statement says its figures are those of the most recent run; a red or running pipeline is not one." % len(ps))
' 2>/dev/null)
    if [ -z "$PICK" ] || [ "${PICK#ERR }" != "$PICK" ]; then
      not_read "${PICK#ERR }"
    else
      T_PIPE=$(printf '%s' "$PICK" | sed -nE 's/^PIPE ([0-9]+) .*/\1/p')
      T_SHA=$(printf '%s' "$PICK" | sed -nE 's/^PIPE [0-9]+ (.*)/\1/p')
      JJ=$(curl -sSL --max-time 40 "$API/pipelines/$T_PIPE/jobs?per_page=100" 2>/dev/null)
      JOBS=$(JJ="$JJ" python3 -c '
import json, os
# cspell:ignore isinstance
try:
    js = json.loads(os.environ["JJ"])
except Exception as exc:
    print("ERR the jobs endpoint answered something that is not JSON: %s" % exc); raise SystemExit
if not isinstance(js, list) or not js:
    print("ERR the jobs endpoint returned no job list at all."); raise SystemExit
want = {"nightwatch": None, "agora-invariants": None}
for j in js:
    if j.get("name") in want and j.get("status") == "success":
        want[j["name"]] = j.get("id")
missing = [k for k, v in want.items() if not v]
if missing:
    print("ERR the pipeline has no successful %s job." % " and no successful ".join(missing)); raise SystemExit
print("NW %s" % want["nightwatch"])
print("INV %s" % want["agora-invariants"])
' 2>/dev/null)
      if [ -z "$JOBS" ] || [ "${JOBS#ERR }" != "$JOBS" ]; then
        not_read "${JOBS#ERR } (pipeline $T_PIPE)"
      else
        NW_ID=$(printf '%s\n' "$JOBS" | sed -n 's/^NW //p')
        INV_ID=$(printf '%s\n' "$JOBS" | sed -n 's/^INV //p')
        printf '  %s' "$C_DIM"
        printf 'read from %s pipeline %s, commit %s: nightwatch job %s, agora-invariants job %s%s\n' \
          "$THEME_PROJECT" "$T_PIPE" "$T_SHA" "$NW_ID" "$INV_ID" "$C_OFF"

        # -L is MANDATORY. Without it the 302 is a few hundred bytes and looks exactly like a
        # failure, which is an absence of information dressed as a measurement.
        NW=$(curl -sSL --max-time 60 "$RAW/$NW_ID/raw" 2>/dev/null | tr -d '\r')
        NW_BYTES=$(printf '%s' "$NW" | wc -c | tr -d '[:space:]')
        if [ "${NW_BYTES:-0}" -lt 2000 ]; then
          for f in theme_axe_pages theme_axe_rules theme_axe_violations; do
            UNREAD=$((UNREAD + 1))
            printf '  %sNOT READ%s  %-22s job %s returned %s bytes, which is a redirect or an error, not a log.\n' \
              "$C_BAD" "$C_OFF" "$f" "$NW_ID" "$NW_BYTES"
          done
        else
          AXE_LINE=$(printf '%s\n' "$NW" | grep -oE 'axe gate: [0-9]+ pages scanned, [0-9]+-[0-9]+ axe rules run per page, [0-9]+ violations' | sort -u)
          _n=$(printf '%s\n' "$AXE_LINE" | grep -v '^$' | wc -l | tr -d '[:space:]')
          if [ "${_n:-0}" -ne 1 ]; then
            for f in theme_axe_pages theme_axe_rules theme_axe_violations; do
              UNREAD=$((UNREAD + 1))
              printf '  %sNOT READ%s  %-22s the trace printed %s axe summary lines, expected 1. A log stating one figure twice is an ambiguous measurement, and an ambiguous measurement is not a measurement.\n' \
                "$C_BAD" "$C_OFF" "$f" "$_n"
            done
          else
            compare 'theme_axe_pages' "$T_PAGES" \
              "$(printf '%s' "$AXE_LINE" | sed -nE 's/.*gate: ([0-9]+) pages.*/\1/p')" "job $NW_ID"
            compare 'theme_axe_rules' "$T_RULES" \
              "$(printf '%s' "$AXE_LINE" | sed -nE 's/.*, ([0-9]+)-[0-9]+ axe rules.*/\1/p')" "job $NW_ID"
            compare 'theme_axe_violations' "$T_VIOL" \
              "$(printf '%s' "$AXE_LINE" | sed -nE 's/.*page, ([0-9]+) violations.*/\1/p')" "job $NW_ID"
          fi
        fi

        INVT=$(curl -sSL --max-time 60 "$RAW/$INV_ID/raw" 2>/dev/null | tr -d '\r')
        INV_BYTES=$(printf '%s' "$INVT" | wc -c | tr -d '[:space:]')
        if [ "${INV_BYTES:-0}" -lt 2000 ]; then
          for f in theme_contrast_pairs theme_contrast_below; do
            UNREAD=$((UNREAD + 1))
            printf '  %sNOT READ%s  %-22s job %s returned %s bytes, which is a redirect or an error, not a log.\n' \
              "$C_BAD" "$C_OFF" "$f" "$INV_ID" "$INV_BYTES"
          done
        else
          CT_LINE=$(printf '%s\n' "$INVT" | grep -oE 'pairs parsed: +[0-9]+ structural findings: +[0-9]+ pairs below threshold: +[0-9]+' | sort -u)
          _n=$(printf '%s\n' "$CT_LINE" | grep -v '^$' | wc -l | tr -d '[:space:]')
          if [ "${_n:-0}" -ne 1 ]; then
            for f in theme_contrast_pairs theme_contrast_below; do
              UNREAD=$((UNREAD + 1))
              printf '  %sNOT READ%s  %-22s the trace printed %s contrast summary lines, expected 1.\n' \
                "$C_BAD" "$C_OFF" "$f" "$_n"
            done
          else
            compare 'theme_contrast_pairs' "$T_PAIRS" \
              "$(printf '%s' "$CT_LINE" | sed -nE 's/.*pairs parsed: +([0-9]+).*/\1/p')" "job $INV_ID"
            compare 'theme_contrast_below' "$T_BELOW" \
              "$(printf '%s' "$CT_LINE" | sed -nE 's/.*pairs below threshold: +([0-9]+).*/\1/p')" "job $INV_ID"
          fi
        fi
      fi
    fi
  fi
fi

# ================================================================== ONLINE - THIS PACKAGE ==
# T-0613. The figure this package quotes about ITSELF, re-read from this project's own CI trace.
#
# WHY THIS BLOCK EXISTS, and it is the plainest gap this unit found. The shipped accessibility
# statement tells a citizen how many pages of the installed site axe scans. That number came from
# an assertion MESSAGE, and PHPUnit emits an assertion message only when the assertion FAILS -
# measured on pipeline 969787, job 12330735, green: `grep -c "pages scanned"` over the trace
# returned 0, and the junit.xml artefact of the same job carries a self-closing <testcase> with no
# message anywhere. `tests/` is export-ignored, so a reviewer who downloads the tarball cannot read
# the test either. The claim was therefore checkable from the README, from the CI log and from the
# package - that is, from nowhere - while the THEME's equivalent figure has always been public in
# its nightwatch job. A reviewer could check one claim and not the other.
#
# AccessibilityTest::tearDownAfterClass() now prints the summary, which runs outside the per-test
# output buffer and so is not caught by beStrictAboutOutputDuringTests. This reads it back.
#
# IT IS `--online` AND THE GATE NEVER PASSES THAT, for the same reason the theme block is: a check
# that fails because a runner has no network is a check somebody makes permissive.
SITE_FIGURES='site_axe_pages_log site_axe_violations_log'
SITE_PROJECT='agora_transparency'

printf '\nONLINE - this package own axe result, re-read from its own phpunit trace (T-0613)\n'
printf -- '---------------------------------------------------------------------------------------------------------\n'

site_not_read() { # <reason>
  local f
  for f in $SITE_FIGURES; do
    UNREAD=$((UNREAD + 1))
    printf '  %sNOT READ%s  %-22s %s\n' "$C_BAD" "$C_OFF" "$f" "$1"
  done
  printf '\n  An absence of information is not good news here either: the whole point of the row this\n'
  printf '  block closes is that a green run used to say nothing at all about this figure.\n'
}

if [ "$ONLINE" -ne 1 ]; then
  site_not_read 'not requested. Pass --online to re-read it; the gate deliberately does not.'
elif ! command -v curl >/dev/null 2>&1; then
  site_not_read 'curl is not on PATH, so no trace can be fetched from this shell.'
elif ! command -v python3 >/dev/null 2>&1; then
  site_not_read 'python3 is not on PATH, so the pipeline JSON cannot be parsed.'
else
  S_API="https://git.drupalcode.org/api/v4/projects/project%2F$SITE_PROJECT"
  S_RAW="https://git.drupalcode.org/project/$SITE_PROJECT/-/jobs"
  S_PJ=$(curl -sSL --max-time 40 "$S_API/pipelines?ref=1.x&per_page=20" 2>/dev/null)
  if [ -z "$S_PJ" ]; then
    site_not_read "the GitLab API returned nothing for $SITE_PROJECT's pipelines. No network, or the host is unreachable from here."
  else
    S_PICK=$(PJ="$S_PJ" python3 -c '
import json, os
# cspell:ignore isinstance
try:
    ps = json.loads(os.environ["PJ"])
except Exception as exc:
    print("ERR the API answered something that is not JSON: %s" % exc); raise SystemExit
if not isinstance(ps, list) or not ps:
    print("ERR the pipelines endpoint returned no list at all, which is a failure and not an empty result."); raise SystemExit
for p in ps:
    if p.get("status") == "success":
        print("PIPE %s %s" % (p.get("id"), (p.get("sha") or "")[:8])); raise SystemExit
print("ERR none of the %d most recent 1.x pipelines is a SUCCESSFUL, terminal one. This block is about what a GREEN run prints, so a red or running pipeline cannot answer it." % len(ps))
' 2>/dev/null)
    if [ -z "$S_PICK" ] || [ "${S_PICK#ERR }" != "$S_PICK" ]; then
      site_not_read "${S_PICK#ERR }"
    else
      S_PIPE=$(printf '%s' "$S_PICK" | sed -nE 's/^PIPE ([0-9]+) .*/\1/p')
      S_SHA=$(printf '%s' "$S_PICK" | sed -nE 's/^PIPE [0-9]+ (.*)/\1/p')
      S_JJ=$(curl -sSL --max-time 40 "$S_API/pipelines/$S_PIPE/jobs?per_page=100" 2>/dev/null)
      S_JOB=$(JJ="$S_JJ" python3 -c '
import json, os
# cspell:ignore isinstance
try:
    js = json.loads(os.environ["JJ"])
except Exception as exc:
    print("ERR the jobs endpoint answered something that is not JSON: %s" % exc); raise SystemExit
if not isinstance(js, list) or not js:
    print("ERR the jobs endpoint returned no job list at all."); raise SystemExit
for j in js:
    if j.get("name") == "phpunit" and j.get("status") == "success":
        print("JOB %s" % j.get("id")); raise SystemExit
print("ERR the pipeline has no successful job named exactly phpunit. phpunit-pgsql prints the same line and is deliberately not accepted here: the claim is about the job the criterion names.")
' 2>/dev/null)
      if [ -z "$S_JOB" ] || [ "${S_JOB#ERR }" != "$S_JOB" ]; then
        site_not_read "${S_JOB#ERR } (pipeline $S_PIPE)"
      else
        S_ID=$(printf '%s\n' "$S_JOB" | sed -n 's/^JOB //p')
        printf '  %s' "$C_DIM"
        printf 'read from %s pipeline %s, commit %s: phpunit job %s%s\n' \
          "$SITE_PROJECT" "$S_PIPE" "$S_SHA" "$S_ID" "$C_OFF"
        # -L is MANDATORY: without it the 302 body looks exactly like a failed read.
        S_T=$(curl -sSL --max-time 60 "$S_RAW/$S_ID/raw" 2>/dev/null | tr -d '\r')
        S_BYTES=$(printf '%s' "$S_T" | wc -c | tr -d '[:space:]')
        if [ "${S_BYTES:-0}" -lt 2000 ]; then
          site_not_read "job $S_ID returned $S_BYTES bytes, which is a redirect or an error, not a log."
        else
          S_LINE=$(printf '%s\n' "$S_T" \
            | grep -oE 'agora_transparency axe gate: [0-9]+ of [0-9]+ declared pages scanned, [0-9]+-[0-9]+ axe rules run per page, [0-9]+ violations' \
            | sort -u)
          _n=$(printf '%s\n' "$S_LINE" | grep -v '^$' | wc -l | tr -d '[:space:]')
          if [ "${_n:-0}" -ne 1 ]; then
            site_not_read "the trace printed $_n axe summary lines, expected 1. Zero means the summary did not reach a GREEN log, which is exactly the defect T-0613 closed and is a finding about the gate rather than about this script."
          else
            compare 'site_axe_pages_log' "$A_PAGES" \
              "$(printf '%s' "$S_LINE" | sed -nE 's/.*gate: ([0-9]+) of .*/\1/p')" \
              "phpunit job $S_ID"
            compare 'site_axe_violations_log' '0' \
              "$(printf '%s' "$S_LINE" | sed -nE 's/.*page, ([0-9]+) violations.*/\1/p')" \
              "phpunit job $S_ID"
          fi
        fi
      fi
    fi
  fi
fi

# ======================================================================= NOT CHECKED ==
# Named with a reason that is TRUE, and the length of this list is asserted non-empty below.
NOT_CHECKED=(
"The two absolute cspell denominators - files offered and files checked. They come from tests/bin/spellcheck's own filter, which needs the three inputs it fetches from the CI job's own configuration, so no offline read here can produce them. The script prints both on every run, and the SUBTRACTION between them is compared above."
"The template's own axe result, OFFLINE. It is now printed by AccessibilityTest::tearDownAfterClass() and reaches the phpunit job's trace on a GREEN run (T-0613), so it is read and compared - but only under --online, which the gate never passes. The entry stays because the replacement is narrower and still true: no offline read here can produce the number of pages actually SCANNED, the rules axe ran or the violations found. What IS offline is the DECLARED count, compared above against both the package and the constant the test asserts."
"The 78 steps, 58 non-core modules and 'Tests: 3, Assertions: 38' of the 2026-08-23 clean install. README marks them as predating the theme swap and says a dated measurement is replaced only by another measurement. A guard that refreshed them would destroy the record they exist to be."
"Historical and superseded figures throughout the packaged prose: every figure a packaged file attributes to an earlier state of the package rather than to its current one - a sentence saying what it read until a date, every struck value. The category is named rather than sampled, because a sample has to be refreshed whenever such a sentence is added or removed, and this entry's sample had gone stale in both directions: by 2026-09-24 the thirteen-entry packaging count and the axe page progression it named were in no packaged file, while 'read until' sentences it did not name were. Same reason: these are frozen records of past measurements, and rule 8 keeps them."
"AGENTS.md and LICENSE.txt, both packaged and both outside the declared subject set. LICENSE.txt is the verbatim GPL-2.0 text and carries no figure about this package. AGENTS.md is product prose with claims of its own and is READABLE AND DELIBERATELY NOT BOUND in this pass - a weaker reason than the ones above, and written as one."
"The legal notice and the privacy notice, content/node/*.yml alongside the accessibility statement. Packaged, user-facing, and readable; they carry no figure about the package today. READABLE AND DELIBERATELY NOT BOUND, and the entry exists so the next figure written into one of them is a decision rather than an oversight."
"Whether a figure stated in DIFFERENT WORDS somewhere in the packaged set is the same figure. Every comparison above binds ONE canonical sentence by a tight pattern, and the one-copy rule covers a REGISTERED set of detectors rather than every number in the packaged files. The change this script arrived with deleted the restatements it found rather than trying to match them all, so this entry is about the NEXT one somebody writes."
"The WCAG criterion identifiers - 2.4.7, 2.5.8, 1.4.10, 2.4.1 - which appear in both README.md and the statement. They are names, not measurements: two documents naming the same criterion are not two copies of a figure, and binding them would be binding a citation. READABLE AND DELIBERATELY NOT BOUND."
"The declared licence of each of the projects in composer.json require. LICENCE-MANIFEST.md states that all of them are GPL-2.0-or-later on the strength of Drupal.org's hosting condition, and says so in its own words; nothing here re-derives it from packages.drupal.org. The COUNT of them is compared above, and tests/bin/sbom-check reads each project's release status and security coverage - neither is the licence. Closing it is an HTTP request per project in the --online block and it has no owner yet."
"Gin, Coffee and Navigation - the three components the scoping sentence of the accessibility statement names beside the dashboard. All three are installed by drupal_cms_admin_ui, a DEPENDENCY's recipe, and this package DECLARES none of them - none is in composer.json's require and none in recipe.yml's install: list - so no offline read here can show that an install still receives them; the one component this package installs itself is compared above. Until 2026-09-23 this entry said none of the three 'is named anywhere in this tree', which was loose before and false after, because NAMED IS NOT DECLARED: recipe.yml names navigation's components in the Canvas actions that disable them, and AccessibilityTest names gin and coffee as the owners of violations it declares on the Config Guardian dashboard, so a green phpunit run shows both rendering on that page - an observation made at runtime in CI, not a declaration anything offline can read. The navigation module appears in no assertion at all. They were verified at source for T-0614 by reading that recipe on git.drupalcode.org - coffee at its line 7, gin at line 16, navigation at line 21, and admin: gin at line 107, which is the line that makes Gin the administration theme rather than merely an installed one. The file is byte-identical at tags 2.1.4 and 2.1.5 and at the 2.1.x tip, so the citation holds at every version the ^2 constraint can resolve to today; it will not hold forever, and a dependency that dropped one of the three would leave the sentence naming a component that is no longer installed."
"What the dashboard paragraph of the accessibility statement says about ANOTHER project's source rather than about the test: that the failing text takes BOTH its colour and its background from Config Guardian itself. Verified at source on 2026-09-23 against config_guardian 1.0.3, the release a clean install resolves - css/config-guardian.css sets --cg-bg at line 14 and --cg-text-muted at line 17, and .cg-table th (lines 630-639) and .cg-comparison-header h4 small (lines 243-247, on a header whose background is --cg-bg at line 231) draw one on the other - and the unreleased 1.0.4 tag carries a byte-identical stylesheet. Nothing offline here can read a dependency's stylesheet, and a release that moved either token would leave the clause wrong while admin_contrast_owner still passed on the owner alone; that comparison binds WHO, not WHY."
"screenshot.webp's pixel dimensions and logo.png's, quoted in the manifest headings. Reading them needs a WebP and PNG header parser; the BYTE SIZE and the SHA-256 of both are compared above, and a file whose digest matches has not changed its dimensions either."
"The two figures content/MEDIA-LICENCES.md states about haven - 21 Unsplash-named JPEGs, 77426040 bytes, at release 1.0.3. They are facts about ANOTHER project at a version that will move, and nothing offline can produce them; re-deriving them would be one 78 MB download per run, which is not a gate's business. The page quotes the one-second command that produces both and says in its own words that nothing here keeps them true. It said 22 for twenty-six days, in two places, and 22 is reproducible at no release haven has cut - which is what an unbound third-party figure looks like when it goes wrong."
"The measurement LICENCE-MANIFEST.md quotes about the two published site templates - haven 1.0.3 ships 0 of 748 files matching any licence manifest, byte 1.0.3 ships 0 of 651 - taken on 2026-09-21 from each release archive. They are facts about OTHER projects' releases and nothing offline can produce them; re-deriving them means downloading both release archives on every run, which is not a gate's business. The page says in its own words that no command on it re-derives them. The 748 was stated in two packaged files until 2026-09-24 - content/MEDIA-LICENCES.md carried a second copy - and that copy was deleted rather than bound, so the figure has one packaged home, dated and attributed to the release it was measured on."
"The window size the target-size check runs at, and how many targets it measured and left incomplete. AccessibilityTest prints all three on every green run - 1024x768, 557 targets over the nine public pages and 0 incomplete on the rig run that landed T-0634 - and the packaged prose quotes none of them, on purpose: the statement says only that the measurement is taken at a single window size and that targets axe cannot decide are left to a person. 'Single' rests on the browser never being resized mid-run, which nothing asserts; the summary line would print two sizes if it were. READABLE UNDER --online AND DELIBERATELY NOT BOUND."
"The route SECURITY.md gives: the project page it links, the name of the sidebar link on that page, and what the link opens - a new work item on git.drupalcode.org with confidentiality switched on, behind a Drupal.org sign-in. Verified at source on 2026-09-25: the page answered HTTP 200 and carried the link with issue[confidential]=true pre-set, and the new-item address answered with a redirect to sign-in. They are facts about Drupal.org's pages, which can change without a commit here. READABLE OVER THE NETWORK AND DELIBERATELY NOT BOUND in this pass."
"The coverage sentence in SECURITY.md - that stable releases are covered by Drupal's security advisory policy. It rests on the project's opt-in, which is a setting on Drupal.org and not a file in this package: its API reported field_security_advisory_coverage = covered on 2026-09-25, unchanged since 2026-09-24 15:14 UTC, and the project page says the same in its sidebar. Withdrawing the opt-in needs no commit here, and would leave the sentence false in every package that carries it. READABLE OVER THE NETWORK AND DELIBERATELY NOT BOUND: reading a Drupal.org field would add a figure to --online, which is a decision of its own."
"The sentence in SECURITY.md that a site template's requirements are copied into the site's own composer.json when Composer adds it to a Drupal CMS site. It describes another project: drupal/cms 2.1.6 requires drupal/core-recipe-unpack ^11.3.10 and allows it as a plugin, read from its project template at that tag on 2026-09-25, and specs/000-project/DECISIONS.md records the flattening as measured in a rig. A later Drupal CMS could drop the plugin or switch it off, and nothing offline here would see it."
"What ACCESSIBILITY.md says beyond the one-copy rule. It states no figure this script registers, by design, and every one-copy detector above runs over it. Its account of the keyboard walkthrough - the dates, the two builds, what the machine found and what the person confirmed - is a record of two dated events whose evidence lives in specs/, which is not packaged; and its sentences about Gin, coffee, the consent banner and the sign-in page describe other projects' behaviour on the sites that were walked. READABLE AND DELIBERATELY NOT BOUND."
)

printf '\nNOT CHECKED - named, with a reason, because a guard that silently covers half its subject\n'
printf 'reads exactly like one that covers all of it\n'
printf -- '---------------------------------------------------------------------------------------------------------\n'
for _e in "${NOT_CHECKED[@]}"; do
  printf '  %s*%s %s\n' "$C_DIM" "$C_OFF" "$_e"
done

# ============================================================================ SUMMARY ==
NC=${#NOT_CHECKED[@]}
printf '\n=========================================================================================================\n'
printf 'files opened:     %d\n' "$FILES_OPENED"
printf 'claims extracted: %d\n' "$CLAIMS"
printf 'comparisons:      %d\n' "$COMPARISONS"
printf 'one-copy checks:  %d\n' "$ONE_COPY"
printf 'not checked:      %d\n' "$NC"
printf 'online unread:    %d\n' "$UNREAD"
printf 'findings:         %d\n' "$FINDINGS"
printf 'sha256 via:       %s\n' "${SHA_IMPL:-none available}"
printf '=========================================================================================================\n'

RC=0
if [ "$FILES_OPENED" -eq 0 ]; then
  printf '%sFAIL:%s no packaged file was opened. A run that read nothing found nothing.\n' "$C_BAD" "$C_OFF"
  RC=1
fi
if [ "$CLAIMS" -eq 0 ]; then
  printf '%sFAIL:%s no claim was extracted from the packaged prose at all. An extractor that\n' "$C_BAD" "$C_OFF"
  printf '      matches nothing passes by construction, which is I-028 exactly.\n'
  RC=1
fi
if [ "$COMPARISONS" -eq 0 ]; then
  printf '%sFAIL:%s no comparison was made. Zero comparisons and zero findings is the degenerate\n' "$C_BAD" "$C_OFF"
  printf '      agreement I-028 names: it prints exactly like a clean file.\n'
  RC=1
fi
if [ "$ONE_COPY" -eq 0 ]; then
  printf '%sFAIL:%s the one-copy register is empty, so no figure had its home verified. An empty\n' "$C_BAD" "$C_OFF"
  printf '      register refuses nothing and reports it as agreement.\n'
  RC=1
fi
if [ "$NC" -eq 0 ]; then
  printf '%sFAIL:%s the NOT CHECKED list is empty. An empty exclusion list passes by construction,\n' "$C_BAD" "$C_OFF"
  printf '      and it is the shape somebody deletes an entry into rather than answering it.\n'
  RC=1
fi
if [ "$FINDINGS" -ne 0 ]; then
  printf '%sFAIL:%s %d figure(s) in the packaged prose disagree with the thing they are about.\n' "$C_BAD" "$C_OFF" "$FINDINGS"
  printf '      Each line above names the claim, the claimed value and the measured one. Fix the\n'
  printf '      PROSE if the measurement is right; fix the PACKAGE if the prose was the promise.\n'
  RC=1
fi
if [ "$ONLINE" -eq 1 ] && [ "$UNREAD" -ne 0 ]; then
  printf '%sFAIL:%s --online was requested and %d figure(s) could not be read.\n' "$C_BAD" "$C_OFF" "$UNREAD"
  printf '      This exits non-zero ON PURPOSE. A request to verify something, answered with\n'
  printf '      silence, must not leave behind an exit code that means "verified".\n'
  RC=1
fi
[ "$RC" -eq 0 ] && printf '%s%s%s\n' "$C_OK" 'packaged-claims: clean' "$C_OFF"
exit "$RC"
