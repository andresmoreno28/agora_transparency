# -- the two gate runners, quoted in the macOS certification steps --------------------------
gate_claim_field() { # <runner> <field>
  local line rc n
  line=$(grep -E '^#[[:space:]]*GATE-CLAIM:' "$1")
  rc=$?
  [ "$rc" -ge 2 ] && grep_fatal "$rc" "$1"
  [ "$rc" -eq 0 ] || fatal "$1 carries no GATE-CLAIM line, so the figure README states about it has nothing to be compared against."
  n=$(printf '%s\n' "$line" | wc -l | tr -d '[:space:]')
  [ "${n:-0}" -eq 1 ] || fatal "$1 carries $n GATE-CLAIM lines, expected exactly 1."
  printf '%s' "$line" | sed -nE "s/.*$2=([0-9]+).*/\1/p"
}
[ -r "$RUNNER1" ] || fatal "$RUNNER1 is not readable; the check total README quotes has no source."
[ -r "$RUNNER3" ] || fatal "$RUNNER3 is not readable; the check total README quotes has no source."

claim_once 'runner totals' README \
  "\\*\\*[0-9]+ checks $DASH 0 failures\\*\\* and \\*\\*[0-9]+ checks $DASH 0 failures\\*\\*"
# The `^` is load-bearing and was put there by getting it wrong: sed's `.*` is greedy, so
# `.*\*\*([0-9]+) checks` reads the SECOND figure in this sentence and silently compares the
# wave-3 number against the wave-1 runner. It printed OK for the wrong reason on the first run.
compare 'wave1_checks' "$(field 1 '^\*\*([0-9]+) checks.*')" "$(gate_claim_field "$RUNNER1" checks)" \
  "$RUNNER1 GATE-CLAIM"
compare 'wave3_checks' "$(field 1 '.*and \*\*([0-9]+) checks.*')" "$(gate_claim_field "$RUNNER3" checks)" \
  "$RUNNER3 GATE-CLAIM"

# -- the recipes README tabulates, against the list recipe.yml applies -----------------------
# The rows are taken from the table that FOLLOWS the recipes anchor, not from every table row in
# the file that happens to look like one. Found by falsifying: a bare row pattern also collected
# `grep` and `sed` out of the toolchain-floor table twenty screens further down, and reported a
# twelve-recipe README. Collection stops at the first non-table line after at least one row, so a
# later table can never be absorbed into this one.
README_RECIPES=$(text_of README | awk '
  /^Recipes, in the order/ { seen = 1; next }
  seen && /^\| `/ { line = $0; sub(/^\| `/, "", line); sub(/`.*$/, "", line); print line; rows = 1; next }
  seen && /^\|/ { next }
  seen && rows && !/^\|/ { exit }
' | LC_ALL=C sort -u)
RECIPE_RECIPES=$(text_of RECIPE | awk '
  /^recipes:[[:space:]]*$/ { in_list = 1; next }
  in_list && /^[[:space:]]*- / { sub(/^[[:space:]]*- /, ""); sub(/[[:space:]]*#.*$/, ""); print; next }
  in_list && /^[^[:space:]#]/ { in_list = 0 }
' | LC_ALL=C sort -u)
R_REC_N=$(printf '%s\n' "$README_RECIPES" | grep -v '^$' | wc -l | tr -d '[:space:]')
Y_REC_N=$(printf '%s\n' "$RECIPE_RECIPES" | grep -v '^$' | wc -l | tr -d '[:space:]')
if [ "${R_REC_N:-0}" -eq 0 ] || [ "${Y_REC_N:-0}" -eq 0 ]; then
  fatal "one of the two recipe lists came back EMPTY (README $R_REC_N, recipe.yml $Y_REC_N). Two empty lists compare equal, which is the degenerate agreement I-028 names, so this is refused before the comparison rather than after it."
fi
COMPARISONS=$((COMPARISONS + 1))
if [ "$README_RECIPES" = "$RECIPE_RECIPES" ]; then
  printf '  %s%-20s%s [%s recipes]  =  recipe.yml [%s recipes]  %sOK%s\n' \
    "$C_DIM" 'recipes_applied' "$C_OFF" "$R_REC_N" "$Y_REC_N" "$C_OK" "$C_OFF"
else
  FINDINGS=$((FINDINGS + 1))
  printf '  %s%-20s README [%s]  !=  recipe.yml [%s]  MISMATCH%s\n' \
    "$C_BAD" 'recipes_applied' "$R_REC_N" "$Y_REC_N" "$C_OFF"
  printf '      only in README:     %s\n' "$(comm -23 <(printf '%s\n' "$README_RECIPES") <(printf '%s\n' "$RECIPE_RECIPES") | tr '\n' ' ')"
  printf '      only in recipe.yml: %s\n' "$(comm -13 <(printf '%s\n' "$README_RECIPES") <(printf '%s\n' "$RECIPE_RECIPES") | tr '\n' ' ')"
fi

# -- the CI job table -----------------------------------------------------------------------
[ -r "$WATCH" ] || fatal "$WATCH is not readable; the job table README prints has nothing to be compared against."
README_JOBS=$(text_of README \
  | sed -nE 's/^\| `([A-Za-z -]+)` \| [a-z]+ \| [a-z]+ \| (true|false) \|$/\1/p' | LC_ALL=C sort)
WG_JOBS=$(sed -n "/^EXPECTED_agora_transparency='/,/'\$/p" "$WATCH" \
  | sed "s/^EXPECTED_agora_transparency='//; s/'\$//" | LC_ALL=C sort)
R_JOB_N=$(printf '%s\n' "$README_JOBS" | grep -v '^$' | wc -l | tr -d '[:space:]')
W_JOB_N=$(printf '%s\n' "$WG_JOBS" | grep -v '^$' | wc -l | tr -d '[:space:]')
if [ "${R_JOB_N:-0}" -eq 0 ] || [ "${W_JOB_N:-0}" -eq 0 ]; then
  fatal "one of the two job lists came back EMPTY (README $R_JOB_N, watch-gate $W_JOB_N). Two empty lists compare equal, which is the degenerate agreement I-028 names."
fi
COMPARISONS=$((COMPARISONS + 1))
if [ "$README_JOBS" = "$WG_JOBS" ]; then
  printf '  %s%-20s%s [%s jobs]  =  watch-gate [%s jobs]  %sOK%s\n' \
    "$C_DIM" 'job_names' "$C_OFF" "$R_JOB_N" "$W_JOB_N" "$C_OK" "$C_OFF"
else
  FINDINGS=$((FINDINGS + 1))
  printf '  %s%-20s README [%s jobs]  !=  watch-gate [%s jobs]  MISMATCH%s\n' \
    "$C_BAD" 'job_names' "$R_JOB_N" "$W_JOB_N" "$C_OFF"
  printf '      only in README:     %s\n' "$(comm -23 <(printf '%s\n' "$README_JOBS") <(printf '%s\n' "$WG_JOBS") | tr '\n' ' ')"
  printf '      only in watch-gate: %s\n' "$(comm -13 <(printf '%s\n' "$README_JOBS") <(printf '%s\n' "$WG_JOBS") | tr '\n' ' ')"
fi

claim_once 'jobs total' README "\\*\\*[A-Za-z]+ jobs $DASH all blocking"
compare 'jobs_total' "$(to_num "$(field 1 '.*\*\*([A-Za-z]+) jobs.*')")" "$R_JOB_N" 'README job table rows'

# -- the spell-check accounting, checked as arithmetic rather than as a denominator ----------
# The two absolute figures come from tests/bin/spellcheck's own filter and need its fetched
# inputs, so they are named in NOT CHECKED. What IS checkable here is that the section's own
# subtraction holds, and that the 37 it attributes to binaries is the number of binaries cspell
# cannot open.
claim_once 'cspell totals' README '\*\*[0-9]+ tracked or stage-able files offered to cspell, [0-9]+ checked'
S_OFFERED=$(field 1 '.*\*\*([0-9]+) tracked.*')
S_CHECKED=$(field 1 '.*cspell, ([0-9]+) checked.*')
claim_once 'cspell split' README '[0-9]+ \+ [0-9]+ = [0-9]+, and the list was derived'
S_BIN=$(field 1 '([0-9]+) \+ [0-9]+ = [0-9]+.*')
S_GLOB=$(field 1 '[0-9]+ \+ ([0-9]+) = [0-9]+.*')
S_SUM=$(field 1 '[0-9]+ \+ [0-9]+ = ([0-9]+).*')
if [ -n "$S_OFFERED" ] && [ -n "$S_CHECKED" ]; then
  compare 'cspell_gap' "$S_SUM" "$((S_OFFERED - S_CHECKED))" 'offered minus checked, in README itself'
else
  compare 'cspell_gap' "$S_SUM" '' 'offered minus checked, in README itself'
fi
if [ -n "$S_BIN" ] && [ -n "$S_GLOB" ]; then
  compare 'cspell_split' "$S_SUM" "$((S_BIN + S_GLOB))" 'README binaries + globbed'
else
  compare 'cspell_split' "$S_SUM" '' 'README binaries + globbed'
fi
# Binaries cspell cannot open: every file under content/file/ that is not a *.yml entity export
# and not one of the CSVs it reads happily, plus the two binaries at the package root.
CONTENT_BIN=$(git ls-files 'content/file/*' 2>/dev/null | grep -vE '\.(yml|csv)$' | wc -l | tr -d '[:space:]')
ROOT_BIN=$(git ls-files 'logo.png' 'screenshot.webp' 2>/dev/null | wc -l | tr -d '[:space:]')
compare 'cspell_binaries' "$S_BIN" "$((CONTENT_BIN + ROOT_BIN))" 'unreadable binaries in the tracked set'

# ========================================== content/MEDIA-LICENCES.md vs the media it lists ==
printf '\ncontent/MEDIA-LICENCES.md - the licence manifest against the files it is about\n'
printf -- '---------------------------------------------------------------------------------------------------------\n'

MANIFEST_ROWS=$(text_of MANIFEST | grep -E '^\| [A-Za-z0-9_./-]+ \| .* \| .* \| .* \| .* \| [0-9]{4}-[0-9]{2}-[0-9]{2} \|$' \
  | wc -l | tr -d '[:space:]')
[ "${MANIFEST_ROWS:-0}" -gt 0 ] || fatal "the manifest table in $MANIFEST yielded 0 data rows. A table read as empty compares equal to an empty claim, which is the degenerate agreement I-028 names."
MANIFEST_GEN=$(text_of MANIFEST | grep -E '^\| [A-Za-z0-9_./-]+ \|.*\| generated by tests/bin/generate-demo-media\.py \|' \
  | wc -l | tr -d '[:space:]')

claim_once 'manifest rows' MANIFEST '\*\*[A-Za-z-]+ of the [a-z-]+ rows\*\* point at'
compare 'manifest_generated' "$(to_num "$(field 1 '.*\*\*([A-Za-z-]+) of the.*')")" \
  "$MANIFEST_GEN" 'rows naming generate-demo-media.py'
compare 'manifest_rows' "$(to_num "$(field 1 '.*of the ([a-z-]+) rows\*\*.*')")" \
  "$MANIFEST_ROWS" 'data rows of its own table'

claim_once 'pdf count' MANIFEST 'The [a-z-]+ PDFs are \*\*derived\*\*'
compare 'pdf_count' "$(to_num "$(field 1 'The ([a-z-]+) PDFs.*')")" \
  "$(count_tracked 'content/file/*.pdf')" 'git ls-files content/file/*.pdf'

claim_once 'csv count' MANIFEST 'The [a-z-]+ CSVs are \*\*not\*\* derivable'
compare 'csv_count' "$(to_num "$(field 1 'The ([a-z-]+) CSVs.*')")" \
  "$(count_tracked 'content/file/*.csv')" 'git ls-files content/file/*.csv'

claim_once 'logo file' MANIFEST \
  "### \`logo\\.png\` $DASH 512x512, [0-9,]+ bytes, sha256 \`[0-9a-f]{64}\`"
compare 'logo_bytes' "$(field 1 '.*, ([0-9,]+) bytes.*' | tr -d ',')" "$(blob_size logo.png)" \
  'git cat-file -s HEAD:logo.png'
compare 'logo_sha' "$(field 1 '.*sha256 .([0-9a-f]{64}).*')" "$(blob_sha logo.png)" \
  "${SHA_IMPL:-no sha256 implementation} of the committed blob"

claim_once 'screenshot file' MANIFEST \
  "### \`screenshot\\.webp\` $DASH 500x400, [0-9,]+ bytes, sha256 \`[0-9a-f]{64}\`"
compare 'shot_bytes' "$(field 1 '.*, ([0-9,]+) bytes.*' | tr -d ',')" "$(blob_size screenshot.webp)" \
  'git cat-file -s HEAD:screenshot.webp'
compare 'shot_sha' "$(field 1 '.*sha256 .([0-9a-f]{64}).*')" "$(blob_sha screenshot.webp)" \
  "${SHA_IMPL:-no sha256 implementation} of the committed blob"

# ========================== the shipped accessibility statement vs the gate it describes ==
printf '\nthe accessibility statement (/accessibility-statement) - against the gate it describes\n'
printf -- '---------------------------------------------------------------------------------------------------------\n'

[ -r "$A11Y_TEST" ] || fatal "$A11Y_TEST is not readable; the page count the statement gives has nothing to be compared against."

claim_once 'a11y scope' STATEMENT 'axe-core runs over [a-z]+ pages of the site as it is installed: the [a-z]+ composed landing pages'
A_PAGES=$(to_num "$(field 1 '.*over ([a-z]+) pages.*')")
A_CANVAS=$(to_num "$(field 1 '.*the ([a-z]+) composed landing pages.*')")
claim_once 'a11y listings' STATEMENT '[a-z]+ of the [a-z]+ listing routes \(two of the [a-z]+ registers'
A_SCANNED=$(to_num "$(field 1 '([a-z]+) of the [a-z]+ listing.*')")
A_LISTINGS=$(to_num "$(field 1 '[a-z]+ of the ([a-z]+) listing.*')")
A_REGISTERS=$(to_num "$(field 1 '.*two of the ([a-z]+) registers.*')")

CANVAS_N=$(count_tracked 'content/canvas_page/*.yml')
VIEW_N=$(sed -n "/private const VIEW_PAGES = \[/,/\];/p" "$A11Y_TEST" \
  | grep -E "^ +'agora_base_[a-z_]+'," | wc -l | tr -d '[:space:]')
# The three surfaces AccessibilityTest declares individually rather than in a loop: the front
# page, the one published record and the not-found screen. Counted from the PHP rather than
# written here as a 3, so that deleting one moves this figure instead of leaving it asserting a
# total nothing produces.
SINGLE_N=$(grep -E "^ +'name' => '(front|not-found|node:)" "$A11Y_TEST" | wc -l | tr -d '[:space:]')
[ "${VIEW_N:-0}" -gt 0 ] || fatal "VIEW_PAGES in $A11Y_TEST yielded 0 entries. The scanned-route figure would then be compared against a total assembled from nothing."
[ "${SINGLE_N:-0}" -gt 0 ] || fatal "no single-surface page declarations found in $A11Y_TEST. The page total would be short by the front page, the record and the 404, and would still be a number."

compare 'canvas_pages' "$A_CANVAS" "$CANVAS_N" 'git ls-files content/canvas_page/*.yml'
compare 'listing_scanned' "$A_SCANNED" "$VIEW_N" "VIEW_PAGES in $A11Y_TEST"
compare 'a11y_pages' "$A_PAGES" "$((CANVAS_N + VIEW_N + SINGLE_N))" \
  'the pages AccessibilityTest declares'

# T-0612. THE THIRD SIDE OF THE SAME NUMBER, and it is source against source rather than prose
# against source - the only comparison here that is.
#
# The line above binds the shipped STATEMENT to what the package contains. It says nothing at all
# about what the gate ASSERTS, and until today the gate asserted a floor of six against a package
# that supplies nine, so a Canvas page could have stopped shipping, the run would have scanned
# eight, every per-page assertion would have held, and the statement would have gone on saying
# nine. The floor is now an equality against a named constant, and this reads that constant out of
# the PHP and compares it against the same five terms the line above sums.
#
# WHY IT IS HERE AND NOT ONLY IN THE TEST. The test can only fail where a rig exists - a Selenium
# browser, a built Drupal, thirteen minutes. This comparison is offline, costs nothing, and fails
# on the commit that moves one of the two without the other, which is hours earlier and much
# cheaper. The two are not redundant: this one cannot see the pages that were actually SCANNED,
# and the test cannot be run by somebody reading the repository.
A11Y_CONST=$(sed -nE 's/^ +private const DECLARED_PAGES = ([0-9]+);.*/\1/p' "$A11Y_TEST" \
  | head -1)
[ -n "$A11Y_CONST" ] || fatal "no \`private const DECLARED_PAGES = <n>;\` line in $A11Y_TEST. The page floor was made an equality against a named constant by T-0612; if the constant was renamed this pattern moves with it in the same commit, and if it was turned back into a literal the gate has lost the only assertion that fails when a surface stops shipping."
compare 'a11y_declared_const' "$A11Y_CONST" "$((CANVAS_N + VIEW_N + SINGLE_N))" \
  "DECLARED_PAGES in $A11Y_TEST vs the pages it derives"

compare 'listing_total' "$A_LISTINGS" "$(count_tracked 'config/views.view.agora_base_*.yml')" \
  'git ls-files config/views.view.agora_base_*.yml'
# The second of the two bound copies of the register count - README carries the other, and both
# are read against the same measured source, which is what makes the duplicate safe.
compare 'registers_stated' "$A_REGISTERS" "$REGISTER_BUNDLES" 'distinct agora_base_* node bundles'

# ============================ T-0614: the scoping sentence, and the half of it that binds ==
# The shipped statement excluded the administrative interface by saying it "is Drupal core"
# until 2026-09-21. It is not. An Agora install's admin interface is the Gin THEME, core
# `navigation` and contrib `coffee` - all three installed by the `drupal_cms_admin_ui` recipe
# this package applies at recipe.yml:68 - plus the Config Guardian dashboard this package
# installs itself at recipe.yml:196 and configures through its own
# config/config_guardian.settings.yml. (recipe.yml:711-727 is a COMMENT explaining why those
# settings are NOT a config action, which is a different thing from being the configuration.)
# These three line numbers read 64, 190 and 705-721 until 2026-09-23 - true when written, moved
# by a3695ff - and were re-derived by grep, not by adding the offset.
#
# THE FIRST CLAIM IS AN EXTRACTION AND NOT A COMPARISON, and it is the one that matters most:
# reword the sentence back and claim_once FATALs in the same commit, naming the pattern. A
# correction nothing holds in place is a correction with a half-life - and this file's own
# header records a figure that was false within hours of being written.
claim_once 'admin scope' STATEMENT \
  'The administrative interface is <strong>not</strong> Drupal core\.'

# THE ONE COMPONENT OF THAT SENTENCE THIS REPOSITORY CAN CHECK. Gin, coffee and navigation are
# installed by a DEPENDENCY's recipe and this package DECLARES none of them, so they are named in
# NOT CHECKED below with that as the reason. (This comment said they "appear nowhere in this
# tree" until 2026-09-23. Named is not declared: AccessibilityTest names gin and coffee as the
# owners of violations it declares, and recipe.yml names navigation's components in the Canvas
# actions that disable them.) The dashboard is ours.
#
# The module name is DERIVED FROM THE PROSE rather than typed here. Typing it would make this a
# constant compared against a constant: renaming the project in the shipped text would leave the
# comparison passing about a name the statement no longer uses.
claim_once 'admin dashboard' STATEMENT \
  'the [A-Z][A-Za-z]+ [A-Z][A-Za-z]+ dashboard, which this site template chose, installed and configured'
A_DASH=$(field 1 '.*the ([A-Z][A-Za-z]+ [A-Z][A-Za-z]+) dashboard.*' | tr 'A-Z ' 'a-z_')
RECIPE_INSTALLED=$(text_of RECIPE | sed -n '/^install:/,/^config:/p' \
  | sed -nE 's/^  - ([a-z0-9_]+)$/\1/p')
[ -n "$RECIPE_INSTALLED" ] || fatal "recipe.yml's install: list parsed to no extensions at all. The dashboard the statement names would then be looked for in an empty set, and an absent module would read exactly like a present one."
RECIPE_DASH=''
for _m in $RECIPE_INSTALLED; do
  [ "$_m" = "$A_DASH" ] && RECIPE_DASH="$_m"
done
compare 'admin_dashboard_module' "$A_DASH" "$RECIPE_DASH" \
  'the extension of that name in the install: list of recipe.yml'

# ================ D-061 applied: the dashboard IS checked, and four sentences now say so ==
# THE PARAGRAPH ABOVE WENT FALSE WITHOUT BEING EDITED, and that is the defect this block exists
# to stop repeating. Until 2026-09-23 it ended "None of it is covered by any of the checks
# described below" and "Neither part is measured as this statement is written". Commit d47fd5a
# (T-0615, D-061 option B) made AccessibilityTest scan Config Guardian's dashboard logged in, and
# from that commit on the shipped sentence was true of the prose it sat in and false of the
# package - and nothing here could notice, because nothing here read the test for anything but
# the anonymous page count.
#
# The statement now says four things about that check. Each is a claim about the TEST, so each is
# read out of the test rather than typed here:
#   admin_checked_page     the dashboard the prose names    vs  DASHBOARD_ROUTE, less '.dashboard'
#   admin_checked_role     the role label the prose names   vs  the label of the PACKAGED role
#                                                               whose id is LOGGED_IN_ROLE
#   admin_contrast_owner   the project the prose names for  vs  the owners of every color-contrast
#                          the contrast failures                entry in INSTALLED_MARKUP_VIOLATIONS
#   admin_landmark_owners  the projects it names for        vs  the owners of every region entry
#                          content outside landmarks            in that same declared set
#   admin_checked_only     "no check covers any other page" vs  DECLARED_LOGGED_IN_PAGES
#
# So the test cannot stop scanning the page, scan it as another role, lose the contrast failure
# the prose names - an upstream fix is the realistic way - or gain a second logged-in page,
# without this failing in the same commit. Each of the four sentences is also a claim_once, so
# rewording one back towards "none of it is covered" FATALs here the way 'admin scope' does.
#
# NO NUMERAL IS BOUND, BECAUSE THE PROSE CARRIES NONE, DELIBERATELY. The node, rule and route
# counts are printed by the gate on every green run; they are facts about other projects' markup
# at versions that will move, and they belong in that log rather than on a public body's page.
# The typed '1' below is the reading of a sentence, not a figure in it - the same construction
# as recommended_empty's '0'.
A11Y_SRC=$(tr -d '\r' < "$A11Y_TEST")
A11Y_DECLARED_SET=$(printf '%s\n' "$A11Y_SRC" \
  | sed -n '/private const INSTALLED_MARKUP_VIOLATIONS = \[/,/^  \];/p')
A11Y_DECLARED_N=$(printf '%s\n' "$A11Y_DECLARED_SET" \
  | grep -E "^ +\\['[a-z-]+', '.*', '[a-z0-9_]+'\\],\$" | wc -l | tr -d '[:space:]')
[ "${A11Y_DECLARED_N:-0}" -gt 0 ] || fatal "INSTALLED_MARKUP_VIOLATIONS in $A11Y_TEST yielded 0 entries of the shape ['rule', 'selector', 'owner'], so every owner the statement names would be compared against an empty set. If the constant was renamed or reshaped, this reader moves with it in the same commit."
declared_owners() { # <axe rule id> -> the sorted, distinct owners of that rule's declared entries
  printf '%s\n' "$A11Y_DECLARED_SET" \
    | sed -nE "s/^ +\\['$1', '.*', '([a-z0-9_]+)'\\],\$/\\1/p" | sort -u | tr '\n' ' ' | sed 's/ $//'
}

claim_once 'admin dashboard checked' STATEMENT \
  '<strong>The [A-Z][A-Za-z]+ [A-Z][A-Za-z]+ dashboard is scanned by axe-core on every change</strong>, signed in as a user holding only the [A-Z][a-z]+( [a-z]+)* role, which this site template ships'
A_CHECKED=$(field 1 '.*<strong>The ([A-Z][A-Za-z]+ [A-Z][A-Za-z]+) dashboard is scanned.*' | tr 'A-Z ' 'a-z_')
A_ROLE_LABEL=$(field 1 '.*holding only the ([A-Z][a-z]+( [a-z]+)*) role, which.*')
T_DASH_MODULE=$(printf '%s\n' "$A11Y_SRC" \
  | sed -nE "s/^ +private const DASHBOARD_ROUTE = '([a-z0-9_]+)\\.dashboard';.*/\\1/p" | head -1)
compare 'admin_checked_page' "$A_CHECKED" "$T_DASH_MODULE" \
  "DASHBOARD_ROUTE in $A11Y_TEST, less its .dashboard suffix"
# "A role this site template ships" is the claim, so the role's config is looked for in the
# PACKAGED listing, not merely on disk: an unpackaged role would leave the label unread and the
# comparison with an empty side, which is a finding and never agreement.
T_ROLE_ID=$(printf '%s\n' "$A11Y_SRC" \
  | sed -nE "s/^ +private const LOGGED_IN_ROLE = '([a-z0-9_]+)';.*/\\1/p" | head -1)
T_ROLE_LABEL=''
if [ -n "$T_ROLE_ID" ]; then
  printf '%s\n' "$ARCHIVE_LIST" | grep -qxF -- "config/user.role.$T_ROLE_ID.yml"
  _rc=$?
  case $_rc in
    0) T_ROLE_LABEL=$(tr -d '\r' < "config/user.role.$T_ROLE_ID.yml" \
         | sed -nE "s/^label: '(.*)'\$/\\1/p" | head -1) ;;
    1) : ;;
    *) grep_fatal "$_rc" "the git archive listing while looking for the role $A11Y_TEST logs in as" ;;
  esac
fi
compare 'admin_checked_role' "$A_ROLE_LABEL" "$T_ROLE_LABEL" \
  "the label of the packaged role LOGGED_IN_ROLE names in $A11Y_TEST"

claim_once 'admin contrast finding' STATEMENT \
  '<strong>The scan finds colour contrast failures in markup that [A-Z][A-Za-z]+ [A-Z][A-Za-z]+ itself provides</strong>'
A_CONTRAST=$(field 1 '.*markup that ([A-Z][A-Za-z]+ [A-Z][A-Za-z]+) itself provides.*' | tr 'A-Z ' 'a-z_')
compare 'admin_contrast_owner' "$A_CONTRAST" "$(declared_owners 'color-contrast')" \
  'owners of the color-contrast entries in INSTALLED_MARKUP_VIOLATIONS'

claim_once 'admin landmark finding' STATEMENT \
  'The same scan also finds parts of the [A-Z][a-z]+ and [A-Z][a-z]+ interface on that page placed outside every landmark region'
A_LANDMARK=$(printf '%s\n%s\n' \
  "$(field 1 '.*parts of the ([A-Z][a-z]+) and [A-Z][a-z]+ interface.*')" \
  "$(field 1 '.*parts of the [A-Z][a-z]+ and ([A-Z][a-z]+) interface.*')" \
  | tr 'A-Z' 'a-z' | grep -v '^$' | sort -u | tr '\n' ' ' | sed 's/ $//')
compare 'admin_landmark_owners' "$A_LANDMARK" "$(declared_owners 'region')" \
  'owners of the region entries in INSTALLED_MARKUP_VIOLATIONS'

claim_once 'admin only page' STATEMENT \
  '<strong>No accessibility check covers any other page of the administrative interface</strong>'
T_LOGGED_IN_PAGES=$(printf '%s\n' "$A11Y_SRC" \
  | sed -nE 's/^ +private const DECLARED_LOGGED_IN_PAGES = ([0-9]+);.*/\1/p' | head -1)
compare 'admin_checked_only' '1' "$T_LOGGED_IN_PAGES" \
  "DECLARED_LOGGED_IN_PAGES in $A11Y_TEST"

