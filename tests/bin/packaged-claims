#!/usr/bin/env bash
#
# packaged-claims - Agora - fails when a number the PACKAGED, USER-FACING prose of this site
# template states disagrees with the thing the number is about, and fails when the same figure is
# stated in two packaged files at once.
#
# WHAT "PACKAGED" MEANS HERE, because it is the whole scope and it is not a matter of taste.
# `git archive` applies the `export-ignore` rules in .gitattributes, and that is exactly what
# Drupal.org's packaging and a Composer release apply. A file this guard reads must be in that
# archive, and every declared subject is checked to be, so that `export-ignore`ing README.md one
# day cannot leave this script quietly guarding a file no end user receives. `CLAUDE.md`,
# `specs/` and `tests/` are NOT packaged - their prose is tests/bin/claims-match-sources' subject,
# not this one's. The two guards have deliberately disjoint subjects and overlapping technique.
#
# WHY IT EXISTS, and it is a measurement rather than a worry. The packaged prose of this package
# was audited against disk on 2026-09-21 and SIX figures were wrong at once, in three files. Five
# of them are bound by a comparison below and each was watched firing on its own old value; the
# sixth is named in NOT CHECKED, because nothing offline can produce it:
#
#   * README.md said the package ships "131 config objects". It ships 133.        [config_objects]
#   * README.md quoted the two gate runners as "67 checks" and "49 checks". Their
#     own GATE-CLAIM lines read 71 and 66 that morning - one four checks stale,
#     the other seventeen.                                      [wave1_checks, wave3_checks]
#   * content/MEDIA-LICENCES.md said "Thirty-nine of the forty rows" in a file
#     whose table had held 42 rows since the amendment two paragraphs above it
#     added the two files at the package root.                              [manifest_rows]
#   * README.md opened its packaging section with "thirteen top-level entries"
#     and corrected itself to eleven four paragraphs later - a reader who stops
#     at the first sentence is told a number that was false when they read it.
#                                                                       [top_level_entries]
#   * README.md gave the spell-check denominators as "451 ... 410". They were
#     467 and 426. NOT BOUND: both come from tests/bin/spellcheck's own filter,
#     which needs inputs it fetches from the CI job's configuration. What IS
#     compared here is the SUBTRACTION between them, which the same paragraph
#     states as 37 + 4 = 41.                                     [cspell_gap, cspell_split]
#
# And the case this guard's cross-file rule is shaped around is not hypothetical either. From
# 2026-09-20 17:56 until the following morning README.md stated the THEME's axe gate as "nine
# fixture pages ... 9 of 9". It was written in the commit whose own subject was that this package
# contradicted itself about accessibility; the theme took that gate from nine pages to ten the
# same evening; and nothing in either repository could see it, because the figure lived in one
# file here and in another file there. It was removed by hand. The rule below is what makes
# removing it by hand unnecessary next time.
#
# -----------------------------------------------------------------------------------------------
# THE ONE-COPY RULE (T-0609) IS THE PART THAT IS NOT IN THE SIBLING GUARD.
#
# tests/bin/claims-match-readme in `agora_theme` refuses a figure stated twice IN ONE FILE. That
# is necessary and it is not sufficient here, because this package's prose is spread over
# several files that no reader opens together. So every registered figure declares a HOME, and
# the detector for it is run over ALL the packaged files:
#
#   home is a packaged file  ->  exactly that one file may state the figure
#   home is EXTERNAL         ->  NO packaged file may state it; it belongs to another project's
#                                public job log, and a copy here is a copy that goes stale
#
# A detector matching two files is FATAL and names both, in the wording claims-match-sources.py's
# one() helper already uses: the same number written in more than one place is the drift this
# guard exists to refuse.
#
# THERE IS A THIRD OPTION BESIDE "DELETE IT" AND "REFRESH BOTH", and it is used twice below.
# Where a duplicate cannot be removed without costing a reader something - `recipe.yml` and
# `composer.json` must each carry the package description, and the installer and Packagist read
# different ones - the second copy is BOUND to the first, so a machine compares them. Binding is
# for duplicates that have to exist. Deleting is for the rest, and it is the default.
#
# -----------------------------------------------------------------------------------------------
# WHAT IS CHECKED OFFLINE - the comparisons are counted and printed; the list below is what they
# are about, grouped by the file whose claim is being read:
#
#   README.md
#     content_files      the corpus size          vs  git ls-files content/
#     config_objects     the config object count  vs  git ls-files config/*.yml
#     demo_records       the record count         vs  git ls-files content/node/*.yml
#     registers          the register count       vs  the distinct agora_base_* node bundles
#     theme_constraint   the theme version range  vs  composer.json's own require entry
#     front_blocks       the home page's blocks   vs  the views_block components in that page
#     top_level_entries  the packaged root        vs  git archive | tar -t, first path segment
#     archive_entries    the packaged file count  vs  git archive | tar -t
#     wave1_checks       the wave-1 runner total  vs  its GATE-CLAIM line
#     wave3_checks       the wave-3 runner total  vs  its GATE-CLAIM line
#     recipes_applied    the recipe table rows    vs  the `recipes:` list in recipe.yml
#     job_names          the CI job table         vs  EXPECTED_agora_transparency in watch-gate
#     jobs_total         "Ten jobs"               vs  the rows of its own table
#     cspell_gap         offered minus checked    vs  the 37 + 4 the same section states
#     cspell_binaries    that 37                  vs  the binaries cspell cannot open
#     readme_login_page  the page gated signed in vs  DASHBOARD_ROUTE in AccessibilityTest
#     readme_login_only  "the only page"          vs  DECLARED_LOGGED_IN_PAGES in that test
#     readme_rule_by_name  the axe rule it names  vs  AXE_RULE_ENABLED_BY_NAME in that test
#
#   content/MEDIA-LICENCES.md
#     pdf_count          the PDF count            vs  git ls-files content/file/*.pdf
#     csv_count          the CSV count            vs  git ls-files content/file/*.csv
#     manifest_rows      the manifest row count   vs  the data rows of its own table
#     manifest_generated the generated subset     vs  the rows naming the generator script
#     logo_bytes         logo.png's size          vs  git cat-file -s
#     logo_sha           logo.png's digest        vs  sha256 of the committed blob
#     shot_bytes         screenshot.webp's size   vs  git cat-file -s
#     shot_sha           screenshot.webp's digest vs  sha256 of the committed blob
#
#   LICENCE-MANIFEST.md
#     gpl_files          the GPL file count       vs  git archive minus the media set
#     required_projects  the dependency count     vs  the require block in composer.json
#     font_files         "0 font files"           vs  git archive, by extension
#     media_licences_in_use  the terms in use     vs  the licence cells of the manifest rows
#
#   SECURITY.md
#     security_window    the acknowledgement time vs  the D-064 heading that set it, in DECISIONS.md
#
#   ACCESSIBILITY.md
#     (none)             it states no figure this script registers; every one-copy detector runs
#                        over it instead, so a registered figure written into it is refused
#
#   the accessibility statement (content/node/<uuid>.yml, rendered at /accessibility-statement)
#     a11y_pages         the scanned page count   vs  the pages AccessibilityTest declares
#     a11y_declared_const  DECLARED_PAGES in the test vs  those same pages (source vs source)
#     canvas_pages       the landing page count   vs  git ls-files content/canvas_page/*.yml
#     listing_total      the listing route count  vs  git ls-files config/views.view.agora_base_*
#     listing_scanned    the scanned subset       vs  VIEW_PAGES in AccessibilityTest
#     admin_dashboard_module  the dashboard named vs  the install: list of recipe.yml
#     admin_checked_page     the page gated       vs  DASHBOARD_ROUTE in AccessibilityTest
#     admin_checked_role     the role it is read as  vs  the label of the role LOGGED_IN_ROLE names
#     admin_contrast_owner   who the contrast failures belong to  vs  the declared set's owners
#     admin_landmark_owners  who the landmark findings belong to  vs  the declared set's owners
#     admin_checked_only     "no other page"      vs  DECLARED_LOGGED_IN_PAGES in that test
#     a11y_rule_by_name      the rule the "Target size." item names  vs  AXE_RULE_ENABLED_BY_NAME
#     a11y_rule_every_run    every window.axe.run( in the test  vs  those passing __AXE_OPTIONS__
#     a11y_rule_options_built  the options builder  vs  one line enabling that constant, by name
#
#   recipe.yml / composer.json / recommended.yml
#     description_match  the two descriptions     vs  each other (a bound duplicate, see above)
#     recommended_empty  "intentionally empty"    vs  the non-comment lines of that file
#
# WHAT IS CHECKED WITH --online - the figures ONLINE_FIGURES names, which exist only in another
# project's CI log, and the ones SITE_FIGURES names, which exist only in this package's own
# (T-0613, beside its block below). How many that is, this header does not say: the two lists are
# the count, and every run prints each figure by name. The accessibility statement this package
# ships describes the THEME's gate in a paragraph of its own, and says in as many words that its
# figures are "those reported by the most recent run".
# So the most recent run is what --online reads: the newest TERMINAL, SUCCESSFUL pipeline on
# `agora_theme`'s 1.x, its `nightwatch` trace for the axe summary and its `agora-invariants`
# trace for the contrast summary. A pipeline still running, or a red one, is NOT READ and never a
# pass.
#
# THE TRACES NEED NO CREDENTIAL. /api/v4/projects/<id>/jobs/<id>/trace answers 401 to an
# anonymous request; /project/agora_theme/-/jobs/<id>/raw answers 200 to anybody. The -L is
# MANDATORY: without it the 302 is a few hundred bytes and looks exactly like a failure.
#
# --online IS OPT-IN AND THE GATE NEVER PASSES IT. This script is wired into gate-a-wave1.sh
# because it is offline and fast. A gate that needs a network round trip is a gate somebody makes
# permissive within the week, arriving through the door marked "more rigour".
#
# -----------------------------------------------------------------------------------------------
# WHAT IS NOT CHECKED is printed by name on every run with a reason, and the length of that list
# is asserted non-empty. A guard that silently covers half its subject reads exactly like one
# that covers all of it.
#
# THE REASONS IN THAT LIST MUST BE TRUE. The sibling guard in `agora_theme` carried TWO FALSE
# reasons for weeks - it said a job trace could not be read anonymously, inferred from an API
# endpoint's 401 and never tested against the web route that answers 200 - and while they stood,
# figures it could have been reading went stale. A list of what a guard cannot reach decays into
# a list of what nobody has tried lately unless it is re-read rather than inherited. Some
# entries below say "readable and deliberately not bound", which is a true reason and a weaker
# one; they are written that way rather than dressed up as impossibilities.
#
# AMBIGUITY IS A FAILURE, NOT A TIE-BREAK. Every claim must match its pattern EXACTLY ONCE in its
# own file. A pattern that matches NOTHING is likewise fatal: a regex matching nothing prints "0
# findings" exactly like a clean file (I-028).
#
# WHAT THIS BUYS IS NARROWER THAN "THE PACKAGED PROSE IS TRUE". Each comparison binds ONE
# canonical sentence, and the cross-file rule covers a REGISTERED set of figures rather than
# every number in the packaged files. Both boundaries are in the NOT CHECKED list.
#
# Contract:
#   files opened:     <N>   - packaged files read; each verified present in `git archive`
#   claims extracted: <N>   - numbers and lists read out of them; must be > 0
#   comparisons:      <N>   - offline; must be > 0
#   one-copy checks:  <N>   - registered figures whose home was verified; must be > 0
#   not checked:      <N>   - named exclusions; must be > 0
#   findings:         <N>   - disagreements; the exit code is 0 only when this is 0
#
# House rules for tests/bin/ (T-321(c)): `wc -l` never `grep -c` for a compared value; numeric
# guards defaulted ONLY where zero means FAIL; `grep` rc >= 2 is an error, never "no match";
# never `-F` with `-i`. The canonical copy of that block lives in tests/bin/no-ci-allow-dev.
#
# Usage: tests/bin/packaged-claims [--online]   (run from anywhere; it cd's to the repo root)

set -u
# No `set -e`: a finding must be recorded and counted, not abort the run.

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
cd "$REPO_ROOT" || { echo "FATAL: cannot cd to repo root $REPO_ROOT"; exit 2; }

C_OK=""; C_BAD=""; C_OFF=""; C_DIM=""
if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_BAD=$'\033[31m'; C_OFF=$'\033[0m'; C_DIM=$'\033[2m'
fi

ONLINE=0
for _arg in "$@"; do
  case "$_arg" in
    --online) ONLINE=1 ;;
    -h|--help)
      printf 'usage: %s [--online]\n' "$(basename -- "$0")"
      printf '  (no flag)  offline comparisons against this repository. No network.\n'
      printf '  --online   also re-reads the figures the shipped accessibility statement quotes\n'
      printf '             from a CI trace: five about the theme, and two about this package own\n'
      printf '             phpunit job. The gate never passes this.\n'
      exit 0 ;;
    *) printf 'FATAL: unknown argument "%s". Try --help.\n' "$_arg" >&2; exit 2 ;;
  esac
done

# ------------------------------------------------------------------- the packaged subjects --
# Declared, not discovered. A discovered set would silently shrink to nothing the day a glob
# stopped matching, and report the silence as agreement.
README='README.md'
MANIFEST='content/MEDIA-LICENCES.md'
STATEMENT='content/node/542d60d9-f7b6-596c-9f15-7ee81964d139.yml'
RECIPE='recipe.yml'
COMPOSER='composer.json'
RECOMMENDED='recommended.yml'
# T-0619. The package-level licence manifest. It is a SUBJECT rather than a source: every figure
# it states is compared below, and every one-copy detector is run over it, so the day it restates
# a number that lives in README.md or in the media manifest the guard says so by name.
LICENCES='LICENCE-MANIFEST.md'
# T-0618. The security policy. A SUBJECT for the same reason: it states one figure, how long a
# reporter waits for an acknowledgement, and that figure binds a named person to a named time. It is
# compared below against the decision that set it, and every one-copy detector runs over it.
SECURITY_MD='SECURITY.md'
# T-0617. The WCAG attestation. A SUBJECT with no comparison of its own, on purpose: it states no
# figure this script registers and points at the accessibility statement and the public job logs
# for every result. It is here for the one-copy rule - every detector below runs over it, so the
# day it restates the page count the statement quotes, the guard says so by name.
ACCESSIBILITY_MD='ACCESSIBILITY.md'
PACKAGED_FILES="$README $MANIFEST $STATEMENT $RECIPE $COMPOSER $RECOMMENDED $LICENCES $SECURITY_MD $ACCESSIBILITY_MD"

# Sources that are NOT packaged and are read only as the measured side.
RUNNER1='tests/bin/gate-a-wave1.sh'
RUNNER3='tests/bin/gate-a-wave3.sh'
WATCH='tests/bin/watch-gate'
A11Y_TEST='tests/src/FunctionalJavascript/AccessibilityTest.php'
DECISIONS='specs/000-project/DECISIONS.md'

FILES_OPENED=0
CLAIMS=0
COMPARISONS=0
ONE_COPY=0
FINDINGS=0
UNREAD=0

fatal() { # <reason> - prints NO summary line: a run with no result is not a clean result (I-029)
  printf '\n%sFATAL:%s %s\n' "$C_BAD" "$C_OFF" "$1"
  printf 'This run produced NO verdict, which is not the same as a clean one.\n'
  exit 2
}

grep_fatal() { # <rc> <where>
  fatal "grep exited $1 while reading $2. A grep exit code of 2 or more is an error, never 'no match', and treating it as one would turn a broken read into a clean run."
}

command -v git >/dev/null 2>&1 || fatal "git is not on PATH. The measured side of this guard asks 'what does this package actually contain', and git ls-files plus git archive is how that is asked: the TRACKED and PACKAGED sets, not the working tree."
git rev-parse --git-dir >/dev/null 2>&1 || fatal "$REPO_ROOT is not a git working tree."

# ------------------------------------------------------------------------------ number words --
# Prose reads better with "eleven" than with "11", so the extractor accepts either. An unmapped
# word yields an empty string, which compare() reports as an EMPTY SIDE finding rather than as
# agreement - so a count that outgrows this table fails loudly instead of quietly.
to_num() { # <word-or-numeral> -> integer on stdout, nothing on failure
  local w head tail hv tv
  w=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d ',')
  case "$w" in
    ''|*[!0-9]*) : ;;
    *) printf '%s' "$w"; return 0 ;;
  esac
  case "$w" in
    *-*)
      head=${w%%-*}; tail=${w#*-}
      hv=$(to_num_word "$head"); tv=$(to_num_word "$tail")
      if [ -n "$hv" ] && [ -n "$tv" ] && [ "$hv" -ge 20 ] && [ "$tv" -lt 10 ]; then
        printf '%s' "$((hv + tv))"
      fi
      return 0 ;;
  esac
  to_num_word "$w"
}

to_num_word() { # <single word> -> integer on stdout, nothing on failure
  case "$1" in
    zero) printf '0' ;;      one) printf '1' ;;        two) printf '2' ;;
    three) printf '3' ;;     four) printf '4' ;;       five) printf '5' ;;
    six) printf '6' ;;       seven) printf '7' ;;      eight) printf '8' ;;
    nine) printf '9' ;;      ten) printf '10' ;;       eleven) printf '11' ;;
    twelve) printf '12' ;;   thirteen) printf '13' ;;  fourteen) printf '14' ;;
    fifteen) printf '15' ;;  sixteen) printf '16' ;;   seventeen) printf '17' ;;
    eighteen) printf '18' ;; nineteen) printf '19' ;;  twenty) printf '20' ;;
    thirty) printf '30' ;;   forty) printf '40' ;;     fifty) printf '50' ;;
    sixty) printf '60' ;;    seventy) printf '70' ;;   eighty) printf '80' ;;
    ninety) printf '90' ;;
    *) : ;;
  esac
}

# --------------------------------------------------------------- reading the packaged files --
# The packaged set is verified against `git archive`, which applies .gitattributes the way
# Drupal.org's packaging does. A subject that is not in the archive is not packaged prose, and
# guarding it would be guarding something no end user receives.
ARCHIVE_LIST=$(git archive --worktree-attributes HEAD 2>/dev/null | tar -t 2>/dev/null)
[ -n "$ARCHIVE_LIST" ] || fatal "git archive produced no listing at all. Nothing below could be shown to be packaged, and a guard over an empty set reports 'no findings' exactly like a clean one (I-028)."
ARCHIVE_N=$(printf '%s\n' "$ARCHIVE_LIST" | grep -v '^$' | wc -l | tr -d '[:space:]')

# Every subject's text, CR-stripped once, keyed by a shell-safe name. This checkout may hold LF
# or CRLF depending on how a file was written; the CI runner holds LF. A pattern anchored on a
# line end would otherwise match in one place and not the other, which is a difference between
# environments and not between claims.
TEXT_README=''; TEXT_MANIFEST=''; TEXT_STATEMENT=''
TEXT_RECIPE=''; TEXT_COMPOSER=''; TEXT_RECOMMENDED=''; TEXT_LICENCES=''; TEXT_SECURITY=''
TEXT_ACCESSIBILITY=''
# A SECOND, FLOWED VARIANT OF EVERY SUBJECT, and it is not a convenience. README.md is hard-
# wrapped at 100 columns, so almost every sentence carrying a figure is split across two lines -
# and `grep` reads a line at a time. A pattern written for the sentence would therefore match
# NOTHING, which claim_once treats as fatal, but the failure mode that matters is the opposite
# one: a one-copy DETECTOR that silently fails to match a wrapped restatement would report "no
# second copy" for a second copy that is right there. Claims and detectors run over the flowed
# text; the two places that genuinely need line anchors - the markdown table rows - read the raw
# text directly and say so.
FLOW_README=''; FLOW_MANIFEST=''; FLOW_STATEMENT=''
FLOW_RECIPE=''; FLOW_COMPOSER=''; FLOW_RECOMMENDED=''; FLOW_LICENCES=''; FLOW_SECURITY=''
FLOW_ACCESSIBILITY=''

load_packaged() { # <var-suffix> <path>
  local path="$2" body flow
  [ -r "$path" ] || fatal "$path is not readable from $REPO_ROOT."
  printf '%s\n' "$ARCHIVE_LIST" | grep -qxF -- "$path"
  case $? in
    0) : ;;
    1) fatal "$path is NOT in \`git archive\` output, so it is not packaged. Either an export-ignore rule now removes it - in which case it is no longer this guard's subject and the declaration above moves with the rule, in the same commit - or the path is wrong." ;;
    *) grep_fatal "$?" "the git archive listing" ;;
  esac
  body=$(tr -d '\r' < "$path")
  [ -n "$body" ] || fatal "$path read as empty."
  flow=$(printf '%s' "$body" | tr '\n' ' ' | tr -s ' ')
  eval "TEXT_$1=\$body"
  eval "FLOW_$1=\$flow"
  FILES_OPENED=$((FILES_OPENED + 1))
}

load_packaged README      "$README"
load_packaged MANIFEST    "$MANIFEST"
load_packaged STATEMENT   "$STATEMENT"
load_packaged RECIPE      "$RECIPE"
load_packaged COMPOSER    "$COMPOSER"
load_packaged RECOMMENDED "$RECOMMENDED"
load_packaged LICENCES    "$LICENCES"
load_packaged SECURITY    "$SECURITY_MD"
load_packaged ACCESSIBILITY "$ACCESSIBILITY_MD"

text_of() { # <var-suffix> -> that file's CR-stripped text, line structure intact
  eval "printf '%s' \"\$TEXT_$1\""
}
flow_of() { # <var-suffix> -> the same text with every newline turned into a space
  eval "printf '%s' \"\$FLOW_$1\""
}
path_of() { # <var-suffix> -> that file's path
  case "$1" in
    README) printf '%s' "$README" ;;
    MANIFEST) printf '%s' "$MANIFEST" ;;
    STATEMENT) printf '%s' "$STATEMENT" ;;
    RECIPE) printf '%s' "$RECIPE" ;;
    COMPOSER) printf '%s' "$COMPOSER" ;;
    RECOMMENDED) printf '%s' "$RECOMMENDED" ;;
    LICENCES) printf '%s' "$LICENCES" ;;
    SECURITY) printf '%s' "$SECURITY_MD" ;;
    ACCESSIBILITY) printf '%s' "$ACCESSIBILITY_MD" ;;
    *) printf '%s' "$1" ;;
  esac
}

CLAIM=""
# WHERE THE LAST CLAIM WAS READ. A finding that names a value and not a place sends the reader
# grepping through every packaged file for a number that appears in several of them; the line is
# what makes the output actionable. It is derived from the RAW text - the flowed variant has one
# line by construction - by looking for a literal prefix of the matched claim, which is why it can
# come back as `?`: a claim whose first characters are themselves split across a wrap has no
# single line to name, and saying so is better than naming the wrong one.
CLAIM_FILE=''
CLAIM_AT=''
claim_once() { # <label> <var-suffix> <ERE> - sets CLAIM; FATAL on 0 matches or on 2+
  local label="$1" who="$2" ere="$3" out rc n path prefix
  path=$(path_of "$who")
  out=$(flow_of "$who" | grep -oE "$ere")
  rc=$?
  [ "$rc" -ge 2 ] && grep_fatal "$rc" "$path while extracting '$label'"
  if [ "$rc" -ne 0 ]; then
    fatal "no sentence in $path matches the pattern for '$label': /$ere/
  A pattern that matches nothing reports zero disagreements exactly like a clean file does, so an
  unmatched claim is a failure and never a pass. Either the sentence was reworded - in which case
  this pattern moves with it, in the same commit - or the claim was deleted, and so should this
  comparison be."
  fi
  n=$(printf '%s\n' "$out" | wc -l | tr -d '[:space:]')
  if [ "${n:-0}" -ne 1 ]; then
    printf '\n%sAMBIGUOUS:%s %s matches %s times in %s:\n' "$C_BAD" "$C_OFF" "$label" "$n" "$path"
    printf '%s\n' "$out" | sed 's/^/    /'
    fatal "a figure stated twice is the precondition for the drift this file exists to catch, so a second copy is refused here rather than silently preferred over the first. Delete one copy, or make it a cross-reference with no number in it."
  fi
  CLAIM="$out"
  CLAIM_FILE="$path"
  # Decreasing prefixes, because the claim was matched in the FLOWED text and the raw file is
  # hard-wrapped: a 24-character prefix of a sentence that wraps after twelve is on no single
  # line at all. Falsified on the first dirty run, which printed `?` for a claim sitting on a
  # line anyone could see. Eight characters is the floor: below that the match stops being about
  # this claim.
  CLAIM_AT=''
  for prefix in 40 32 24 16 12 8; do
    CLAIM_AT=$(text_of "$who" | grep -nF -- "$(printf '%s' "$out" | cut -c1-"$prefix")" 2>/dev/null \
      | head -1 | cut -d: -f1)
    [ -n "$CLAIM_AT" ] && break
  done
  [ -n "$CLAIM_AT" ] || CLAIM_AT='?'
  CLAIMS=$((CLAIMS + 1))
}

# The substitution delimiter is # and not /, because some patterns read a capture out of a path.
field() { printf '%s' "$CLAIM" | sed -nE "s#$2#\\$1#p"; }

compare() { # <label> <claimed> <measured> <source>
  local label="$1" claimed="$2" measured="$3" src="$4"
  COMPARISONS=$((COMPARISONS + 1))
  if [ -z "$claimed" ] || [ -z "$measured" ]; then
    FINDINGS=$((FINDINGS + 1))
    printf '  %s%-20s claimed [%s]  ??  %s [%s]  EMPTY SIDE%s\n' \
      "$C_BAD" "$label" "$claimed" "$src" "$measured" "$C_OFF"
    printf '      %s:%s  An empty side is never agreement: one of the two was not read at all.\n' \
      "${CLAIM_FILE:-?}" "${CLAIM_AT:-?}"
    return
  fi
  if [ "$claimed" = "$measured" ]; then
    printf '  %s%-20s%s [%s]  =  %s [%s]  %sOK%s\n' \
      "$C_DIM" "$label" "$C_OFF" "$claimed" "$src" "$measured" "$C_OK" "$C_OFF"
  else
    FINDINGS=$((FINDINGS + 1))
    printf '  %s%-20s [%s]  !=  %s [%s]  MISMATCH%s\n' \
      "$C_BAD" "$label" "$claimed" "$src" "$measured" "$C_OFF"
    printf '      %s:%s  claims %s; the measurement says %s\n' \
      "${CLAIM_FILE:-?}" "${CLAIM_AT:-?}" "$claimed" "$measured"
  fi
}

# ------------------------------------------------------------------------- the one-copy rule --
# T-0609. Every registered figure declares a home and a detector; the detector is run over all
# the packaged files and the set of files it matches must be exactly the home.
#
# A HOME IS ONE OF THREE THINGS, and the third is the one worth explaining.
#   <FILE>            exactly that packaged file may state the figure
#   EXTERNAL          NO packaged file may state it - it belongs to another project's public log
#   <FILE> <FILE>     a DELIBERATELY BOUND duplicate: both copies exist, both are compared
#                     against the same measured source above, so neither can drift alone
#
# The third exists because deletion is not always the right fix. "six registers" reads naturally
# in README's status paragraph and in the shipped statement's scope sentence, and a reader of
# either would be worse off for a cross-reference. What makes two copies safe is not discipline,
# it is that BOTH are bound - and the register below records which ones are, so that a third copy
# arriving later is still refused.
one_home() { # <label> <home-list-or-EXTERNAL> <detector ERE> <why the home is the home>
  local label="$1" home="$2" ere="$3" why="$4" hits='' who path rc expect n want
  ONE_COPY=$((ONE_COPY + 1))
  for who in README MANIFEST STATEMENT RECIPE COMPOSER RECOMMENDED LICENCES SECURITY ACCESSIBILITY; do
    flow_of "$who" | grep -qE "$ere"
    rc=$?
    case $rc in
      0) hits="$hits $who" ;;
      1) : ;;
      *) grep_fatal "$rc" "$(path_of "$who") while applying the one-copy detector for '$label'" ;;
    esac
  done
  hits=${hits# }
  n=$(printf '%s\n' "$hits" | tr ' ' '\n' | grep -v '^$' | wc -l | tr -d '[:space:]')
  if [ "$home" = 'EXTERNAL' ]; then
    expect=0
    want=''
  else
    # The declared homes, in the same fixed order the scan visits them, so the two lists are
    # comparable as strings rather than as sets.
    want=''
    for who in README MANIFEST STATEMENT RECIPE COMPOSER RECOMMENDED LICENCES SECURITY ACCESSIBILITY; do
      case " $home " in *" $who "*) want="$want $who" ;; esac
    done
    want=${want# }
    expect=$(printf '%s\n' "$want" | tr ' ' '\n' | grep -v '^$' | wc -l | tr -d '[:space:]')
    [ "${expect:-0}" -gt 0 ] || fatal "the one-copy register declares '$label' with a home of '$home', which names no packaged subject. A home nothing resolves to would make every count compare equal to zero."
  fi
  if [ "${n:-0}" -gt "$expect" ]; then
    printf '\n%sTWO COPIES:%s %s is stated in %s packaged files:\n' "$C_BAD" "$C_OFF" "$label" "$n"
    for who in $hits; do
      printf '    %s\n' "$(path_of "$who")"
      flow_of "$who" | grep -oE "$ere" | sed 's/^/        /' | cut -c1-200
    done
    fatal "the same number is written in more than one place, which is the drift this guard exists to refuse. $why
  Three ways out, in order of preference: DELETE the copy that is not the home and leave a
  cross-reference with no number in it; or BIND the second copy to the first with a comparison
  here, if it genuinely cannot be removed; or move the home, in which case the declaration above
  moves with it in the same commit. Refreshing both copies faithfully is the one that does not
  work - it is what was being done, carefully, on each of the days a figure here went stale."
  fi
  if [ "${n:-0}" -lt "$expect" ]; then
    FINDINGS=$((FINDINGS + 1))
    printf '  %s%-20s declared home %s, but %s packaged file(s) state it  MISSING HOME%s\n' \
      "$C_BAD" "$label" "$want" "$n" "$C_OFF"
    printf '      A detector that matches nothing cannot tell a deleted claim from a reworded\n'
    printf '      one, and it reports "no second copy" for both.\n'
    return
  fi
  if [ "$expect" -gt 0 ] && [ "$hits" != "$want" ]; then
    FINDINGS=$((FINDINGS + 1))
    printf '  %s%-20s stated in [%s], declared home [%s]  WRONG HOME%s\n' \
      "$C_BAD" "$label" "$hits" "$want" "$C_OFF"
    return
  fi
  if [ "$expect" -eq 0 ]; then
    printf "  %s%-20s%s no packaged copy; it lives in another project's public job log  %sOK%s\n" \
      "$C_DIM" "$label" "$C_OFF" "$C_OK" "$C_OFF"
  elif [ "$expect" -eq 1 ]; then
    printf '  %s%-20s%s one copy, in %s  %sOK%s\n' \
      "$C_DIM" "$label" "$C_OFF" "$(path_of "$hits")" "$C_OK" "$C_OFF"
  else
    printf '  %s%-20s%s %s bound copies, in [%s]  %sOK%s\n' \
      "$C_DIM" "$label" "$C_OFF" "$n" "$hits" "$C_OK" "$C_OFF"
  fi
}

count_tracked() { git ls-files -- "$@" 2>/dev/null | wc -l | tr -d '[:space:]'; }

# A NUMBER, SPELLED EITHER WAY, for the one-copy detectors. It exists because a detector written
# as `[a-z]+ PDFs` matches "generated PDFs" - a phrase with no number in it at all - and would
# then report a cross-reference as a second copy. The alternation is deliberately finite: a count
# that outgrows it stops being detected, which is why every figure it guards is ALSO compared
# against disk above, where an unmapped word surfaces as an EMPTY SIDE finding.
# cspell:disable
# The case-folded classes below are a REGEX and not prose: cspell splits `[Tt]wenty` at the
# bracket and reports `wenty` as a misspelling, nineteen times. Scoped here rather than fed into
# the project word list, which is the rule D-024(3) states for a verbatim pattern.
NUM='([0-9][0-9,]*|[Tt]wenty-[a-z]+|[Tt]hirty-[a-z]+|[Ff]orty-[a-z]+|[Ff]ifty-[a-z]+|[Oo]ne|[Tt]wo|[Tt]hree|[Ff]our|[Ff]ive|[Ss]ix|[Ss]even|[Ee]ight|[Nn]ine|[Tt]en|[Ee]leven|[Tt]welve|[Tt]hirteen|[Ff]ourteen|[Ff]ifteen|[Ss]ixteen|[Ss]eventeen|[Ee]ighteen|[Nn]ineteen|[Tt]wenty|[Tt]hirty|[Ff]orty|[Ff]ifty|[Ss]ixty)'
# cspell:enable

# The em dash and the middle dot this project's prose uses are MULTI-BYTE in UTF-8, and this
# host runs with LANG unset - a C locale, where `.` matches one BYTE. A pattern writing `.` for
# one of them therefore matches here and not on the CI runner, or the other way round. `[^ ]+`
# matches whatever the separator is, in either locale, and is used for every one of them below.
DASH='[^ ]+'

# sha256 with the three implementations this project's hosts actually provide. macOS ships no
# sha256sum; it ships shasum. A drift detector that quietly changes which program computes its
# hashes is worse than one that is noisy, so the choice is printed in the summary.
SHA_IMPL=''
if command -v sha256sum >/dev/null 2>&1; then SHA_IMPL='sha256sum'
elif command -v shasum >/dev/null 2>&1; then SHA_IMPL='shasum -a 256'
elif command -v openssl >/dev/null 2>&1; then SHA_IMPL='openssl dgst -sha256'
fi
blob_sha() { # <path> -> sha256 of the COMMITTED blob, or nothing
  local obj
  [ -n "$SHA_IMPL" ] || return 0
  obj=$(git rev-parse "HEAD:$1" 2>/dev/null) || return 0
  [ -n "$obj" ] || return 0
  git cat-file blob "$obj" 2>/dev/null | $SHA_IMPL 2>/dev/null | grep -oE '[0-9a-f]{64}' | head -1
}
blob_size() { # <path> -> byte size of the COMMITTED blob, or nothing
  local obj
  obj=$(git rev-parse "HEAD:$1" 2>/dev/null) || return 0
  [ -n "$obj" ] || return 0
  git cat-file -s "$obj" 2>/dev/null | tr -d '[:space:]'
}

printf '=========================================================================================================\n'
printf 'packaged-claims - Agora - the figures in the packaged prose against the things that produce them\n'
printf 'repo: %s\n' "$REPO_ROOT"
printf 'date: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
if [ "$ONLINE" -eq 1 ]; then
  printf 'mode: offline + --online (agora_theme CI job traces)\n'
else
  printf 'mode: offline only (no network; --online is opt-in and the gate never passes it)\n'
fi
printf 'subjects: %s packaged file(s), each verified present in `git archive` (%s entries)\n' \
  "$FILES_OPENED" "$ARCHIVE_N"
printf '=========================================================================================================\n'

# ============================================================== README.md vs the repository ==
printf '\nREADME.md - what the package says it ships, against what it ships\n'
printf -- '---------------------------------------------------------------------------------------------------------\n'

claim_once 'corpus size' README \
  "\\*\\*[0-9]+ records across [a-z]+ registers\\*\\* $DASH [0-9]+ files in \`content/\`, [0-9]+ config objects"
R_RECORDS=$(field 1 '.*\*\*([0-9]+) records.*')
R_REGISTERS=$(to_num "$(field 1 '.*records across ([a-z]+) registers.*')")
R_CONTENT=$(field 1 '.* ([0-9]+) files in .content/..*')
R_CONFIG=$(field 1 '.*, ([0-9]+) config objects.*')
compare 'demo_records' "$R_RECORDS" "$(count_tracked 'content/node/*.yml')" 'git ls-files content/node/*.yml'
REGISTER_BUNDLES=$(grep -hoE '^  bundle: agora_base_[a-z_]+' content/node/*.yml 2>/dev/null \
  | sort -u | wc -l | tr -d '[:space:]')
compare 'registers' "$R_REGISTERS" "$REGISTER_BUNDLES" 'distinct agora_base_* node bundles'
compare 'content_files' "$R_CONTENT" "$(count_tracked 'content/')" 'git ls-files content/'
compare 'config_objects' "$R_CONFIG" "$(count_tracked 'config/*.yml')" 'git ls-files config/*.yml'

claim_once 'theme constraint' README 'this template requires at `\^[0-9]+\.[0-9]+`'
R_THEME=$(field 1 '.*requires at .(\^[0-9]+\.[0-9]+).*')
C_THEME=$(text_of COMPOSER | sed -nE 's/.*"drupal\/agora_theme": "([^"]+)".*/\1/p')
compare 'theme_constraint' "$R_THEME" "$C_THEME" 'composer.json require'

# The home page is the Canvas page whose alias is the one recipe.yml points `page.front` at, so
# neither the file name nor the block count is typed here.
claim_once 'front blocks' README 'as the home page, carrying \*\*[a-z]+\*\* blocks'
R_FRONT=$(to_num "$(field 1 '.*carrying \*\*([a-z]+)\*\* blocks.*')")
FRONT_ALIAS=$(text_of RECIPE | sed -nE "s/^ +page\.front: '([^']+)'.*/\1/p" | head -1)
