#!/usr/bin/env bash
#
# config-inventory - Agora - unit 002, T-601.
#
# Prints the denominator that the two kernel tests assert over, and fails if
# that denominator is degenerate or if config/ contains something that is not a
# config object.
#
# WHY IT EXISTS. T-601's success criterion asks for the number of config objects
# to be STATED, not merely for the checks over them to pass: a green check over
# an unknown denominator is a badge, not a gate (I-045), and RequirementsTest
# was a literal tautology for as long as config/ did not exist - it looped over
# an empty list and passed with nothing built. The obvious place to print that
# number was the test itself, and that is exactly where it cannot be printed:
# PHPUnit converts ANY output a test emits into a
# `PHPUnit\Framework\Exception`, STDOUT and STDERR alike. Two tests wrote their
# counts to STDERR to dodge `beStrictAboutOutputDuringTests`; both failed
# pipeline 934619 with every one of their assertions passing. So the assertions
# stayed in PHP and the printing moved here, to a job whose whole contract is
# printing counts.
#
# DIVISION OF LABOUR, so neither side is mistaken for the other:
#   - here:  the counts are PRINTED - config objects, files, bytes - and the
#            degenerate cases (no config/, an empty config/, a non-YAML file, a
#            zero-byte object) are findings.
#   - PHP:   RequirementsTest asserts that `FileStorage::listAll()` enumerates
#            exactly as many objects as there are `.yml` files here, so a config
#            object that Drupal silently declines to enumerate cannot pass as
#            one; ContentModelTest asserts every object T-601 owns by name.
# Neither side hard-codes an expected TOTAL. T-612 through T-615 grow config/
# legitimately, and a number that has to be relaxed on every growth is a gate
# that teaches people to relax gates.
#
# Contract:
#   scope:    <exact list of directories inspected>
#   scanned:  <N> file(s)    - N must be > 0 or this script exits 1
#   findings: <M>            - each printed as  path:line  reason
#   exit 0 iff M == 0
#
# An empty scope, a missing tool or an unreadable directory is a FAILURE, never
# a skip (I-007). `line` is 0 for findings about a file as a whole: the finding
# is the file's existence or its size, which no line carries.
#
#
# House rules for tests/bin/ (T-321(c)): `wc -l` never `grep -c` for a compared
# value; numeric guards defaulted ONLY where zero means FAIL; grep rc >= 2 is an
# error, never "no match"; never `-F` with `-i`. The CANONICAL copy of the block,
# with the reasoning and the I-031 asymmetry spelled out, lives in the header of
# tests/bin/no-ci-allow-dev. Read it before adding a counter here.
#
# Usage: tests/bin/config-inventory   (run from anywhere; it cd's to the repo root)

set -u
# No `set -e`: a finding must be recorded and counted, not abort the run.

# `CDPATH= cd` is an env-var prefix, not an assignment; shellcheck misreads it.
# shellcheck disable=SC1007
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1007
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
cd "$REPO_ROOT" || { echo "FATAL: cannot cd to repo root $REPO_ROOT"; exit 1; }

C_BAD=""; C_OFF=""
if [ -t 1 ]; then C_BAD=$(printf '\033[31m'); C_OFF=$(printf '\033[0m'); fi

fatal() { printf 'FATAL: %s\n' "$1" >&2; exit 1; }

# Two scratch paths for the comm probe in the preflight below. Plain paths
# rather than mktemp output, because mktemp is itself one of the tools the
# preflight has not exercised yet.
PROBE_A="${TMPDIR:-/tmp}/config-inventory-probe-a.$$"
PROBE_B="${TMPDIR:-/tmp}/config-inventory-probe-b.$$"

# ---------------------------------------------------------------- preflight --
# Located AND exercised: a tool that resolves but does not run turns every
# count below into a silent zero (I-026).
for tool in find wc sort mktemp awk grep comm; do
  command -v "$tool" >/dev/null 2>&1 || fatal "required tool not found: $tool"
done
[ "$(printf 'a\nb\n' | wc -l | tr -d '[:space:]')" = "2" ] \
  || fatal "wc -l does not count lines on this host"
[ "$(find . -maxdepth 0 -type d | wc -l | tr -d '[:space:]')" = "1" ] \
  || fatal "find does not report directories on this host"
# T-1912 adds awk and comm, which read and compare the non-ASCII bound below.
# A resolvable-but-broken awk would turn the DECLARED bound into an empty list,
# and an empty bound is satisfied by anything - the silent zero this whole
# script exists to refuse, arriving through the door marked "more rigour".
[ "$(printf 'x y\n' | awk '{ print $2 }')" = "y" ] \
  || fatal "awk does not print fields on this host"
printf 'a\nb\n' > "$PROBE_A" || fatal "cannot write the comm probe file"
printf 'b\nc\n' > "$PROBE_B" || fatal "cannot write the comm probe file"
[ "$(comm -12 "$PROBE_A" "$PROBE_B")" = "b" ] \
  || fatal "comm does not intersect sorted lists on this host"
rm -f "$PROBE_A" "$PROBE_B"

CONFIG_DIR="config"
[ -d "$CONFIG_DIR" ] || fatal "$CONFIG_DIR/ not found in $REPO_ROOT (empty scope)"
[ -r "$CONFIG_DIR" ] || fatal "$CONFIG_DIR/ is not readable"

FINDINGS_FILE=$(mktemp -t config-inventory.XXXXXX) || fatal "cannot create a temp file"
FILE_LIST=$(mktemp -t config-inventory-files.XXXXXX) || fatal "cannot create a temp file"
# T-1912: the non-ASCII bound is compared as two SORTED LISTS and not as two
# totals, so each side needs a file of its own for `comm` to read. Two objects
# swapping places keep the total at 8 while meaning something entirely
# different, and a total is all this section printed for the month it was
# unable to fail.
DECLARED_LIST=$(mktemp -t config-inventory-declared.XXXXXX) || fatal "cannot create a temp file"
MEASURED_LIST=$(mktemp -t config-inventory-measured.XXXXXX) || fatal "cannot create a temp file"
trap 'rm -f "$FINDINGS_FILE" "$FILE_LIST" "$DECLARED_LIST" "$MEASURED_LIST"' EXIT

# Findings are appended to a file and counted from it at report time, never
# accumulated in a variable that a subshell could silently drop. One finding is
# always exactly one line.
finding() { # <file> <line> <reason>
  printf '  %s%s:%s%s  %s\n' "$C_BAD" "$1" "$2" "$C_OFF" "$3" >> "$FINDINGS_FILE"
}

count_findings() {
  wc -l < "$FINDINGS_FILE" | tr -d '[:space:]'
}

# ------------------------------------------------------------------- scan ----
# The WORKING TREE is scanned with `find`, never `git ls-files` (I-018/I-019):
# an export written this minute and not yet staged is exactly the moment this
# guard is meant to fire, and `git ls-files` cannot see it.
#
# Recursive on purpose. `FileStorage::listAll()` is NOT recursive, so a config
# object parked in a subdirectory of config/ is a file Drupal will never
# enumerate - it would inflate the file count here while leaving the object
# count in PHP unchanged, which is precisely the asymmetry the two counts below
# exist to surface.
find "$CONFIG_DIR" -type f 2>/dev/null | LC_ALL=C sort > "$FILE_LIST" \
  || fatal "the scan of $CONFIG_DIR/ did not complete"

SCANNED=$(wc -l < "$FILE_LIST" | tr -d '[:space:]')
OBJECTS=0
NESTED=0
EMPTY=0
NEWLINE=0

while IFS= read -r f; do
  [ -n "$f" ] || continue

  case "$f" in
    *.yml)
      OBJECTS=$((OBJECTS + 1))
      ;;
    *)
      finding "$f" "0" \
        "not a .yml file; config/ holds config objects and nothing else"
      continue
      ;;
  esac

  # A top-level object is `config/<name>.yml`; anything deeper is invisible to
  # FileStorage::listAll() and would ship as dead weight.
  case "${f#"$CONFIG_DIR"/}" in
    */*)
      NESTED=$((NESTED + 1))
      finding "$f" "0" \
        "nested below config/; FileStorage::listAll() will never enumerate it"
      ;;
  esac

  # A zero-byte object enumerates and then carries nothing: it would pass every
  # `_core`/`uuid` check in RequirementsTest by having no keys at all.
  if [ ! -s "$f" ]; then
    EMPTY=$((EMPTY + 1))
    finding "$f" "0" "zero bytes; an empty config object carries no config"
  fi

  # EXACTLY ONE trailing newline, and this check exists because `phpcs` turned
  # the gate red for the third time in one day over something no local tool
  # could see. `Drupal.Files.EndFileNewline` is blocking, `phpcs` cannot run on
  # this host (T-803), and `drush config:get --format=yaml` writes a trailing
  # BLANK LINE - so every config object exported that way arrives one newline
  # too long and nothing local says so until CI does.
  #
  # It is checked HERE rather than in a new script because the defect is a
  # property of a config object, and this is the invariant that already opens
  # every config object and already prints their count. A separate script would
  # be a second denominator over the same set.
  #
  # Both directions are findings on purpose. A missing final newline is the
  # commoner mistake in most projects; a doubled one is the mistake THIS
  # project's own tooling makes.
  if [ -s "$f" ]; then
    _tail=$(tail -c 2 "$f" | od -An -c 2>/dev/null | tr -d ' ')
    case "$_tail" in
      *'\n\n')
        NEWLINE=$((NEWLINE + 1))
        finding "$f" "0" \
          "ends with a blank line; Drupal.Files.EndFileNewline wants exactly one newline and phpcs is blocking. drush config:get --format=yaml writes this - strip it before committing" ;;
      *'\n') ;;
      *)
        NEWLINE=$((NEWLINE + 1))
        finding "$f" "0" \
          "does not end with a newline; Drupal.Files.EndFileNewline is blocking" ;;
    esac
  fi
done < "$FILE_LIST"

# ------------------------------------------------------------------ report --
printf '\nconfig-inventory - the denominator the kernel tests assert over\n\n'
printf 'scope:      %s/ in the working tree, recursive\n' "$CONFIG_DIR"
printf 'scanned:    %s file(s)\n' "$SCANNED"
printf 'config objects: %s (%s/*.yml, the set FileStorage::listAll() enumerates)\n' \
  "$OBJECTS" "$CONFIG_DIR"
printf 'nested files:   %s (below %s/, enumerated by nothing)\n' "$NESTED" "$CONFIG_DIR"
printf 'zero-byte objects: %s\n' "$EMPTY"
printf 'trailing-newline findings: %s (exactly one newline, Drupal.Files.EndFileNewline)\n' "$NEWLINE"
printf 'exclusions: none - every file under %s/ is inspected\n' "$CONFIG_DIR"

# -------------------------------------------------- per-bundle denominators --
# T-613's criterion asks for the per-bundle field-set SIZES to be stated
# alongside the set-equality assertions that ContentModelTest makes in both
# directions. It cannot state them itself: PHPUnit turns any output a test
# emits, STDOUT and STDERR alike, into an exception (pipeline 934619). So the
# assertion lives in PHP and the number is printed here, which is the same
# division of labour the header describes for the total.
#
# NOTHING here is a finding and nothing is compared to an expected value: a
# bundle count hard-coded in this script would have to be edited every time
# T-614 legitimately grows the model, which is the habit the whole file exists
# to avoid. The set-equality assertions in ContentModelTest are what fail when
# one of these numbers is wrong; this block only says what the numbers ARE.
printf '\nper-bundle field sets (the sizes ContentModelTest asserts by equality):\n'
BUNDLES=0
for t in "$CONFIG_DIR"/node.type.*.yml; do
  [ -e "$t" ] || break
  b=${t#"$CONFIG_DIR"/node.type.}
  b=${b%.yml}
  BUNDLES=$((BUNDLES + 1))
  # `wc -l` over a listing, never `grep -c`: house rule, T-321(c).
  n=$(find "$CONFIG_DIR" -maxdepth 1 -type f \
        -name "field.field.node.$b.*.yml" 2>/dev/null | wc -l | tr -d '[:space:]')
  printf '  %-24s %s field instance(s)\n' "$b" "${n:-0}"
done
printf '  node types: %s\n' "$BUNDLES"

# ---------------------------------------------------- per-view denominators --
# T-615's criterion asks for the six view column-set SIZES to be stated beside
# the set-equality assertion ContentModelTest::testTableViews() makes in both
# directions - the view's columns against the bundle's own fields, which is
# what makes D-026's "six node types, not one union type" falsifiable rather
# than an opinion. Same division of labour as the block above, and for the same
# hard reason: PHPUnit turns any output a test emits, STDOUT and STDERR alike,
# into an exception (pipeline 934619), so the assertion lives in PHP and the
# number is printed here.
#
# The exposed-filter count is printed beside it because THE FACET SPINE IS NOT
# UNIFORM and the numbers are the honest way to say so: Document and Dataset
# carry area and financial year, the three financial regimes carry area and
# status, and Person carries area alone. A row of identical numbers here would
# mean somebody had squared the spine by attaching a field a bundle's own
# regime does not name.
#
# NOTHING here is a finding and nothing is compared to an expected value, for
# the same reason as the block above.
printf '\nper-view column sets (the sizes ContentModelTest asserts by equality):\n'
VIEWS=0
for v in "$CONFIG_DIR"/views.view.*.yml; do
  [ -e "$v" ] || break
  n=${v#"$CONFIG_DIR"/views.view.}
  n=${n%.yml}
  VIEWS=$((VIEWS + 1))
  # The `fields:` block of the default display, counted by walking the region
  # between its key and the next key at the same indent. The exporter's YAML
  # indentation is two spaces and byte-stable run to run (D-032), which is what
  # makes this readable without a YAML parser this repository does not ship.
  cols=$(awk '
    /^      fields:$/ { inf = 1; next }
    inf && /^      [a-z_]+:/ { inf = 0 }
    inf && /^        [A-Za-z0-9_]+:$/ { n++ }
    END { print n + 0 }
  ' "$v")
  # `wc -l` over a listing, never `grep -c` for a compared value: house rule,
  # T-321(c). Nothing here is compared, but the house rule is not conditional.
  facets=$(grep '^          exposed: true$' "$v" 2>/dev/null | wc -l | tr -d '[:space:]')
  printf '  %-24s %s column(s), %s exposed filter(s)\n' "$n" "${cols:-0}" "${facets:-0}"
done
printf '  table views: %s\n' "$VIEWS"

# ------------------------------------------------- key-route denominator --
# T-801 (carried from unit 001 as T-402) asks for the NUMBER OF ROUTES ASSERTED
# to be printed. Same division of labour as every block above, and for the same
# hard reason: PHPUnit turns any output a test emits, STDOUT and STDERR alike,
# into an exception (pipeline 934619). `ValidationTest::testKeyRoutes()` asserts
# the number; this prints it, together with the marker each route is asserted on,
# so that a reader can see WHAT was checked and not only how many.
#
# WHY THE MARKER IS PRINTED AND NOT JUST THE COUNT. A route asserted for status
# alone is worth nothing here - a 200 proves a page exists, not that ÁGORA's page
# exists - so the count on its own would be the same badge this whole file exists
# to refuse. The caption strings below are the per-route markers: they are written
# by this template's own view config, they are rendered into the table's
# `<caption>`, and they must be DISTINCT, or a route serving another route's table
# would satisfy every one of them. Non-uniqueness is therefore a finding here and
# an assertion in PHP.
#
# THE THEME-LEVEL MARKER IS NOT VISIBLE FROM THIS SCRIPT and is not claimed here.
# `main.agora-page__main` is emitted by `agora_theme`'s page template, which lives
# in a different repository and is only observable on a rendered page. That half
# is asserted in PHP alone, and this block says so rather than implying a coverage
# it cannot see.
printf '\nkey routes (the set ValidationTest::testKeyRoutes() asserts, T-801):\n'
# Named here rather than reused from the optional-key block below, which runs
# later in the file: a variable read before it is assigned is exactly the silent
# empty scope this script refuses everywhere else.
RECIPE_FILE="recipe.yml"
ROUTES=0
VIEW_ROUTES=0
CAPTION_LIST=$(mktemp -t config-inventory-captions.XXXXXX) || fatal "cannot create a temp file"
trap 'rm -f "$FINDINGS_FILE" "$FILE_LIST" "$CAPTION_LIST"' EXIT
for v in "$CONFIG_DIR"/views.view.agora_base_*.yml; do
  [ -e "$v" ] || break
  id=${v#"$CONFIG_DIR"/views.view.}
  id=${id%.yml}
  # The page display's own path, and the caption of the default display's table
  # style. Both read from the file rather than typed, for the same reason the
  # column counts above are: a number or a string typed beside a check is a
  # check that agrees with itself.
  route=$(awk '
    /^  page_1:$/ { inp = 1; next }
    inp && /^      path: / { sub(/^      path: /, ""); print; exit }
  ' "$v")
  caption=$(awk '
    /^          caption: / { sub(/^          caption: /, ""); print; exit }
  ' "$v")
  # Strip the exporter's single quotes so the printed string is the string a
  # reader would see in the page, not its YAML spelling.
  caption=${caption#\'}
  caption=${caption%\'}
  if [ -z "$route" ]; then
    finding "$v" "0" "no page display path; a view with no route cannot be a key route"
    continue
  fi
  if [ -z "$caption" ]; then
    finding "$v" "0" "no table caption; the route would be asserted on status alone (T-801)"
    continue
  fi
  printf '%s\n' "$caption" >> "$CAPTION_LIST"
  ROUTES=$((ROUTES + 1))
  VIEW_ROUTES=$((VIEW_ROUTES + 1))
  printf '  /%-14s marker: caption "%s"\n' "$route" "$caption"
done

# The front page, whose route marker is theme-level only: `content/` ships one
# landing page whose own fields carry no body text - a Canvas page's only
# renderable field is its component tree - so the page ITSELF still gives this
# script nothing to key a marker on. Stated rather than padded into the table
# above.
#
# ⚠️ AMENDED 2026-08-27 (D-041). The comment used to say "there is no
# Ágora-specific TEXT on it to assert", and that stopped being true the moment
# the frame sentence landed: `/` now serves one, from the header area of
# `agora_base_publications` block_2. The marker below is still theme-level,
# because this script reads `config/` and cannot see a rendered page - but the
# sentence it prints must not claim a blankness the site no longer has.
FRONT=$(tr -d '\r' < "$RECIPE_FILE" 2>/dev/null | awk '
  /^        page\.front: / { sub(/^        page\.front: /, ""); print; exit }
')
FRONT=${FRONT#\'}
FRONT=${FRONT%\'}
if [ -n "$FRONT" ]; then
  ROUTES=$((ROUTES + 1))
  printf '  %-15s marker: theme only (main.agora-page__main) - the D-041 frame sentence the Canvas page serves is its own last component (T-0722(ii)), not a view header\n' "$FRONT"
else
  finding "$RECIPE_FILE" "0" "no page.front declared; the front page is not a route this template owns"
fi

# `wc -l` over a listing, never `grep -c`, because this value IS compared:
# house rule, T-321(c).
UNIQUE=$(LC_ALL=C sort -u < "$CAPTION_LIST" | wc -l | tr -d '[:space:]')
TOTAL_CAPTIONS=$(wc -l < "$CAPTION_LIST" | tr -d '[:space:]')
printf '  key routes asserted: %s   distinct route markers: %s of %s\n' \
  "$ROUTES" "$UNIQUE" "$TOTAL_CAPTIONS"
if [ "${UNIQUE:-0}" -ne "${TOTAL_CAPTIONS:-0}" ]; then
  finding "$CONFIG_DIR/views.view.agora_base_*.yml" "0" \
    "two routes share a caption; the marker would identify the project, not the route"
fi
# Zero routes is a failure, not "nothing to report" - the same tautology this
# file opens with. T-321(b): defaulted because zero means FAIL here.
#
# ⚠️ THE GUARD IS ON THE VIEW ROUTES, NOT ON THE TOTAL, and the difference is
# the whole point. Guarding `ROUTES` alone would let all eight views disappear
# and still pass, because the front page would carry the total to 1 - and the
# uniqueness check above would agree, vacuously, that 0 of 0 markers are
# distinct. Found by walking this block's own zero case rather than by running
# it, which is the only way a degenerate branch is ever found.
if [ "${VIEW_ROUTES:-0}" -eq 0 ]; then
  finding "$CONFIG_DIR" "0" \
    "no view route found; testKeyRoutes() would assert over an empty set (T-801)"
fi

# ------------------------------------------------------ role denominators --
# T-602's criterion asks for the number of roles and permissions INSPECTED to be
# printed. Same division of labour as the blocks above and for the same hard
# reason: `RolesAndPermissionsTest` asserts the numbers and cannot print them,
# because PHPUnit turns any output a test emits into an exception.
#
# ⚠️ WHY THE SCOPE IS "ROLES THIS TEMPLATE SHIPS" AND NOT "ROLES ON A SITE".
# The criterion as first written asked that no role except `administrator` hold
# a permission matching `^administer `, and that is RED ON ARRIVAL: the
# inherited `content_editor` holds three, from two upstream recipes Ágora lists
# deliberately. Those three are a dated, named exception, ASSERTED by
# `ValidationTest::testRolesOnAnInstalledSite()` on a live site — this script
# can only see what is in config/, so it prints that and says so, rather than
# printing a site-wide number it is not in a position to measure.
#
# ZERO ROLES IS A FAILURE, not "nothing to report" — the row says so in as many
# words, and it is the same tautology the header describes for config/ as a
# whole: every assertion in the kernel test loops over this set.
printf '\nroles shipped by this template (the set RolesAndPermissionsTest asserts over):\n'
ROLES=0
ROLE_PERMS=0
for r in "$CONFIG_DIR"/user.role.*.yml; do
  [ -e "$r" ] || break
  id=${r#"$CONFIG_DIR"/user.role.}
  id=${id%.yml}
  ROLES=$((ROLES + 1))
  # A permission is one `  - '...'` line inside the `permissions:` block, counted
  # by walking from that key to the next key at column 0. `wc -l` over a
  # listing, never `grep -c` for a compared value: house rule, T-321(c).
  n=$(awk '
    /^permissions:$/ { inp = 1; next }
    inp && /^[a-z_]+:/ { inp = 0 }
    inp && /^  - / { n++ }
    END { print n + 0 }
  ' "$r")
  # `is_admin` is printed because it is the FLAG the tests key their exemption
  # on. A role reporting 0 permissions is not thereby clean - an is_admin role
  # stores none and is allowed everything - and printing the two side by side is
  # what stops a reader drawing the wrong conclusion from a zero.
  adm=$(awk '/^is_admin:/ { print $2; exit }' "$r")
  # Permissions matching ^administer , which for a role THIS template ships must
  # be zero. Printed, and asserted in PHP.
  bad=$(awk '
    /^permissions:$/ { inp = 1; next }
    inp && /^[a-z_]+:/ { inp = 0 }
    inp && /^  - .administer / { n++ }
    END { print n + 0 }
  ' "$r")
  printf '  %-28s %2s permission(s), is_admin=%-5s, %s matching ^administer\n' \
    "$id" "${n:-0}" "${adm:-?}" "${bad:-0}"
  ROLE_PERMS=$((ROLE_PERMS + ${n:-0}))
done
printf '  roles inspected: %s   permissions granted across them: %s\n' "$ROLES" "$ROLE_PERMS"
printf '  inherited roles are NOT in this scope: content_editor holds 3 ^administer\n'
printf '  permissions from upstream recipes, recorded as a dated exception and asserted\n'
printf '  by ValidationTest::testRolesOnAnInstalledSite().\n'
if [ "${ROLES:-0}" -eq 0 ]; then
  finding "$CONFIG_DIR/user.role.*.yml" "0" \
    "no role shipped; zero roles inspected is a failure, not a pass (T-602)"
fi

# ------------------------------------------- recipe.yml optional-key audit --
# T-604's criterion asks for the count of `?`-prefixed config names INSPECTED to
# be printed. This is the one block whose scope is NOT config/, and it is
# labelled as such rather than folded into the totals above.
#
# WHY THE EXPECTED COUNT IS ZERO. A `?` prefix means "apply if present, SILENTLY
# skip if not", and no API reports what was skipped - so the original criterion
# ("0 unresolved optional keys that were expected to exist") could not be
# evaluated at all. Restated and executed: all 16 names were resolved against a
# clean install carrying this template's exact dependency closure, 16 existed
# and 0 were absent, so every prefix was dropped. A `?` reappearing here is not
# automatically wrong - a genuinely conditional config is exactly what the
# prefix is for - but it must come with a line in the recipe saying which
# install it is absent on, which is why the names are printed and not just
# counted.
RECIPE="recipe.yml"
printf '\nrecipe.yml optional-key audit (scope: %s, NOT %s/):\n' "$RECIPE" "$CONFIG_DIR"
if [ -r "$RECIPE" ]; then
  # `tr -d '\r'`: recipe.yml is CRLF in the working tree, and `$` would never
  # match without it - a silent zero, which is the failure mode this whole
  # script exists to refuse.
  # `wc -l` over a listing, never `grep -c`, because this value IS compared
  # below: house rule, T-321(c).
  OPTIONAL=$(tr -d '\r' < "$RECIPE" | grep '^    ?' | wc -l | tr -d '[:space:]')
  ACTIONS=$(tr -d '\r' < "$RECIPE" | grep -E '^    [?]?canvas\.component\.' | wc -l | tr -d '[:space:]')
  printf '  canvas component actions named: %s\n' "${ACTIONS:-0}"
  printf '  ?-prefixed names inspected:     %s\n' "${OPTIONAL:-0}"
  if [ "${OPTIONAL:-0}" -gt 0 ]; then
    printf '  the names still carrying a ?:\n'
    tr -d '\r' < "$RECIPE" | grep '^    ?' | sed 's/^/    /'
  fi
else
  finding "$RECIPE" "0" "not readable; the optional-key audit has an empty scope"
fi

# TWO decisions put a byte above 0x7F into a shipped string, and until T-1912
# this section only PRINTED how many objects carry one. D-033 permits three
# legal citations, of which only two are accented; D-047 puts a currency unit on
# seven money field instances, one of which is also a citation.
#
# WHY PRINTING IT WAS NOT ENOUGH, measured rather than argued. The assertion
# lives in a PHPUnit kernel test, and NEITHER GATE RUNNER IN THIS REPOSITORY
# EXECUTES PHPUNIT - gate-a-wave1.sh and gate-a-wave3.sh are shell invariants
# only. So during wave 23 this line printed 10 against a declared 8, nothing
# compared the two, and 1.x went red in CI on a commit whose author had run the
# full local gate green. A number printed beside no comparison is the exact
# shape of I-045, one level below the gate it belongs to.
#
# WHERE THE BOUND COMES FROM, AND WHY IT IS NOT RETYPED HERE. It is read out of
# the two `private const` lists in the kernel test that already owns it, so
# there is exactly ONE declaration in the repository. A second copy of the
# number here would be the defect being closed - a bound written twice goes
# stale in one copy first - wearing a fix's clothes.
#
# IT COMPARES NAMES, NOT TOTALS. Two objects swapping places leave the count at
# 8 and mean something entirely different, so each side is sorted and `comm`
# reports BOTH directions: an object carrying a byte nobody declared, and a
# declared object that has stopped carrying one.
#
# WHAT THIS STILL CANNOT SEE, so the PHP assertion is not mistaken for
# redundant: ContentModelTest also checks the RESIDUE - that every non-ASCII
# byte inside a permitted object belongs to a legal citation D-033 permits or to
# a currency unit read back out of the object itself. A fourth Spanish term
# added to an object ALREADY on the list passes here and fails there.
#
# Scanned with the same byte RANGE the kernel test uses - never a
# `[^\x00-\x7F]` bracket class, which GNU grep does not read the way it looks
# and which returns a permanent false positive.
BOUND_SOURCE="tests/src/Kernel/ContentModelTest.php"
[ -r "$BOUND_SOURCE" ] \
  || fatal "$BOUND_SOURCE is not readable; the non-ASCII bound has no source"

# The entries of a `private const <NAME> = [ ... ];` list, one per line. The
# single quote is passed IN as a variable rather than embedded, so the awk
# program itself contains no quote to escape.
#
# TWO TERMINATORS, AND THE SECOND ONE IS NOT DEFENSIVE PROGRAMMING - IT WAS
# FOUND BY FALSIFYING THIS FUNCTION. Emptying the constant to
# `private const NON_ASCII_OBJECTS = [];` puts the opening bracket and the
# closing `];` on ONE line. The first draft matched the opener, called `next`,
# stepped straight over the closer and ran on into the NEXT constant - so the
# emptied list reported the SEVEN entries of the constant below it, the I-028
# guard was satisfied by the wrong list, and the run failed for an unrelated
# reason. It is the same parser bug T-1909 hit reading a deleted table in
# CLAUDE.md, in a different file, four weeks later.
#
# So: an opener whose own line also closes the list yields NOTHING, and any
# `private const` met while inside ENDS the list. A scan that runs past its own
# subject is worse than one that finds nothing, because it finds something.
php_const_list() { # <file> <CONST_NAME>
  awk -v q="'" -v c="$2" '
    index($0, "private const " c " = [") > 0 {
      # `= [];` on one line is an EMPTY list, not the start of one.
      if (index($0, "];") > 0) { exit }
      inside = 1
      next
    }
    inside && $0 ~ /^[[:space:]]*\];[[:space:]]*$/ { exit }
    inside && index($0, "private const ") > 0 { exit }
    inside {
      # Split on the quote and take what lies between the first pair. Written
      # with split() rather than match() so the program names no awk internal
      # variables: the match() form has to read two of them back by name, and
      # the spell checker is right to ask what those are.
      if (split($0, parts, q) >= 3) { print parts[2] }
    }
  ' "$1"
}

BOUND_D033=$(php_const_list "$BOUND_SOURCE" NON_ASCII_OBJECTS)
BOUND_D047=$(php_const_list "$BOUND_SOURCE" CURRENCY_UNIT_OBJECTS)

# I-028: an extractor that matched nothing declares an EMPTY bound, and an empty
# bound is met by a config/ with no accented byte in it at all - the state this
# repository was in before T-613. A bound nobody could read is not a bound that
# happens to be satisfied, so this is a FATAL and not a finding.
count_lines() { # <newline-separated list, possibly empty>
  if [ -z "$1" ]; then printf '0'; else printf '%s\n' "$1" | wc -l | tr -d '[:space:]'; fi
}
N_D033=$(count_lines "$BOUND_D033")
N_D047=$(count_lines "$BOUND_D047")
[ "${N_D033:-0}" -gt 0 ] \
  || fatal "NON_ASCII_OBJECTS in $BOUND_SOURCE yielded 0 entries (empty bound)"
[ "${N_D047:-0}" -gt 0 ] \
  || fatal "CURRENCY_UNIT_OBJECTS in $BOUND_SOURCE yielded 0 entries (empty bound)"

printf '%s\n%s\n' "$BOUND_D033" "$BOUND_D047" \
  | grep -v '^$' | LC_ALL=C sort -u > "$DECLARED_LIST"

# I-027: grep has THREE exit states. 1 is "no file matched", a real answer here;
# anything >= 2 is grep itself failing and must never read as zero.
NON_ASCII_RAW=$(LC_ALL=C grep -rlE "$(printf '[\200-\377]')" "$CONFIG_DIR" 2>/dev/null)
NON_ASCII_RC=$?
[ "$NON_ASCII_RC" -le 1 ] \
  || fatal "grep exited $NON_ASCII_RC scanning $CONFIG_DIR/ for a byte above 0x7F"
if [ -n "$NON_ASCII_RAW" ]; then
  printf '%s\n' "$NON_ASCII_RAW" \
    | sed "s|^$CONFIG_DIR/||; s|\.yml\$||" | LC_ALL=C sort > "$MEASURED_LIST"
else
  : > "$MEASURED_LIST"
fi

NON_ASCII=$(wc -l < "$MEASURED_LIST" | tr -d '[:space:]')
DECLARED_N=$(wc -l < "$DECLARED_LIST" | tr -d '[:space:]')
OVERLAP=$(( N_D033 + N_D047 - DECLARED_N ))

printf 'objects carrying a byte above 0x7F: %s\n' "${NON_ASCII:-0}"
printf 'non-ASCII bound declared: %s (NON_ASCII_OBJECTS %s + CURRENCY_UNIT_OBJECTS %s, %s named on both lists) read from %s\n' \
  "${DECLARED_N:-0}" "$N_D033" "$N_D047" "$OVERLAP" "$BOUND_SOURCE"

comm -23 "$MEASURED_LIST" "$DECLARED_LIST" | while IFS= read -r obj; do
  [ -n "$obj" ] || continue
  finding "$CONFIG_DIR/$obj.yml" "0" \
    "carries a byte above 0x7F and is on neither NON_ASCII_OBJECTS (D-033) nor CURRENCY_UNIT_OBJECTS (D-047) in $BOUND_SOURCE"
done
comm -13 "$MEASURED_LIST" "$DECLARED_LIST" | while IFS= read -r obj; do
  [ -n "$obj" ] || continue
  finding "$BOUND_SOURCE" "0" \
    "declares $obj as carrying a byte above 0x7F; $CONFIG_DIR/$obj.yml carries none, so the bound is wider than the config it bounds"
done

# T-321(b): defaulted because zero means FAIL here - the safe direction of
# I-031. Do not copy the `:-0` to a guard where zero means PASS.
if [ "${SCANNED:-0}" -eq 0 ]; then
  printf 'findings:   n/a\n'
  printf '\nFAILURE: 0 files scanned - an empty config/ proves nothing (I-007).\n'
  printf 'This is the tautology T-601 closed: RequirementsTest loops over\n'
  printf 'FileStorage::listAll() and passes vacuously when it returns nothing.\n'
  exit 1
fi

if [ "${OBJECTS:-0}" -eq 0 ]; then
  printf 'findings:   n/a\n'
  printf '\nFAILURE: %s file(s) under config/ and NOT ONE config object.\n' "$SCANNED"
  exit 1
fi

M=$(count_findings)
printf 'findings:   %s\n' "$M"

if [ "$M" -gt 0 ]; then
  printf '\n'
  cat "$FINDINGS_FILE"
  printf '\nFAILURE: %s config-inventory finding(s).\n' "$M"
  exit 1
fi

printf '\nOK: %s config object(s), all top-level, all non-empty.\n' "$OBJECTS"
exit 0
