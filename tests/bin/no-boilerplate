#!/usr/bin/env bash
#
# no-boilerplate - Agora - invariant: no starter kit boilerplate in what we publish.
#
# Origin (I-024): the `README.md` inherited from the Drupal CMS Site Template
# Starter Kit was PUBLISHED promising "a gorgeous theme that meets WCAG AAA
# standards" and describing a template "designed for professional electricians",
# with a broken link to `GET-STARTED.md`. It survived because no task owned the
# WHOLE file - T-112 owned one section of it - so the gate never lied, it was
# simply never asked. The same overpromise was also alive in the `description`
# fields of `composer.json` and `recipe.yml`, which are the strings the Drupal CMS
# installer puts in front of the user.
#
# Rider of [andres] 2026-08-21: this invariant runs after "a full initial sweep
# over config, demo content and descriptions - not just the README". That sweep
# was executed for T-309; its results are reported below in DELIBERATELY NOT
# DENY-LISTED.
#
# SCOPE - everything that gets published, in two passes:
#   (1) the packaged tree at HEAD: literally `git archive HEAD`, which is what
#       Drupal.org ships to end users;
#   (2) the working-tree copies of those same paths, so a reintroduction is
#       caught BEFORE it is committed.
# The process layer (specs/, .claude/, CLAUDE.md, tests/) is `export-ignore`d
# (D-015.2) and is therefore out of scope by construction, not by exclusion.
# That matters: `drupal_cms_site_template_base` appears legitimately in prose
# inside `specs/` and `IDIOMS.md`. If this script ever reports a hit there, the
# SCOPE is wrong and must be fixed - never add an exclusion for it.
#
# Contract:
#   - prints both scopes, the files scanned, the deny-list size and the findings
#   - every finding is reported as file:line with the offending line
#   - exit 0 ONLY if findings = 0
#   - a scope that cannot be read (no git, no HEAD) is a FAILURE, never a skip
#     (I-007: an exit 0 without counts proves nothing).
#
# Usage: tests/bin/no-boilerplate   (run from anywhere; it cd's to the repo root)

set -u
# No `set -e`: a finding must be recorded and reported, not abort the run.

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
cd "$REPO_ROOT" || { echo "FATAL: cannot cd to repo root $REPO_ROOT"; exit 1; }

C_OK=""; C_BAD=""; C_OFF=""; C_DIM=""
if [ -t 1 ]; then
  C_OK=$'\033[32m'; C_BAD=$'\033[31m'; C_OFF=$'\033[0m'; C_DIM=$'\033[2m'
fi

# ---------------------------------------------------------------- deny-list --
# Verbatim strings from the starter kit, matched case-insensitively as fixed
# strings. Each one is a phrase that describes a DIFFERENT product than Agora,
# or a placeholder the kit expects you to replace.
#
# FORBIDDEN: deleting a term from this list to turn the invariant green. A term
# leaves this list only when the string it guards can no longer be reintroduced,
# and that reasoning is recorded in specs/000-project/DECISIONS.md. Turning a
# gate green by shrinking its input is the failure mode this file exists to stop.
DENY_TERMS=$(cat <<'EOF'
electrician
WCAG AAA
GET-STARTED
MY_SITE_TEMPLATE_NAME
my-site-template
Site Template Starter Kit
my amazing site template
drupal_cms_site_template_base
EOF
)

TERM_COUNT=$(printf '%s\n' "$DENY_TERMS" | grep -cve '^$')

FINDINGS=0
SCANNED=0
BINARY=0
MISSING=0

printf '=========================================================================================================\n'
printf 'no-boilerplate - Agora - starter kit strings must not reach what we publish (I-024)\n'
printf 'repo: %s\n' "$REPO_ROOT"
printf '=========================================================================================================\n'

# ------------------------------------------------------- grep's third state --
# T-316 / I-027. `grep` has THREE exit states, not two: 0 = matched, 1 = no
# match, >= 2 = grep itself FAILED (invalid pattern, unreadable file, crash).
# This script inferred "no hit" from "no stdout", so a grep that could not run
# read exactly like a clean file - a scanner that cannot scan reporting that
# everything is fine. That is how an invalid eighth deny term could be counted
# in `deny-list terms: 8` while scanning with seven.
#
# The scanning greps run inside `printf ... | while ... done >> "$HITS_FILE"`,
# i.e. in a subshell whose stdout IS the findings file: an `exit` there would
# not stop this script, and a message printed there would be counted as a
# finding. So a failure is recorded in a marker file and announced on stderr,
# and assert_grep_ok() below turns it into a loud, non-zero abort before a
# single count is printed. Never a warning, never a finding: "the file was not
# searched" is not "the file is clean". GREP_ERR_FILE itself is created further
# down, together with HITS_FILE, so that the existing trap owns its cleanup;
# neither function below runs before that.
grep_failed() { # <rc> <pattern> <subject>
  printf 'grep exit %s on %s while matching: %s\n' "$1" "$3" "$2" >> "$GREP_ERR_FILE"
  printf 'FATAL: grep failed (exit %s) on %s while matching: %s\n' "$1" "$3" "$2" >&2
}

assert_grep_ok() {
  [ -s "$GREP_ERR_FILE" ] || return 0
  printf '\n%sFATAL:%s the scan did not complete - grep failed:\n' "$C_BAD" "$C_OFF"
  sed 's/^/  /' "$GREP_ERR_FILE"
  printf 'A file that could not be searched is NOT a file with no boilerplate in it.\n'
  printf 'This run has NO result, which is not a clean result. (T-316 / I-027)\n'
  exit 1
}

# --------------------------------------------------- deny-list preflight ------
# Every deny term is used as a BRE (see the scanner). An INVALID one - an
# unmatched `[`, a trailing `\` - does not over-match: grep refuses to compile
# it, exits 2 and prints nothing, which is indistinguishable from "no match"
# unless the status is read. The whole list is therefore compiled once, HERE, in
# the parent shell where an abort actually stops the run, against empty input so
# that only the pattern is under test.
BAD_TERMS=0
while IFS= read -r _t; do
  [ -n "$_t" ] || continue
  printf '' | grep -Iin -- "$_t" >/dev/null 2>&1
  _trc=$?
  if [ "$_trc" -ge 2 ]; then
    printf '\n%sFATAL:%s deny-list term is not a pattern grep can compile (exit %s): [%s]\n' \
      "$C_BAD" "$C_OFF" "$_trc" "$_t"
    BAD_TERMS=$((BAD_TERMS + 1))
  fi
done <<DENYCHECK
$DENY_TERMS
DENYCHECK
if [ "$BAD_TERMS" -gt 0 ]; then
  printf 'A term grep cannot compile scans NOTHING, while still being counted in\n'
  printf 'the deny-list size, so the run looks clean for a list it never actually applied.\n'
  printf 'Escape the metacharacter or remove the term. (T-316 / I-027)\n'
  exit 1
fi

# ------------------------------------------------------- resolve the scope ---
if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  printf '\n%sFATAL:%s no git HEAD - the packaged scope cannot be resolved.\n' "$C_BAD" "$C_OFF"
  printf 'A scope that cannot be read is a FAILURE, never a skip.\n'
  exit 1
fi

ARCHIVE_LIST=$(git archive --format=tar HEAD 2>/dev/null | tar -tf - 2>/dev/null)
ARCHIVE_RC=$?
if [ "$ARCHIVE_RC" -ne 0 ] || [ -z "$ARCHIVE_LIST" ]; then
  printf '\n%sFATAL:%s `git archive HEAD` produced nothing (exit %s).\n' "$C_BAD" "$C_OFF" "$ARCHIVE_RC"
  printf 'An empty archive would pass every "does not contain" check through the back door.\n'
  exit 1
fi

ENTRIES=$(printf '%s\n' "$ARCHIVE_LIST" | wc -l | tr -d ' ')
# Directory entries end in `/` and have no content to scan; files are the scope.
PACKAGED_FILES=$(printf '%s\n' "$ARCHIVE_LIST" | grep -v '/$')
FILE_COUNT=$(printf '%s\n' "$PACKAGED_FILES" | grep -cve '^$')

printf '\nscope resolved from `git archive HEAD` (%s):\n' "$(git rev-parse --short HEAD)"
printf '  %s%d tarball entries - %d files, %d directory entries%s\n' \
  "$C_DIM" "$ENTRIES" "$FILE_COUNT" "$((ENTRIES - FILE_COUNT))" "$C_OFF"
printf '%s\n' "$PACKAGED_FILES" | sed 's/^/    /'

# ----------------------------------------------------------------- scanner ---
# scan_one <display-label> <file-with-content>
# Reports every deny-list hit as `label:line: term` plus the offending line.
scan_one() {
  _label=$1; _file=$2
  grep -Iq . "$_file" 2>/dev/null
  _brc=$?
  # rc 1 = binary or empty, which is a real answer and is counted as such.
  # rc >= 2 was counted as "binary" too: a file silently dropped from the scan.
  [ "$_brc" -ge 2 ] && grep_failed "$_brc" "<non-empty-line test: the text/binary probe>" "$_file"
  if [ "$_brc" -ne 0 ]; then
    BINARY=$((BINARY + 1))
    return
  fi
  SCANNED=$((SCANNED + 1))
  printf '%s\n' "$DENY_TERMS" | grep -ve '^$' | while IFS= read -r _term; do
    # No `-F` here (I-027): GNU grep 3.0, which ships with Git for Windows/MSYS2,
    # SIGABRTs whenever `-F` and `-i` are combined - bisected on this host as
    # `-Fin`/`-IFin` -> rc=134, `-Iin` -> rc=0 with the correct hit. `-i` itself
    # is not optional: the deny list is matched case-insensitively by design
    # ("WCAG AAA" must also catch "wcag aaa"). Consequence: terms are now BRE,
    # not fixed strings, and a deny term carrying a regex metacharacter falls
    # into one of TWO cases. T-315 recorded only the first and called it "the
    # safe direction"; that claim was true of the first case and false of the
    # second, which is the one that bites (T-316):
    #
    #   VALID BRE - `.`, `*`, `\{2\}`: the term over-matches instead of matching
    #   literally. A false POSITIVE: the safe direction, loud, and unable to
    #   hide a boilerplate string.
    #
    #   INVALID BRE - `[unclosed`, a trailing `\`: grep does not over-match, it
    #   refuses to compile the pattern. It exits 2 and prints nothing, which is
    #   indistinguishable from "no match" unless the exit status is read. A
    #   false NEGATIVE: the UNSAFE direction, and silent - the term is counted
    #   in `deny-list terms: N` while nothing is scanned with it.
    #
    # Hence both defences: the deny-list preflight above compiles every term
    # before the scan starts, and the exit status below is read on every file.
    # None of the seven terms above contains a metacharacter; whoever adds an
    # eighth must keep that true or escape it - and if they do not, the run
    # aborts instead of reporting `findings: 0`.
    _out=$(grep -Iin -- "$_term" "$_file" 2>/dev/null)
    _grc=$?
    if [ "$_grc" -ge 2 ]; then
      grep_failed "$_grc" "$_term" "$_file"
      continue
    fi
    # Without this guard an empty result would be printed as one blank hit line
    # and counted as a finding.
    [ -n "$_out" ] || continue
    printf '%s\n' "$_out" | while IFS= read -r _hit; do
      printf '%s|%s|%s\n' "$_label" "$_term" "$_hit"
    done
  done
}

# Findings are collected in a file: the `while` loops above run in subshells, so
# a counter incremented inside them would be lost. I-007: a count that silently
# resets to 0 is worse than no count at all.
HITS_FILE=$(mktemp -t no-boilerplate.XXXXXX) || exit 1
WORK_DIR=$(mktemp -d -t no-boilerplate.XXXXXX) || exit 1
GREP_ERR_FILE=$(mktemp -t no-boilerplate-grep.XXXXXX) || exit 1
trap 'rm -rf -- "$HITS_FILE" "$WORK_DIR" "$GREP_ERR_FILE"' EXIT INT TERM

# --------------------------------------------- pass 1: packaged tree at HEAD --
printf '\n-- pass 1: packaged tree at HEAD (what Drupal.org ships) ------------------------------------------------\n'
printf '%s\n' "$PACKAGED_FILES" | grep -ve '^$' | while IFS= read -r f; do
  _tmp="$WORK_DIR/head_$(printf '%s' "$f" | tr '/' '_')"
  if git show "HEAD:$f" > "$_tmp" 2>/dev/null; then
    scan_one "HEAD:$f" "$_tmp"
  else
    printf 'UNREADABLE|-|%s\n' "$f"
  fi
done >> "$HITS_FILE"

# ------------------------------------- pass 2: working copies of those paths --
printf -- '-- pass 2: working copies of the same paths (catch it before the commit) ---------------------------------\n'
printf '%s\n' "$PACKAGED_FILES" | grep -ve '^$' | while IFS= read -r f; do
  if [ -f "$f" ]; then
    scan_one "WORKTREE:$f" "$f"
  else
    printf 'DELETED|-|%s\n' "$f"
  fi
done >> "$HITS_FILE"

# Recount in the parent shell: the subshell counters above did not survive.
SCANNED=0
BINARY=0
for f in $(printf '%s\n' "$PACKAGED_FILES" | grep -ve '^$'); do
  _tmp="$WORK_DIR/head_$(printf '%s' "$f" | tr '/' '_')"
  # Written as separate statements rather than `[ -f ] && grep -Iq`, because the
  # `&&` form throws grep's exit status away and cannot tell rc 1 (binary) from
  # rc >= 2 (grep failed) - which is how an unscannable file used to be counted
  # as a scanned-and-clean one.
  if [ -f "$_tmp" ]; then
    grep -Iq . "$_tmp" 2>/dev/null
    _rc=$?
    [ "$_rc" -ge 2 ] && grep_failed "$_rc" "<non-empty-line test: the text/binary probe>" "$_tmp"
    if [ "$_rc" -eq 0 ]; then SCANNED=$((SCANNED + 1)); else BINARY=$((BINARY + 1)); fi
  else
    BINARY=$((BINARY + 1))
  fi
  if [ -f "$f" ]; then
    grep -Iq . "$f" 2>/dev/null
    _rc=$?
    [ "$_rc" -ge 2 ] && grep_failed "$_rc" "<non-empty-line test: the text/binary probe>" "$f"
    if [ "$_rc" -eq 0 ]; then SCANNED=$((SCANNED + 1)); else BINARY=$((BINARY + 1)); fi
  else
    MISSING=$((MISSING + 1))
  fi
done

# Before the findings block and the counts: any grep that failed - in this shell
# or in either scanning subshell - stops the run here, loudly.
assert_grep_ok

# ------------------------------------------------------- I-007 self-guard ----
# Every count above is built from PACKAGED_FILES, which is filtered out of the
# archive listing by a bare `grep -v '/$'` (line 158) that never checks its own
# exit status. On rc >= 2 that filter prints nothing, PACKAGED_FILES is empty,
# both scanning passes and the recount above iterate zero times, and SCANNED
# reaches 0 without a single grep_failed() ever firing - assert_grep_ok has
# nothing to report, because nothing was ever told to report. `no-boilerplate`
# was the only one of the seven invariants without this guard, even though the
# CONTRACT at the top of this file already promises it. Match the other six:
# SCANNED == 0 is a FAILURE, never a clean run over nothing (I-007).
if [ "$SCANNED" -eq 0 ]; then
  printf '\n%sFATAL:%s scanned 0 files - the scope collapsed to nothing.\n' "$C_BAD" "$C_OFF"
  printf 'A scan of nothing is not a clean result (I-007).\n'
  exit 1
fi

# The other half of the same degenerate scope (T-320a): this invariant's scope
# is files x terms, and TERM_COUNT - fixed at parse time from the DENY_TERMS
# heredoc above, never touched by the scan itself - can collapse to zero just
# as SCANNED can. A run with no terms would still scan every file, find
# nothing to match anything against, and print `deny-list terms: 0 - findings:
# 0`, exit 0 - a clean-looking result for a scan that had nothing to look for.
# TERM_COUNT == 0 is a FAILURE for the same reason SCANNED == 0 is (I-007).
if [ "$TERM_COUNT" -eq 0 ]; then
  printf '\n%sFATAL:%s deny-list terms: 0 - the scope collapsed to nothing.\n' "$C_BAD" "$C_OFF"
  printf 'A scan with no deny-list terms is not a clean result (I-007).\n'
  exit 1
fi

# ---------------------------------------------------------------- findings ---
# T-316 / I-027, second bite: `grep -cve '^$' "$HITS_FILE" || FINDINGS=0` fixed
# the concatenation bug but kept the `||` itself, which still turns a grep that
# FAILED (rc >= 2: this grep is not one of the call sites assert_grep_ok covers)
# into "zero findings" - indistinguishable from a grep that legitimately matched
# nothing. `wc -l` has no third exit state to swallow: it counts the newlines in
# HITS_FILE or it does not run, full stop. This is count_findings() from
# no-patches / no-unstable-deps / sbom-check, applied here to HITS_FILE.
FINDINGS=$(wc -l < "$HITS_FILE" | tr -d '[:space:]')

printf '\n-- findings ---------------------------------------------------------------------------------------------\n'
if [ "$FINDINGS" -eq 0 ]; then
  printf '  %snone%s\n' "$C_OK" "$C_OFF"
else
  while IFS='|' read -r _label _term _hit; do
    [ -z "$_label" ] && continue
    printf '  %sBOILERPLATE%s  %s  [%s]\n' "$C_BAD" "$C_OFF" "$_label" "$_term"
    printf '      | %s\n' "$_hit"
  done < "$HITS_FILE"
fi

# ------------------------------------------------------------------ counts ---
printf '\n=========================================================================================================\n'
printf 'scope: packaged tree (%d entries) + their working copies - scanned: %d - deny-list terms: %d - findings: %d\n' \
  "$ENTRIES" "$SCANNED" "$TERM_COUNT" "$FINDINGS"
if [ "$BINARY" -gt 0 ] || [ "$MISSING" -gt 0 ]; then
  printf '%s(skipped: %d binary blob(s); %d packaged path(s) absent from the working tree)%s\n' \
    "$C_DIM" "$BINARY" "$MISSING" "$C_OFF"
fi
printf '=========================================================================================================\n'

[ "$FINDINGS" -eq 0 ] && exit 0
exit 1
