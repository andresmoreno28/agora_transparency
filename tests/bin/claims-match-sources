#!/usr/bin/env bash
#
# claims-match-sources - Agora - fails when a number CLAUDE.md states about the
# gate disagrees with the thing in THIS repository that the number is about.
#
# WHY IT EXISTS. CLAUDE.md's Gate A block warns, in its own words, that "a
# number written down twice is a number that goes stale in one place first",
# and on 2026-09-06 that block was the example: it claimed 48 checks where the
# wave-3 runner printed 49, an 18-test theme suite that had grown to 102, a
# six-page axe gate that scanned seven, spellcheck denominators 20 files
# behind, and - the expensive one - that `phpcs` "cannot be run on this host",
# which is false and had been hiding real findings on both branches. Six stale
# claims, all in a block whose own rule is that every figure is a dated
# measurement. Prose cannot keep that promise on its own; this is the machine
# that keeps the checkable half of it.
#
# THE NAME IS NOT THE ONE THE TASK PROPOSED, and the difference is the point.
# `claims-match-reality` would claim more than it can deliver, in exactly the
# way the file it guards did: this script never reaches reality. It reaches the
# repository. It cannot see a pipeline, a job trace, an assertion count or an
# axe run, and it says so by name on every run rather than letting a green imply
# coverage it does not have.
#
# ---------------------------------------------------------------------------
# WHAT IS CHECKED - seven comparisons, all offline, all in under a second:
#
#   wave1_checks           CLAUDE.md          vs  the GATE-CLAIM line in gate-a-wave1.sh
#   wave3_checks           CLAUDE.md          vs  the GATE-CLAIM line in gate-a-wave3.sh
#   invariants             CLAUDE.md          vs  both GATE-CLAIM lines, summed
#   invariants_structural  wave 3's GATE-CLAIM vs that runner's `group 'GN'` lines
#   template_jobs          CLAUDE.md's table  vs  EXPECTED_agora_transparency in watch-gate
#   theme_jobs             CLAUDE.md's table  vs  EXPECTED_agora_theme in watch-gate
#   floor                  CLAUDE.md          vs  the shorter of those two lists
#
# FIVE OF THE SEVEN COMPARE PROSE AGAINST PROSE, and pretending otherwise would
# be the same defect one layer up. A GATE-CLAIM line is a declaration a human
# writes; it is not the runner's output. What makes the chain worth having is
# that the declaration sits in the file it describes, three lines from the
# arithmetic that derives it, so the commit that moves a count has to walk past
# it - whereas CLAUDE.md is a different file that nobody re-opens. Two of the
# seven are stronger than that: `invariants_structural` counts the runner's
# actual group declarations, and the two job-list comparisons read the array
# `watch-gate` executes against the live API.
#
# THE GAP THAT REMAINS, stated rather than left to be discovered: nothing here
# proves a GATE-CLAIM line matches what its runner PRINTS. Closing it needs the
# runners to assert their own declared total against the total they counted -
# one line each, and worth doing - but that is a change to both runners and is
# not this script's to make.
#
# WHAT IS NOT CHECKED is printed by name on every run, and the gate asserts that
# the list is non-empty. A guard that silently covers half its subject is the
# shape that let three stylelint findings cross a green local check; the
# uncovered half has to be as visible as the covered one.
#
# ---------------------------------------------------------------------------
# AMBIGUITY IS A FAILURE, NOT A TIE-BREAK. Every scalar claim must match its
# pattern EXACTLY ONCE in CLAUDE.md. A second copy of the wave-1 check count is
# refused here instead of being silently preferred over the first, because two
# copies of a number is the precondition for the drift this file exists to
# catch. The gate floor is the one deliberate exception - the file quotes
# D-023(5) verbatim and strikes two superseded amendments - and its rule is
# stated in the extractor that applies it.
#
# A missing pattern is likewise a FATAL and never a pass: a regex that matches
# nothing prints "0 findings" exactly like a clean tree (I-028).
#
# Contract:
#   claims extracted:  <N>   - numbers and lists read out of CLAUDE.md
#   comparisons:       <N>   - must be > 0
#   NOT CHECKED:       <N>   - each named, with why
#   mismatches:        <M>
#   exit 0 iff M == 0 and no FATAL
#
# House rules for tests/bin/ (T-321(c)): `wc -l` never `grep -c` for a compared
# value; numeric guards defaulted ONLY where zero means FAIL; grep rc >= 2 is an
# error, never "no match"; never `-F` with `-i`. The CANONICAL copy of the block
# lives in the header of tests/bin/no-ci-allow-dev.
#
# Usage: tests/bin/claims-match-sources   (run from anywhere; it cd's to root)

set -u
# No `set -e`: a mismatch must be recorded and counted, not abort the run.

# `CDPATH= cd` is an env-var prefix, not an assignment; shellcheck misreads it.
# shellcheck disable=SC1007
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1007
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
cd "$REPO_ROOT" || { echo "FATAL: cannot cd to repo root $REPO_ROOT"; exit 1; }

C_BAD=""; C_DIM=""; C_OFF=""
if [ -t 1 ]; then
  C_BAD=$(printf '\033[31m'); C_DIM=$(printf '\033[2m'); C_OFF=$(printf '\033[0m')
fi

fatal() { printf 'FATAL: %s\n' "$1" >&2; exit 1; }

# ---------------------------------------------------------------- preflight --
command -v python3 >/dev/null 2>&1 || fatal "required tool not found: python3"
# I-026: python3 can RESOLVE and still be a Microsoft Store stub that fails at
# first real use. Exercise it, do not merely locate it.
python3 -c 'pass' >/dev/null 2>&1 || fatal "python3 resolves but does not run"

READER="$SCRIPT_DIR/claims-match-sources.py"
[ -f "$READER" ] || fatal "reader not found: $READER"
[ -r "$READER" ] || fatal "reader is not readable: $READER"

for required in CLAUDE.md tests/bin/gate-a-wave1.sh tests/bin/gate-a-wave3.sh \
                tests/bin/watch-gate; do
  [ -f "$required" ] || fatal "$required not found in $REPO_ROOT (empty scope)"
done

OUT_FILE=$(mktemp -t claims-match-sources.XXXXXX) || fatal "cannot create a temp file"
trap 'rm -f "$OUT_FILE"' EXIT

# The reader's exit status is read, not inferred from its output: an extractor
# that did not run is not an extractor that found nothing (I-027).
READ_RC=0
python3 "$READER" > "$OUT_FILE" 2>&1 || READ_RC=$?

printf '\nclaims-match-sources - CLAUDE.md against the sources in this repository\n\n'

# record <TAG> -> the matching lines, or a sentinel naming a grep failure.
records() {
  _matched=$(grep -E "^$1	" "$OUT_FILE" 2>/dev/null)
  _rc=$?
  [ "$_rc" -ge 2 ] && fatal "grep failed (exit $_rc) reading the $1 records"
  [ "$_rc" -eq 0 ] || return 0
  printf '%s\n' "$_matched"
}

count_of() {
  _out=$(grep -E "^COUNT	$1	[0-9]+$" "$OUT_FILE" 2>/dev/null)
  _rc=$?
  [ "$_rc" -ge 2 ] && fatal "grep failed (exit $_rc) reading the COUNT record $1"
  [ "$_rc" -eq 0 ] || return 0
  printf '%s' "$_out" | tail -1 | cut -f3
}

FATAL_COUNT=$(count_of fatal_count)
EXTRACTED=$(count_of claims_extracted)
COMPARED=$(count_of comparisons)
UNCHECKED=$(count_of unchecked)
MISMATCHES=$(count_of mismatches)

for pair in "fatal_count:$FATAL_COUNT" "claims_extracted:$EXTRACTED" \
            "comparisons:$COMPARED" "unchecked:$UNCHECKED" \
            "mismatches:$MISMATCHES"; do
  case "${pair#*:}" in
    '') fatal "the reader printed no ${pair%%:*} count - its summary is unreadable (exit $READ_RC)" ;;
  esac
done

# ------------------------------------------------------------------ report --
printf 'scope:      CLAUDE.md, against gate-a-wave1.sh, gate-a-wave3.sh and watch-gate\n'
printf 'claims extracted from CLAUDE.md: %s\n' "$EXTRACTED"
printf 'comparisons: %s\n' "$COMPARED"

records CMP | while IFS=$(printf '\t') read -r _tag name verdict claimed source note; do
  if [ "$verdict" = OK ]; then
    printf '  %-24s %-8s %s\n' "$name" "$verdict" "$note"
  else
    printf '  %s%-24s %-8s %s%s\n' "$C_BAD" "$name" "$verdict" "$note" "$C_OFF"
    # Neutral labels, not "CLAUDE.md says". Six of the seven comparisons do have
    # CLAUDE.md on the left, but `invariants_structural` has a GATE-CLAIM line
    # there - and a mismatch report that names the wrong file sends the reader to
    # edit the wrong one. Which two things were compared is in the note above.
    printf '      claimed: %s\n' "$claimed"
    printf '      source:  %s\n' "$source"
  fi
done

printf '\nNOT CHECKED - %s quantities CLAUDE.md states that nothing in this\n' "$UNCHECKED"
printf 'repository can confirm. Named every run, because a guard that covers\n'
printf 'half its subject in silence reads exactly like one that covers all of it:\n'
records UNCHECKED | while IFS=$(printf '\t') read -r _tag name why; do
  printf '  %s- %s%s\n' "$C_DIM" "$name" "$C_OFF"
  printf '    %s%s%s\n' "$C_DIM" "$why" "$C_OFF"
done

printf '\nmismatches: %s\n' "$MISMATCHES"

# I-028, applied to this script's own denominators: zero comparisons or zero
# named exclusions would print "mismatches: 0" and pass by construction. Both
# are asserted before any verdict is reported.
if [ "${COMPARED:-0}" -eq 0 ]; then
  printf '\nFAILURE: 0 comparisons were made - an empty scope proves nothing (I-007).\n'
  exit 1
fi
if [ "${UNCHECKED:-0}" -eq 0 ]; then
  printf '\nFAILURE: the NOT CHECKED list is empty. This script cannot reach a CI\n'
  printf 'trace, so an empty list is a deleted list, not full coverage (I-028).\n'
  exit 1
fi

if [ "${FATAL_COUNT:-0}" -gt 0 ]; then
  printf '\n'
  records FATAL | while IFS=$(printf '\t') read -r _tag why; do
    printf '  %s%s%s\n' "$C_BAD" "$why" "$C_OFF"
  done
  printf '\nFAILURE: %s extractor(s) found nothing to read. This run has NO result,\n' "$FATAL_COUNT"
  printf 'which is not a clean result (I-027). Fix the extractor or the claim; do\n'
  printf 'not delete the check to get back to green.\n'
  exit 1
fi

if [ "${MISMATCHES:-0}" -gt 0 ]; then
  printf '\nFAILURE: %s claim(s) in CLAUDE.md disagree with this repository. The\n' "$MISMATCHES"
  printf 'remedy is to re-measure and update CLAUDE.md in the commit that moved the\n'
  printf 'number - never to change the source to match the prose.\n'
  exit 1
fi

printf '\nOK: every checkable number in CLAUDE.md agrees with its source here.\n'
exit 0
