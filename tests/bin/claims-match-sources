#!/usr/bin/env bash
#
# claims-match-sources - Agora - fails when a number CLAUDE.md states about the
# gate disagrees with the thing the number is about: in this repository always,
# and - with --online - in the CI job trace that produced it.
#
# WHY IT EXISTS. CLAUDE.md's Gate A block warns, in its own words, that "a
# number written down twice is a number that goes stale in one place first",
# and on 2026-09-06 that block was the example: it claimed 48 checks where the
# wave-3 runner printed 49, an 18-test theme suite that had grown to 102, a
# six-page axe gate that scanned seven, spellcheck denominators 20 files
# behind, and - the expensive one - that `phpcs` "cannot be run on this host",
# which is false and had been hiding real findings on both branches. Six stale
# claims, all in a block whose own rule is that every figure is a dated
# measurement. Prose cannot keep that promise on its own; this is the machine
# that keeps it.
#
# THE NAME IS NOT THE ONE THE TASK PROPOSED, and the difference is the point.
# `claims-match-reality` would claim more than it can deliver, in exactly the
# way the file it guards did. The original reasoning ran: "this script never
# reaches reality. It reaches the repository. It cannot see a pipeline, a job
# trace, an assertion count or an axe run, and it says so by name on every run
# rather than letting a green imply coverage it does not have."
#
# ⚠️ SUPERSEDED IN ITS FACTS ON 2026-09-20 AND KEPT FOR ITS ARGUMENT, which is
# the more useful half and which survives intact. With --online this script DOES
# see a pipeline, a job trace, an assertion count and an axe run - because the
# sentence claiming it could not was never measured. It was reasoned from the
# API endpoint answering 401, and nobody tried the web route that answers 200 to
# anybody. So the name is still right and the modesty was still correct as a
# policy: the list of what a guard cannot reach has to be re-read, not
# inherited, or it becomes a list of what nobody has tried lately.
#
# ---------------------------------------------------------------------------
# WHAT IS CHECKED OFFLINE - ten comparisons, all in under a second:
#
#   wave1_checks           CLAUDE.md          vs  the GATE-CLAIM line in gate-a-wave1.sh
#   wave3_checks           CLAUDE.md          vs  the GATE-CLAIM line in gate-a-wave3.sh
#   invariants             CLAUDE.md          vs  both GATE-CLAIM lines, summed
#   invariants_structural  wave 3's GATE-CLAIM vs that runner's `group 'GN'` lines
#   template_jobs          CLAUDE.md's table  vs  EXPECTED_agora_transparency in watch-gate
#   theme_jobs             CLAUDE.md's table  vs  EXPECTED_agora_theme in watch-gate
#   floor                  CLAUDE.md          vs  the shorter of those two lists
#   mirror_workflows       .github/workflows/ vs  MIRROR_WORKFLOWS in watch-gate
#   template_trace_jobs    the jobs the trace-figures table names vs the job table
#   theme_trace_jobs       the same, for the theme
#
# WHAT IS CHECKED WITH --online - fifteen more, read from the CI job traces
# themselves, and never during a gate run. Per repository: the pipeline the
# table NAMES is fetched and its ref and commit compared against the bullet's;
# its whole job table - name, stage, status, allow_failure - is compared against
# the four columns CLAUDE.md prints; and every row of the trace-figures table is
# looked for in that job's own log.
#
# ---------------------------------------------------------------------------
# WHY THE ONLINE HALF EXISTS, dated 2026-09-20, and it is a correction rather
# than an addition. This script used to print NINE quantities as unreachable.
# TWO OF THOSE REASONS WERE FALSE, and had been for weeks:
#
#   /api/v4/projects/<id>/jobs/<id>/trace   ->  401, 30 bytes, anonymously
#   /project/<name>/-/jobs/<id>/raw         ->  302 -> 200, the WHOLE log
#
# The web route needs no credential at all. `-L` is mandatory: without it the
# 302 is 622 bytes and looks exactly like a failure. So "only in a CI job trace"
# was true and "therefore unreadable" was not, and "needs Chrome to reproduce"
# confused REPRODUCING an axe run with READING what one printed.
#
# It cost real staleness twice on the day it was found, both caught by a human
# reading rather than by a gate: CLAUDE.md stated `OK (20 tests, 2549
# assertions)` where the gate printed 21/2555, and the site template's observed
# inventory stood NINE DAYS and eight pipelines behind. The second one is the
# instructive one: the offline half compares job NAMES, the names had not
# changed, and so A STALE OBSERVATION OF AN UNCHANGED LIST WAS INVISIBLE TO A
# CHECK THAT COMPARES LISTS. `--online` compares the stage, the status, the
# allow_failure flag, the ref, the commit and the figures, which do move.
#
# --online IS OPT-IN AND THE GATE NEVER PASSES IT. This script is wired into
# gate-a-wave1.sh precisely because it is offline and fast; a gate that needs
# the network is a gate somebody makes permissive within the week - the exact
# shape D-023(5) exists to refuse, arriving through the door marked "more
# rigour". Its absence is therefore a THIRD STATE, printed by name for every
# item it covers, and it can never read as agreement.
#
# WHICH PIPELINE IS READ: the one each table NAMES, never "the newest".
# CLAUDE.md's own convention is that a table records a named, complete
# observation, and the file says in as many words that "a job list read
# mid-pipeline is not the gate". Reading the tip would compare today's prose
# against something nobody observed. A pipeline that has not reached a terminal
# state is NOT READ, not a failure. The tip is tests/bin/watch-gate's subject
# and is named in the NOT CHECKED list below.
#
# ---------------------------------------------------------------------------
# WHY A GITHUB ROW APPEARS IN A FILE THAT CANNOT REACH GITHUB, 2026-09-19. The
# mirror's only workflow had failed on nine consecutive runs over three weeks
# with nothing in this repository reading it, and this script's NOT CHECKED list
# named eight quantities of which NONE was GitHub - so the mirror was absent from
# the covered half and from the named-uncovered half at once, which is the worst
# of the three places a subject can be. The conclusion itself is read by
# tests/bin/watch-gate; what is checkable here is that every workflow on the
# mirror is one watch-gate has been told to read, and that is the row above.
#
# THE GAP THAT REMAINS, stated rather than left to be discovered: nothing here
# proves a GATE-CLAIM line matches what its runner PRINTS. Closing it needs the
# runners to assert their own declared total against the total they counted -
# one line each, and worth doing - but that is a change to both runners and is
# not this script's to make.
#
# WHAT IS NOT CHECKED is printed by name on every run, and the gate asserts that
# the list is non-empty. A guard that silently covers half its subject is the
# shape that let three stylelint findings cross a green local check; the
# uncovered half has to be as visible as the covered one.
#
# ---------------------------------------------------------------------------
# AMBIGUITY IS A FAILURE, NOT A TIE-BREAK. Every scalar claim must match its
# pattern EXACTLY ONCE in CLAUDE.md. A second copy of the wave-1 check count is
# refused here instead of being silently preferred over the first, because two
# copies of a number is the precondition for the drift this file exists to
# catch. The gate floor is the one deliberate exception - the file quotes
# D-023(5) verbatim and strikes two superseded amendments - and its rule is
# stated in the extractor that applies it. The same rule holds over a TRACE: a
# log printing two different values of one figure's shape is an ambiguous
# measurement, and an ambiguous measurement is not a measurement.
#
# A missing pattern is likewise a FATAL and never a pass: a regex that matches
# nothing prints "0 findings" exactly like a clean tree (I-028).
#
# Contract:
#   claims extracted:  <N>   - numbers and lists read out of CLAUDE.md
#   comparisons:       <N>   - offline; must be > 0
#   trace figures:     <N>   - rows in the two trace-figures tables; must be > 0
#   online:            read <N> of <M>, NOT READ <K>   (only with --online)
#   NOT CHECKED:       <N>   - each named, with why; must be > 0
#   mismatches:        <M>   - offline and online together
#   exit 0 iff M == 0, no FATAL, and --online (if given) read at least one item
#
# House rules for tests/bin/ (T-321(c)): `wc -l` never `grep -c` for a compared
# value; numeric guards defaulted ONLY where zero means FAIL; grep rc >= 2 is an
# error, never "no match"; never `-F` with `-i`. The CANONICAL copy of the block
# lives in the header of tests/bin/no-ci-allow-dev.
#
# Usage: tests/bin/claims-match-sources [--online]   (run from anywhere)

set -u
# No `set -e`: a mismatch must be recorded and counted, not abort the run.

# `CDPATH= cd` is an env-var prefix, not an assignment; shellcheck misreads it.
# shellcheck disable=SC1007
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1007
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
cd "$REPO_ROOT" || { echo "FATAL: cannot cd to repo root $REPO_ROOT"; exit 1; }

C_BAD=""; C_DIM=""; C_OFF=""
if [ -t 1 ]; then
  C_BAD=$(printf '\033[31m'); C_DIM=$(printf '\033[2m'); C_OFF=$(printf '\033[0m')
fi

fatal() { printf 'FATAL: %s\n' "$1" >&2; exit 1; }

ONLINE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --online) ONLINE=1 ;;
    *) fatal "unknown argument: $1 (usage: claims-match-sources [--online])" ;;
  esac
  shift
done

# ---------------------------------------------------------------- preflight --
command -v python3 >/dev/null 2>&1 || fatal "required tool not found: python3"
# I-026: python3 can RESOLVE and still be a Microsoft Store stub that fails at
# first real use. Exercise it, do not merely locate it.
python3 -c 'pass' >/dev/null 2>&1 || fatal "python3 resolves but does not run"

READER="$SCRIPT_DIR/claims-match-sources.py"
[ -f "$READER" ] || fatal "reader not found: $READER"
[ -r "$READER" ] || fatal "reader is not readable: $READER"

for required in CLAUDE.md tests/bin/gate-a-wave1.sh tests/bin/gate-a-wave3.sh \
                tests/bin/watch-gate; do
  [ -f "$required" ] || fatal "$required not found in $REPO_ROOT (empty scope)"
done

OUT_FILE=$(mktemp -t claims-match-sources.XXXXXX) || fatal "cannot create a temp file"
trap 'rm -f "$OUT_FILE"' EXIT

# The reader's exit status is read, not inferred from its output: an extractor
# that did not run is not an extractor that found nothing (I-027).
READ_RC=0
if [ "$ONLINE" -eq 1 ]; then
  python3 "$READER" --online > "$OUT_FILE" 2>&1 || READ_RC=$?
else
  python3 "$READER" > "$OUT_FILE" 2>&1 || READ_RC=$?
fi

printf '\nclaims-match-sources - CLAUDE.md against the sources in this repository\n\n'

# record <TAG> -> the matching lines, or a sentinel naming a grep failure.
records() {
  _matched=$(grep -E "^$1	" "$OUT_FILE" 2>/dev/null)
  _rc=$?
  [ "$_rc" -ge 2 ] && fatal "grep failed (exit $_rc) reading the $1 records"
  [ "$_rc" -eq 0 ] || return 0
  printf '%s\n' "$_matched"
}

count_of() {
  _out=$(grep -E "^COUNT	$1	[0-9]+$" "$OUT_FILE" 2>/dev/null)
  _rc=$?
  [ "$_rc" -ge 2 ] && fatal "grep failed (exit $_rc) reading the COUNT record $1"
  [ "$_rc" -eq 0 ] || return 0
  printf '%s' "$_out" | tail -1 | cut -f3
}

FATAL_COUNT=$(count_of fatal_count)
EXTRACTED=$(count_of claims_extracted)
COMPARED=$(count_of comparisons)
FIGURES=$(count_of trace_figures)
ONLINE_ITEMS=$(count_of online_items)
ONLINE_READ=$(count_of online_read)
ONLINE_NOT_READ=$(count_of online_not_read)
UNCHECKED=$(count_of unchecked)
MISMATCHES=$(count_of mismatches)

for pair in "fatal_count:$FATAL_COUNT" "claims_extracted:$EXTRACTED" \
            "comparisons:$COMPARED" "trace_figures:$FIGURES" \
            "online_items:$ONLINE_ITEMS" "online_read:$ONLINE_READ" \
            "online_not_read:$ONLINE_NOT_READ" "unchecked:$UNCHECKED" \
            "mismatches:$MISMATCHES"; do
  case "${pair#*:}" in
    '') fatal "the reader printed no ${pair%%:*} count - its summary is unreadable (exit $READ_RC)" ;;
  esac
done

# ------------------------------------------------------------------ report --
printf 'scope:      CLAUDE.md, against gate-a-wave1.sh, gate-a-wave3.sh and watch-gate\n'
if [ "$ONLINE" -eq 1 ]; then
  printf '            plus, with --online, the CI job traces the two tables name\n'
fi
printf 'claims extracted from CLAUDE.md: %s\n' "$EXTRACTED"
printf 'trace figures claimed:           %s\n' "$FIGURES"
printf 'comparisons: %s  (offline)\n' "$COMPARED"

show_comparisons() {
  records "$1" | while IFS=$(printf '\t') read -r _tag name verdict claimed source note; do
    if [ "$verdict" = OK ]; then
      printf '  %-26s %-8s %s\n' "$name" "$verdict" "$note"
    else
      printf '  %s%-26s %-8s %s%s\n' "$C_BAD" "$name" "$verdict" "$note" "$C_OFF"
      # Neutral labels, not "CLAUDE.md says". Most comparisons do have CLAUDE.md
      # on the left, but `invariants_structural` and `mirror_workflows` do not -
      # and a mismatch report that names the wrong file sends the reader to edit
      # the wrong one. Which two things were compared is in the note above.
      printf '      claimed: %s\n' "$claimed"
      printf '      source:  %s\n' "$source"
    fi
  done
}

show_comparisons CMP

# ------------------------------------------------------------ the online half --
# The THIRD STATE lives here. Not asked for, asked for and unreachable, asked for
# and the pipeline is still running: each says so in its own words. None of them
# may read as "the figures agree", because an absence of information reading as
# good news for three weeks is the defect this whole section was built after.
printf '\nonline (CI job traces) - '
if [ "$ONLINE" -eq 1 ]; then
  printf 'read %s of %s items, NOT READ %s\n' \
    "$ONLINE_READ" "$ONLINE_ITEMS" "$ONLINE_NOT_READ"
  show_comparisons ONLINE
  if [ "${ONLINE_NOT_READ:-0}" -gt 0 ]; then
    printf '\n  NOT READ - asked for over the network and not obtained. This is\n'
    printf '  neither an agreement nor a disagreement, and it is never a pass:\n'
    records NOT_READ | while IFS=$(printf '\t') read -r _tag name why; do
      printf '    %s- %s%s\n' "$C_DIM" "$name" "$C_OFF"
      printf '      %s%s%s\n' "$C_DIM" "$why" "$C_OFF"
    done
  fi
else
  printf 'NOT ATTEMPTED.\n'
  printf '  This run passed no --online, so the figures CLAUDE.md quotes from CI job\n'
  printf '  traces - assertion totals, the axe denominators, the install smoke and the\n'
  printf '  version it resolves, the sibling gate'"'"'s check count - were compared against\n'
  printf '  NOTHING. That is not "the figures are fine"; it is "nothing here looked".\n'
  printf '  The gate runs it this way on purpose: this script is in gate-a-wave1.sh\n'
  printf '  because it is offline and fast. Read them with:\n'
  printf '      bash tests/bin/claims-match-sources --online\n'
fi

printf '\nNOT CHECKED - %s quantities CLAUDE.md states that nothing here can confirm,\n' "$UNCHECKED"
printf 'with or without the network. Named every run, because a guard that covers\n'
printf 'half its subject in silence reads exactly like one that covers all of it:\n'
records UNCHECKED | while IFS=$(printf '\t') read -r _tag name why; do
  printf '  %s- %s%s\n' "$C_DIM" "$name" "$C_OFF"
  printf '    %s%s%s\n' "$C_DIM" "$why" "$C_OFF"
done

printf '\nmismatches: %s\n' "$MISMATCHES"

# I-028, applied to this script's own denominators: zero comparisons, zero trace
# figures or zero named exclusions would each print "mismatches: 0" and pass by
# construction. All three are asserted before any verdict is reported.
if [ "${COMPARED:-0}" -eq 0 ]; then
  printf '\nFAILURE: 0 comparisons were made - an empty scope proves nothing (I-007).\n'
  exit 1
fi
if [ "${FIGURES:-0}" -eq 0 ]; then
  printf '\nFAILURE: the trace-figures tables in CLAUDE.md hold 0 rows between them.\n'
  printf 'Deleting them would leave --online comparing nothing and reporting it as\n'
  printf 'agreement, which is I-028 exactly. Restore them, or retire --online and\n'
  printf 'this check together and deliberately.\n'
  exit 1
fi
if [ "${UNCHECKED:-0}" -eq 0 ]; then
  printf '\nFAILURE: the NOT CHECKED list is empty. Some of this block still lives\n'
  printf 'in a container rig this script cannot start, so an empty list is a\n'
  printf 'deleted list, not full coverage (I-028).\n'
  exit 1
fi

if [ "${FATAL_COUNT:-0}" -gt 0 ]; then
  printf '\n'
  records FATAL | while IFS=$(printf '\t') read -r _tag why; do
    printf '  %s%s%s\n' "$C_BAD" "$why" "$C_OFF"
  done
  printf '\nFAILURE: %s extractor(s) found nothing to read. This run has NO result,\n' "$FATAL_COUNT"
  printf 'which is not a clean result (I-027). Fix the extractor or the claim; do\n'
  printf 'not delete the check to get back to green.\n'
  exit 1
fi

if [ "${MISMATCHES:-0}" -gt 0 ]; then
  printf '\nFAILURE: %s comparison(s) disagree.\n' "$MISMATCHES"
  printf 'MOST have CLAUDE.md on the left, and for those the remedy is to re-measure\n'
  printf 'and update CLAUDE.md in the commit that moved the number - never to change\n'
  printf 'the source to match the prose. TWO do NOT: `invariants_structural` compares\n'
  printf 'a GATE-CLAIM line against its own runner, and `mirror_workflows` compares a\n'
  printf 'directory against a declaration. The note beside each row names the two\n'
  printf 'things it compared, because a message that sends the reader to edit the\n'
  printf 'wrong file is this whole script in miniature.\n'
  exit 1
fi

# Asked for the network and got nothing out of it. Not a pass: --online was a
# request to measure, and zero measurements is the shape of green this project
# refuses everywhere else (I-007, I-028). Offline runs are unaffected.
if [ "$ONLINE" -eq 1 ] && [ "${ONLINE_READ:-0}" -eq 0 ]; then
  printf '\nFAILURE: --online was asked for and read 0 of %s items. Every one is\n' "$ONLINE_ITEMS"
  printf 'named above with why. A run that measured nothing is not a run that found\n'
  printf 'nothing wrong.\n'
  exit 1
fi

if [ "$ONLINE" -eq 1 ]; then
  printf '\nOK: %s offline comparison(s) and %s read from CI job traces all agree' \
    "$COMPARED" "$ONLINE_READ"
  if [ "${ONLINE_NOT_READ:-0}" -gt 0 ]; then
    printf ';\n%s online item(s) were NOT READ and are named above.\n' "$ONLINE_NOT_READ"
  else
    printf '.\n'
  fi
  exit 0
fi

printf '\nOK: every number in CLAUDE.md that this repository can check agrees with its\n'
printf 'source here. The CI-trace figures were NOT looked at - see the online section.\n'
exit 0
