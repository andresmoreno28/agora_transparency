#!/usr/bin/env bash
#
# no-usage-reporting - Agora - unit 006, T-0635.
#
# Fails if a test in this package could install a Drupal site that reports its
# usage to Drupal.org.
#
# THE RULE IN ONE SENTENCE: every PHPUnit class that reaches BrowserTestBase or
# WebDriverTestBase uses NoUsageReportingTrait, and that trait pins
# update.settings:fetch.url to a loopback address.
#
# WHY IT EXISTS. This recipe installs core's `update` module (through
# drupal_cms_site_template_base, 2.2.0; formerly through drupal_cms_admin_ui)
# and `automated_cron`. The first web request a functional
# test makes after that runs cron, and `update` sends a site_key and the list of
# enabled modules to https://updates.drupal.org/release-history - the requests
# Drupal.org counts installs from. Measured 2026-09-24 against a recording stub:
# 18 requests from 9 test sites per run of this suite, and CI runs the suite
# twice per push. [andres] asked at the start of this project that no test
# install ever report usage. tests/src/Traits/NoUsageReportingTrait.php is the
# guard; this file stops the next test class from silently leaving it out.
#
# WHAT IS A FINDING:
#   * a concrete class that reaches BrowserTestBase or WebDriverTestBase -
#     directly or through a parent declared in this repository - and neither
#     uses NoUsageReportingTrait nor inherits it from such a parent;
#   * a class that uses the trait AND declares its own prepareSettings(): the
#     class method shadows the trait's, and its parent::prepareSettings() call
#     then skips the trait altogether. Put the trait in a base class instead,
#     extend it, and call parent::prepareSettings() from the override;
#   * a class whose parent is outside this repository and on neither list
#     below. A base that reaches BrowserTestBase through a class this script
#     cannot read would slip past, so an unknown base FAILS CLOSED until
#     somebody classifies it here, deliberately;
#   * the trait missing, not overriding prepareSettings(), not calling
#     parent::prepareSettings() first, not writing update.settings / fetch /
#     url, or pinning it to anything but a loopback address. A missing or empty
#     value is a finding too: core then falls back to
#     https://updates.drupal.org/release-history (UpdateFetcher::getFetchBaseUrl()).
#
# SCOPE: every *.php in the repository. All of them live under tests/src today,
# but the CI phpunit job runs every *Test.php under the package root, not only
# tests/src, so a test placed anywhere else must not escape. Files on disk that
# git does not track are scanned too, so an unguarded class is caught on the
# desk it was written on; the tracked/untracked split is printed (T-1915).
#
# Contract:
#   scope:     *.php repository-wide, minus .git/ vendor/ web/ node_modules/
#   scanned:   <N> file(s)              - N must be > 0 or this script exits 1
#   classes:   <C> declared, split by what each reaches
#   guarded:   <G> of <F> concrete functional class(es) - F must be > 0 or exit 1
#   trait pin: <url> (loopback: yes|no)
#   findings:  <M>  - each printed as  path:line  reason
#   exit 0 iff M == 0
#
# The two base lists below are part of the rule. Emptying the first makes every
# class non-functional, which is a FATAL (functional = 0); emptying the second
# turns every kernel test into an unclassified base, which is a finding. Neither
# can make this script pass by construction (I-028).
#
# House rules for tests/bin/ (T-321(c)): `wc -l` never `grep -c` for a compared
# value; numeric guards defaulted ONLY where zero means FAIL; grep rc >= 2 is an
# error, never "no match"; never `-F` with `-i`. The CANONICAL copy of the block
# lives in the header of tests/bin/no-ci-allow-dev. The parser is POSIX awk: the
# CI image is Ubuntu, whose default awk is mawk, not gawk.
#
# Usage: tests/bin/no-usage-reporting   (run from anywhere; it cd's to the root)

set -u
# No `set -e`: a finding must be recorded and counted, not abort the run.

# shellcheck disable=SC1007
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1007
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)
cd "$REPO_ROOT" || { echo "FATAL: cannot cd to repo root $REPO_ROOT"; exit 1; }

fatal() { printf 'FATAL: %s\n' "$1" >&2; exit 1; }

# Bases that install a site. A class reaching one of these must be guarded.
FUNCTIONAL_BASES='Drupal\Tests\BrowserTestBase Drupal\FunctionalJavascriptTests\WebDriverTestBase'
# Bases that install no site through settings.php and never run cron on their
# own. Anything else outside this repository is unclassified, and a finding.
OTHER_BASES='Drupal\KernelTests\KernelTestBase Drupal\Tests\UnitTestCase PHPUnit\Framework\TestCase'
TRAIT_NAME='NoUsageReportingTrait'

# ---------------------------------------------------------------- preflight --
for t in awk comm find git sed sort; do
  command -v "$t" >/dev/null 2>&1 || fatal "required tool not found: $t"
done

LIST=$(mktemp -t no-usage.XXXXXX)    || fatal "cannot create a temp file"
TRACKED=$(mktemp -t no-usage.XXXXXX) || fatal "cannot create a temp file"
OUT=$(mktemp -t no-usage.XXXXXX)     || fatal "cannot create a temp file"
trap 'rm -f "$LIST" "$TRACKED" "$OUT"' EXIT

find . \( -path ./.git -o -path ./vendor -o -path ./web -o -path ./node_modules \) -prune \
  -o -type f -name '*.php' -print 2>/dev/null | sed 's|^\./||' | LC_ALL=C sort > "$LIST"
SCANNED=$(wc -l < "$LIST" | tr -d '[:space:]')

# A failed `git ls-files` is FATAL, never "0 tracked" (the rule tests/bin/
# no-code-in-template states for the same split).
git ls-files -- '*.php' > "$TRACKED.raw" 2>/dev/null \
  || { rm -f "$TRACKED.raw"; fatal 'git ls-files failed - the tracked/untracked split did not happen.'; }
LC_ALL=C sort "$TRACKED.raw" > "$TRACKED"; rm -f "$TRACKED.raw"
N_TRACKED=$(LC_ALL=C comm -12 "$LIST" "$TRACKED" | wc -l | tr -d '[:space:]')
N_UNTRACKED=$(LC_ALL=C comm -23 "$LIST" "$TRACKED" | wc -l | tr -d '[:space:]')

printf '\nno-usage-reporting - no site installed by these tests reports usage to Drupal.org\n\n'
printf 'scope:     every *.php in the repository, minus .git/ vendor/ web/ node_modules/\n'
printf 'scanned:   %s file(s) (git-tracked: %s, untracked: %s)\n' "$SCANNED" "$N_TRACKED" "$N_UNTRACKED"

if [ "${SCANNED:-0}" -eq 0 ]; then
  printf 'findings:  n/a\n'
  printf '\nFAILURE: 0 files scanned - an empty scope proves nothing (I-007).\n'
  exit 1
fi

# Everything reaches awk through the ENVIRONMENT, never through -v: awk applies
# escape processing to -v values, so -v turned Drupal\Tests\BrowserTestBase into
# DrupalTestsBrowserTestBase on the first run of this script, nothing matched,
# and it refused with "0 concrete functional classes" - failing closed, which is
# the only reason that was noticed. ENVIRON is read verbatim. The file list is
# awk's own first input, so no file name is ever word-split by the shell.
NUR_FB="$FUNCTIONAL_BASES" NUR_NB="$OTHER_BASES" NUR_TN="$TRAIT_NAME" NUR_LIST="$LIST" awk '
function strip(s,    out, i, n, c, d) {
  # Removes // and # comments and /* */ blocks, keeps string contents, and
  # carries an open comment or string across lines (in_comment, in_quote).
  out = ""; n = length(s); i = 1
  while (i <= n) {
    c = substr(s, i, 1); d = substr(s, i + 1, 1)
    if (in_comment) { if (c == "*" && d == "/") { in_comment = 0; i += 2 } else i++; continue }
    if (in_quote != "") {
      out = out c
      if (c == "\\") { out = out d; i += 2; continue }
      if (c == in_quote) in_quote = ""
      i++; continue
    }
    if (c == "\047" || c == "\"") { in_quote = c; out = out c; i++; continue }
    if (c == "/" && d == "*") { in_comment = 1; i += 2; continue }
    if (c == "/" && d == "/") break
    if (c == "#" && d != "[") break
    out = out c; i++
  }
  return out
}
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
function last_segment(n,    p) { while ((p = index(n, "\\")) > 0) n = substr(n, p + 1); return n }
function resolve(n,    first, p) {
  # An imported alias, a fully qualified name, or a name in the current namespace.
  n = trim(n)
  if (n == "") return ""
  if (substr(n, 1, 1) == "\\") return substr(n, 2)
  p = index(n, "\\")
  first = (p > 0) ? substr(n, 1, p - 1) : n
  if ((FILENAME "|" first) in alias) return (p > 0) ? alias[FILENAME "|" first] substr(n, p) : alias[FILENAME "|" first]
  return (current_namespace == "") ? n : current_namespace "\\" n
}
function declare(header, line,    name, parent, abstract) {
  header = trim(header)
  abstract = (header ~ /^((final|readonly)[ \t]+)*abstract[ \t]/) ? 1 : 0
  sub(/^((abstract|final|readonly)[ \t]+)*class[ \t]+/, "", header)
  name = header; sub(/[^A-Za-z0-9_].*$/, "", name)
  parent = ""
  if (header ~ /[ \t]extends[ \t]/) { parent = header; sub(/^.*[ \t]extends[ \t]+/, "", parent); sub(/[^A-Za-z0-9_\\].*$/, "", parent) }
  current = (current_namespace == "") ? name : current_namespace "\\" name
  class_count++; class_list[class_count] = current
  class_file[current] = FILENAME; class_line[current] = line; class_abstract[current] = abstract
  class_parent[current] = (parent == "") ? "-" : resolve(parent)
  kind = "class"
}
BEGIN {
  trait_name = ENVIRON["NUR_TN"]; list_path = ENVIRON["NUR_LIST"]
  n = split(ENVIRON["NUR_FB"], names, " "); for (i = 1; i <= n; i++) functional_base[names[i]] = 1
  n = split(ENVIRON["NUR_NB"], names, " "); for (i = 1; i <= n; i++) other_base[names[i]] = 1
  ARGV[1] = list_path; ARGC = 2
}
FILENAME == list_path { if ($0 != "") ARGV[ARGC++] = $0; next }
FNR == 1 { current_namespace = ""; current = ""; kind = ""; in_comment = 0; in_quote = ""; pending_header = ""; here_marker = ""; files++ }
{
  raw = $0; sub(/\r$/, "", raw)
  if (here_marker != "") {               # inside a heredoc or nowdoc body: data, not code
    t = raw; sub(/^[ \t]+/, "", t)
    if (index(t, here_marker) == 1 && substr(t, length(here_marker) + 1, 1) !~ /^[A-Za-z0-9_]$/) here_marker = ""
    next
  }
  code = strip(raw)
  if (code ~ /<<<[ \t]*["\047]?[A-Za-z_][A-Za-z0-9_]*["\047]?[ \t]*$/) {
    here_marker = code; sub(/^.*<<<[ \t]*["\047]?/, "", here_marker); sub(/["\047]?[ \t]*$/, "", here_marker)
    next
  }
  if (pending_header != "") {            # a class header still being read
    pending_header = pending_header " " code
    if (index(code, "{") > 0) { declare(pending_header, pending_line); pending_header = "" }
    next
  }
  if (code ~ /^[ \t]*namespace[ \t]+[A-Za-z0-9_\\]+[ \t]*;/) {
    current_namespace = code; sub(/^[ \t]*namespace[ \t]+/, "", current_namespace); sub(/[ \t]*;.*$/, "", current_namespace)
    next
  }
  if (current == "" && code ~ /^use[ \t]+[A-Za-z0-9_\\]+([ \t]+as[ \t]+[A-Za-z0-9_]+)?[ \t]*;/ && code !~ /^use[ \t]+(function|const)[ \t]/) {
    imported = code; sub(/^use[ \t]+/, "", imported); sub(/[ \t]*;.*$/, "", imported)
    if (imported ~ /[ \t]as[ \t]/) { short = imported; sub(/^.*[ \t]as[ \t]+/, "", short); sub(/[ \t]+as[ \t].*$/, "", imported) }
    else short = last_segment(imported)
    sub(/^\\/, "", imported)
    alias[FILENAME "|" short] = imported
    next
  }
  if (code ~ /^[ \t]*((abstract|final|readonly)[ \t]+)*class[ \t]+[A-Za-z_]/) {
    if (index(code, "{") > 0 || code ~ /[ \t]extends[ \t]/) declare(code, FNR)
    else { pending_header = code; pending_line = FNR }
    next
  }
  if (code ~ /^[ \t]*trait[ \t]+[A-Za-z_]/) {
    t = code; sub(/^[ \t]*trait[ \t]+/, "", t); sub(/[^A-Za-z0-9_].*$/, "", t)
    current = (current_namespace == "") ? t : current_namespace "\\" t; kind = "trait"
    trait_file[last_segment(current)] = FILENAME; trait_line[last_segment(current)] = FNR
    next
  }
  if (current == "") next
  if (code ~ /^[ \t]*use[ \t]+[A-Za-z0-9_\\]/) {
    used = code; sub(/^[ \t]*use[ \t]+/, "", used); sub(/[;{].*$/, "", used)
    m = split(used, parts, ",")
    for (i = 1; i <= m; i++) if (kind == "class" && last_segment(resolve(parts[i])) == trait_name) guard[current] = 1
    next
  }
  if (code ~ /^[ \t]*((public|protected|private|static|final|abstract)[ \t]+)*function[ \t]+prepareSettings[ \t]*\(/) {
    if (kind == "class") prepare_line[current] = FNR
    else if (last_segment(current) == trait_name) trait_prepares = FNR
  }
  if (kind == "trait" && last_segment(current) == trait_name) {
    if (code ~ /parent::prepareSettings[ \t]*\(/) trait_calls_parent = FNR
    if (code ~ /->writeSettings[ \t]*\(/) trait_writes = FNR
    # Single-quoted literals sit at the even positions of a split on the quote.
    m = split(code, parts, "\047")
    for (i = 2; i <= m; i += 2) {
      literal = parts[i]
      if (literal == "update.settings") writes_update = 1
      if (literal == "fetch") writes_fetch = 1
      if (literal == "url") writes_url = 1
      if (literal ~ /^[A-Za-z]+:\/\//) { url_count++; url = literal; url_line = FNR }
    }
  }
}
function classify(c,    p, d) {
  for (d = 0; d < 50; d++) {
    p = class_parent[c]
    if (p == "-") return "none"
    if (p in functional_base) return "functional"
    if (p in other_base) return "other-base"
    if (p in class_file) { c = p; continue }
    return "unknown\t" p
  }
  return "unknown\tan inheritance cycle"
}
function guarded(c,    d) {
  for (d = 0; d < 50; d++) {
    if (c in guard) return 1
    if (class_parent[c] in class_file) { c = class_parent[c]; continue }
    return 0
  }
  return 0
}
END {
  F = 0; A = 0; G = 0; K = 0; O = 0; U = 0
  for (i = 1; i <= class_count; i++) {
    c = class_list[i]; r = classify(c)
    if (r == "functional") {
      if (class_abstract[c]) { A++; continue }
      F++
      if (guarded(c)) G++
      else print "FINDING\t" class_file[c] ":" class_line[c] "\tclass " c " reaches BrowserTestBase or WebDriverTestBase and does not use " trait_name " - every site it installs reports usage to Drupal.org"
      if ((c in guard) && (c in prepare_line))
        print "FINDING\t" class_file[c] ":" prepare_line[c] "\tclass " c " declares prepareSettings() while using " trait_name " directly: the class method shadows the trait and parent::prepareSettings() skips it"
    }
    else if (r == "other-base") K++
    else if (r == "none") O++
    else { U++; split(r, q, "\t"); print "FINDING\t" class_file[c] ":" class_line[c] "\tclass " c " extends " q[2] ", which is outside this repository and on neither base list in tests/bin/no-usage-reporting - classify it there, deliberately" }
  }
  if (!(trait_name in trait_file)) print "FINDING\t<scope>:0\ttrait " trait_name " is declared in no scanned file - nothing pins the fetch URL"
  else {
    where = trait_file[trait_name] ":" trait_line[trait_name]
    if (!trait_prepares)     print "FINDING\t" where "\t" trait_name " does not override prepareSettings() - the only method that runs before the installer"
    if (!trait_calls_parent) print "FINDING\t" where "\t" trait_name " never calls parent::prepareSettings() - core writes settings.php there, and a value written before it is overwritten"
    if (!trait_writes)       print "FINDING\t" where "\t" trait_name " never calls writeSettings() - the pin never reaches settings.php"
    if (!(writes_update && writes_fetch && writes_url)) print "FINDING\t" where "\t" trait_name " does not write update.settings / fetch / url"
    if (url_count == 0) print "FINDING\t" where "\t" trait_name " pins no URL - a missing or empty value falls back to https://updates.drupal.org/release-history"
    else if (url_count > 1) print "FINDING\t" trait_file[trait_name] ":" url_line "\t" trait_name " carries " url_count " URL literals - exactly one pin is expected"
  }
  pin = (url_count == 1) ? url : "-"
  host = pin; sub(/^[A-Za-z]+:\/\//, "", host); sub(/\/.*$/, "", host)
  if (host ~ /^\[/) { sub(/\].*$/, "]", host) } else sub(/:[0-9]*$/, "", host)
  loopback = (host ~ /^127\.[0-9]+\.[0-9]+\.[0-9]+$/ || host == "localhost" || host == "[::1]") ? "yes" : "no"
  if (url_count == 1 && loopback == "no") print "FINDING\t" trait_file[trait_name] ":" url_line "\t" trait_name " pins the fetch URL to " pin ", which is not a loopback address"
  print "SUMMARY\t" files "\t" class_count + 0 "\t" F "\t" A "\t" K "\t" O "\t" U "\t" G "\t" pin "\t" loopback "\t" ((trait_name in trait_file) ? trait_file[trait_name] : "-")
}
' > "$OUT"
AWK_RC=$?
[ "$AWK_RC" -eq 0 ] || fatal "the parser (awk) exited $AWK_RC - nothing was classified, which is not a clean result"

SUMMARY=$(grep -E '^SUMMARY' "$OUT")
SRC=$?
[ "$SRC" -eq 0 ] || fatal "the parser printed no SUMMARY line - nothing was classified, which is not a clean result"
IFS="$(printf '\t')" read -r _ S_FILES S_CLASSES S_F S_A S_K S_O S_U S_G S_PIN S_LOOP S_TRAIT_PATH <<EOF
$SUMMARY
EOF

[ "${S_FILES:-0}" -eq "$SCANNED" ] 2>/dev/null \
  || fatal "the parser opened ${S_FILES:-0} of $SCANNED listed file(s) - a partial scan is not a scan"

printf 'classes:   %s declared - functional %s concrete + %s abstract, kernel/unit %s, not a test %s, unclassified %s\n' \
  "$S_CLASSES" "$S_F" "$S_A" "$S_K" "$S_O" "$S_U"
printf 'guarded:   %s of %s concrete functional class(es)\n' "$S_G" "$S_F"
printf 'trait pin: %s (loopback: %s) in %s\n' "$S_PIN" "$S_LOOP" "$S_TRAIT_PATH"

if [ "${S_CLASSES:-0}" -eq 0 ]; then
  printf 'findings:  n/a\n'
  printf '\nFAILURE: %s file(s) scanned and 0 classes found - the parser read nothing it recognised (I-028).\n' "$SCANNED"
  exit 1
fi
if [ "${S_F:-0}" -eq 0 ]; then
  printf 'findings:  n/a\n'
  printf '\nFAILURE: 0 concrete functional classes - either the suite has none, and the trait is dead code,\n'
  printf 'or the base list above stopped matching. Neither is a pass (I-028).\n'
  exit 1
fi

M=$(grep -E '^FINDING' "$OUT" | wc -l | tr -d '[:space:]')
printf 'findings:  %s\n' "$M"
if [ "$M" -ne 0 ]; then
  printf '\n'
  grep -E '^FINDING' "$OUT" | awk -F '\t' '{ printf "  %s  %s\n", $2, $3 }'
  printf '\nFAILURE: %s finding(s). Each one is a test site that could report usage to Drupal.org.\n' "$M"
  exit 1
fi
printf '\nOK: %s of %s concrete functional class(es) guarded; the trait pins the fetch URL to a loopback address.\n' "$S_G" "$S_F"
exit 0
