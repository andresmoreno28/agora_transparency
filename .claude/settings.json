{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(curl -s https://updates.drupal.org/release-history/*)",
      "Bash(curl -s https://git.drupalcode.org/api/v4/projects/*)",
      "Bash(curl -s https://git.drupalcode.org/project/*)",
      "Bash(composer validate:*)",
      "Bash(composer show:*)",
      "Bash(ddev status:*)",
      "Bash(ddev drush status:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(tests/bin/*)"
    ]
  }
}
