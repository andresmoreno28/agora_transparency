{
    "name": "drupal/agora_transparency",
    "description": "A transparency and open government site template for Drupal CMS, for councils, public bodies and organisations that publish accountability information.",
    "type": "drupal-recipe",
    "license": "GPL-2.0-or-later",
    "require": {
        "drupal/agora_theme": "^1.2",
        "drupal/config_guardian": "^1.0",
        "drupal/drupal_cms_helper": "^2",
        "drupal/drupal_cms_site_template_base": "^2",
        "drupal/easy_email_express": "^1",
        "drupal/site_template_helper": "^1.0.3"
    },
    "config": {
        "allow-plugins": {
            "drupal/site_template_helper": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "file-mapping": {
                "[project-root]/AGENTS.md": "AGENTS.md"
            }
        }
    }
}
