# Agora demo - environment for compose.yaml.
#
# setup.sh copies this file to .env (mode 600) on its first run and fills in
# the three generated secrets below. Only TUNNEL_TOKEN has to be pasted in by
# hand, from the Cloudflare dashboard. Never commit or share .env.

# --- Secret, pasted by hand -------------------------------------------------
# The token of the demo's OWN Cloudflare Tunnel (not the andres-cms tunnel).
TUNNEL_TOKEN=

# --- Secret, generated by setup.sh ------------------------------------------
DB_PASSWORD=
DB_ROOT_PASSWORD=
DRUPAL_HASH_SALT=

# --- Not secret ---------------------------------------------------------------
# The only host name the site answers to.
DEMO_HOSTNAME=agora-demo.andresmoreno.dev
# The site's name, shown in the masthead and page titles.
SITE_NAME="Fuentelclaro Town Council"
# The "edge" network between cloudflared and nginx. Drupal trusts
# X-Forwarded-For only from this range. It must not overlap any network
# already on the host (setup.sh checks).
EDGE_SUBNET=10.213.47.0/28
